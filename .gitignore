# CEF Debian Package - Git Repository Exclusions
# ==================================================
# Only source files and debian/ packaging should be committed to git
# Build artifacts and large tarballs are NOT committed to git

# Build directories - created during build process
chromium_src/
depot_tools/
build/

# Quilt patch state - temporary, recreated during patch application
.pc/

# Source package artifacts - generated by dpkg-buildpackage, not stored in git
*.dsc
*.debian.tar.xz

# Binary package artifacts - generated, not stored in git
*.deb
*.deb-dbgsym
*.ddeb
*.buildinfo
*.changes
*.build

# Build logs
*.log

# Upstream tarballs - uploaded separately to Debian FTP, NOT in git
# These are large files (~960MB) that should not be in version control
chromium_*.orig.tar.xz
chromium-*.tar.xz
*.tar.gz
*.tar.bz2

# Development caching - optimization for development mode only
build-cache/
../build-cache/

# Editor and IDE files
*~
*.swp
*.swo
.vscode/
.idea/

# Temporary files
*.tmp
*.bak
tmp/
__pycache__/
