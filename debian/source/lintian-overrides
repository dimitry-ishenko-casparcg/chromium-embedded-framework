# Lintian overrides for chromium-embedded-framework source package
#
# This package bundles Google's depot_tools and build dependencies because:
# - No chromium-source package exists in Debian yet (Bug #893448)
# - depot_tools requires ITP filing (see ITP-depot-tools.txt)
# - These are build-time dependencies only, not runtime
# Package targets experimental until dependencies can be unbundled.

# depot_tools contains Windows binaries for cross-platform support.
# These are part of Google's official toolchain and not used during Linux builds.
chromium-embedded-framework source: source-contains-prebuilt-windows-binary

# depot_tools bundles pre-compiled binaries (Python interpreters, reclient, cipd,
# node.js) required for the Chromium/CEF build system. These are Google's official
# toolchain binaries without available source in the package.
chromium-embedded-framework source: source-is-missing

# Chromium patches are applied MANUALLY by debian/rules using patch -p1,
# NOT via quilt during source extraction. This is documented in README.source.
# The patches target chromium_src/ which doesn't exist until build time.
chromium-embedded-framework source: patch-file-present-but-not-mentioned-in-series [debian/patches/chromium/*]

# Patch 0009 is conditionally used and may be disabled in some configurations.
chromium-embedded-framework source: patch-file-present-but-not-mentioned-in-series [debian/patches/0009-update-cef-mac-frame-patch.cef.patch]

# =============================================================================
# CHROMIUM BUNDLED THIRD-PARTY LICENSE ISSUES
# =============================================================================
# These files are part of Chromium's bundled third-party code. The same issues
# exist in the Debian chromium package. We cannot modify upstream Chromium
# source to fix these licensing concerns.

# ConvertUTF code has a restrictive Unicode license that lintian flags.
# This is bundled in Chromium's breakpad and SwiftShader LLVM copy.
# Same issue exists in Debian chromium package.
chromium-embedded-framework source: license-problem-convert-utf-code [chromium/third_party/breakpad/breakpad/src/common/convert_UTF.cc]
chromium-embedded-framework source: license-problem-convert-utf-code [chromium/third_party/swiftshader/third_party/llvm-16.0/llvm/lib/Support/ConvertUTF.cpp]

# IETF RFC test files have BCP78 license restrictions.
# These are test fixtures in Chromium's readability library, not shipped in binary.
chromium-embedded-framework source: license-problem-non-free-RFC-BCP78 [chromium/third_party/readability/src/test/test-pages/ietf-1/expected.html]
chromium-embedded-framework source: license-problem-non-free-RFC-BCP78 [chromium/third_party/readability/src/test/test-pages/ietf-1/source.html]

# GTK demo appdata files declare CC0-1.0 license in their metadata, but our
# debian/copyright lists chromium/* as BSD-3-Clause. These are Chromium bundled
# wayland-protocols demos, not shipped in the binary package.
chromium-embedded-framework source: inconsistent-appstream-metadata-license [chromium/third_party/wayland-protocols/gtk/demos/gtk-demo/org.gtk.Demo4.appdata.xml]
chromium-embedded-framework source: inconsistent-appstream-metadata-license [chromium/third_party/wayland-protocols/gtk/demos/icon-browser/org.gtk.IconBrowser4.appdata.xml]
chromium-embedded-framework source: inconsistent-appstream-metadata-license [chromium/third_party/wayland-protocols/gtk/demos/print-editor/org.gtk.PrintEditor4.appdata.xml]
chromium-embedded-framework source: inconsistent-appstream-metadata-license [chromium/third_party/wayland-protocols/gtk/demos/widget-factory/org.gtk.WidgetFactory4.appdata.xml]
