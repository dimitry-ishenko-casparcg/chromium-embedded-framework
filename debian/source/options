# Ignore MUT component directories in diff comparison
# These are extracted from separate orig-*.tar.xz tarballs
# Also ignore build artifacts and git-buildpackage config
# Note: chromium-[0-9] matches the tarball's internal directory name
# (e.g., chromium-147.0.7727.116/) which differs from the MUT component
# name (chromium/). dpkg-source -x renames it, but git checkouts keep
# the original name.
extend-diff-ignore = "^chromium/|^chromium-[0-9]|^chromium-debian/|^chromium_src/|^cef/|^tools/|^third_party/|^\\.gbp\\.conf$"
