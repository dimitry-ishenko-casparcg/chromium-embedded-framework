Description: Skip chromium checkout for Debian tarball/package builds
 automate-git.py determines if chromium needs to be checked out by comparing
 current vs desired git hashes. For tarball builds, this fails because tags
 don't exist. For future chromium-source package builds, we don't want to
 checkout anyway since the package already provides the correct version.
 .
 Setting chromium_checkout_changed = False for Debian builds skips the entire
 checkout block (lines 1560-1586) which includes:
 - git revert (patch 0005 already handles this)
 - git checkout (would fail for tarballs, unnecessary for both tarball and package)
 - gclient sync (patch 0004 already does this)
 .
 This is forward-compatible: when Debian provides chromium-source package with
 real git repository and tags, this patch will skip checkout operations and
 preserve the real git repo intact.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Forwarded: not-needed
Last-Update: 2025-11-04

diff --git a/cef/tools/automate/automate-git.py b/cef/tools/automate/automate-git.py
index fa96f28..3c55265 100644
--- a/cef/tools/automate/automate-git.py
+++ b/cef/tools/automate/automate-git.py
@@ -1533,6 +1533,13 @@ else:
   else:
     chromium_checkout_changed = options.dryrun

+# Debian: Skip chromium checkout - tarball/package already has correct version.
+# This avoids git operations that would fail (no tags) or damage real git repos
+# (when chromium-source package exists). Forward-compatible solution.
+if 'DEBIAN_BUILD' in os.environ:
+  chromium_checkout_changed = False
+  msg('Debian: Skipping chromium checkout (tarball/package already at correct version)')
+
 if cef_checkout_changed:
   if cef_dir != cef_src_dir and os.path.exists(cef_src_dir):
