Description: Add Debian unbundle toolchain for system libc++ support
 Creates a custom GN toolchain that reads compiler flags from environment
 variables (CXXFLAGS, LDFLAGS) at GN parse time. This enables CEF to use
 system libc++ instead of bundled libc++ (use_custom_libcxx=false).
 .
 The toolchain sets use_custom_libcxx=false and use_sysroot=false in
 toolchain_args, ensuring system libraries are used throughout the build.
 .
 Based on Debian Chromium's build/toolchain/linux/unbundle/BUILD.gn.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-18

diff --git a/toolchain/linux/debian/BUILD.gn b/toolchain/linux/debian/BUILD.gn
new file mode 100644
index 0000000..ab1d1cb
--- /dev/null
+++ b/toolchain/linux/debian/BUILD.gn
@@ -0,0 +1,39 @@
+# Copyright 2025 The Chromium Embedded Framework Authors. All rights reserved.
+# Debian-specific unbundle toolchain for CEF
+#
+# This toolchain enables CEF to use system libc++ (use_custom_libcxx=false)
+# by reading compiler flags from environment variables at GN parse time.
+#
+# Based on Debian Chromium's build/toolchain/linux/unbundle/BUILD.gn
+
+import("//build/toolchain/gcc_toolchain.gni")
+
+gcc_toolchain("default") {
+  # Read compiler paths from environment (set by debian/rules)
+  cc = getenv("CC")
+  cxx = getenv("CXX")
+  ar = getenv("AR")
+  nm = getenv("NM")
+
+  # Use C++ compiler as linker (standard practice in GN toolchains)
+  ld = cxx
+
+  # Read build flags from environment at GN parse time
+  # These contain -stdlib=libc++ for system libc++ usage
+  extra_cflags = getenv("CFLAGS")
+  extra_cppflags = getenv("CPPFLAGS")
+  extra_cxxflags = getenv("CXXFLAGS")
+  extra_ldflags = getenv("LDFLAGS")
+
+  # Toolchain-specific GN arguments
+  toolchain_args = {
+    current_cpu = current_cpu
+    current_os = current_os
+
+    # CRITICAL: Use system libc++ instead of bundled
+    use_custom_libcxx = false
+
+    # Use system sysroot, not bundled
+    use_sysroot = false
+  }
+}
