Description: Patch GN configuration for exec_script whitelist and fix gclient sync
 CEF uses exec_script in BUILD.gn (//cef/tools/gypi_to_gn.py) which is
 security-restricted by GN. This patch adds the exec_script_whitelist to
 Chromium's .gn file for Debian builds, allowing CEF's build scripts to run.
 .
 Also moves gclient runhooks and delete_directory calls out of the BUILD.gn
 write block to the correct outer scope. Reorders the calls so that .gn
 patching happens before gclient runhooks (which runs GN).
 .
 Replace gclient sync --nohooks with a direct write of .gclient_entries.
 gclient sync attempts CIPD/network downloads which violate Debian's
 no-network build policy. All source is already present from MUT tarballs
 so only the entries file is needed for gclient runhooks to function.
Author: Juan Manuel Mendez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-04-11

diff --git a/cef/tools/automate/automate-git.py b/cef/tools/automate/automate-git.py
index 8057856..681aee7 100644
--- a/cef/tools/automate/automate-git.py
+++ b/cef/tools/automate/automate-git.py
@@ -1606,11 +1606,43 @@ content = content.replace(
 with open(build_gn, 'w') as f:
   f.write(content)

-  # Runs hooks for files that have been modified in the local working copy.
-  run("gclient runhooks", chromium_dir)
+# Delete the src/out directory created by `gclient sync`.
+delete_directory(out_src_dir)
+
+# Debian-specific: Patch Chromium .gn file with exec_script_whitelist.
+# CEF uses exec_script in BUILD.gn (//cef/tools/gypi_to_gn.py) which is
+# security-restricted by GN. The .gn file controls exec_script permissions.
+# For Debian builds, .gn already exists from tarball extraction.
+# For normal builds, .gn is created by gclient sync (above).
+# This patch must run before gclient runhooks (which runs GN).
+if 'DEBIAN_BUILD' in os.environ:
+  gn_file = os.path.join(chromium_src_dir, '.gn')
+  if os.path.exists(gn_file):
+    with open(gn_file, 'r') as f:
+      gn_content = f.read()
+    if 'exec_script_whitelist' not in gn_content:
+      # Add exec_script_whitelist right after "default_args = {"
+      patched = gn_content.replace(
+        'default_args = {',
+        'default_args = {\n  exec_script_whitelist = [\n    "//cef/tools/gypi_to_gn.py",\n  ]')
+      with open(gn_file, 'w') as f:
+        f.write(patched)
+      msg('Debian: Patched .gn with exec_script_whitelist for CEF')
+    else:
+      msg('Debian: .gn already contains exec_script_whitelist')

-  # Delete the src/out directory created by `gclient sync`.
-  delete_directory(out_src_dir)
+  # Debian-specific: Write .gclient_entries instead of running gclient sync.
+  # gclient sync would attempt CIPD/network downloads, violating Debian's
+  # no-network build policy. All source is already present from MUT tarballs.
+  msg('Debian: Writing .gclient_entries to avoid network-accessing gclient sync')
+  with open(os.path.join(chromium_dir, '.gclient_entries'), 'w') as f:
+    f.write("entries = {'src': '%s'}\n" % chromium_url)
+
+# Patch the Chromium runhooks scripts if necessary.
+apply_runhooks_patch()
+
+# Runs hooks for files that have been modified in the local working copy.
+run("gclient runhooks", chromium_dir)

 if cef_dir == cef_src_dir:
