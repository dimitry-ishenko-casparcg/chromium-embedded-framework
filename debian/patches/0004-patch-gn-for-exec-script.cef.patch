Description: Patch GN configuration for exec_script whitelist
 CEF uses exec_script in BUILD.gn (//cef/tools/gypi_to_gn.py) which is
 security-restricted by GN. This patch adds the exec_script_whitelist to
 Chromium's .gn file for Debian builds, allowing CEF's build scripts to
 run. Also reorders gclient sync/runhooks for proper Debian build flow.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-12-29

diff --git a/tools/automate/automate-git.py b/tools/automate/automate-git.py
index c107d75..04a801b 100644
--- a/tools/automate/automate-git.py
+++ b/tools/automate/automate-git.py
@@ -1607,11 +1607,41 @@ content = content.replace(
 with open(build_gn, 'w') as f:
   f.write(content)
 
-  # Runs hooks for files that have been modified in the local working copy.
-  run("gclient runhooks", chromium_dir)
+# Delete the src/out directory created by `gclient sync`.
+delete_directory(out_src_dir)
+
+# Debian-specific: Patch Chromium .gn file with exec_script_whitelist.
+# CEF uses exec_script in BUILD.gn (//cef/tools/gypi_to_gn.py) which is
+# security-restricted by GN. The .gn file controls exec_script permissions.
+# For Debian builds, .gn already exists from tarball extraction.
+# For normal builds, .gn is created by gclient sync (above).
+# This patch must run before gclient runhooks (which runs GN).
+if 'DEBIAN_BUILD' in os.environ:
+  gn_file = os.path.join(chromium_src_dir, '.gn')
+  if os.path.exists(gn_file):
+    with open(gn_file, 'r') as f:
+      gn_content = f.read()
+    if 'exec_script_whitelist' not in gn_content:
+      # Add exec_script_whitelist right after "default_args = {"
+      patched = gn_content.replace(
+        'default_args = {',
+        'default_args = {\n  exec_script_whitelist = [\n    "//cef/tools/gypi_to_gn.py",\n  ]')
+      with open(gn_file, 'w') as f:
+        f.write(patched)
+      msg('Debian: Patched .gn with exec_script_whitelist for CEF')
+    else:
+      msg('Debian: .gn already contains exec_script_whitelist')
 
-  # Delete the src/out directory created by `gclient sync`.
-  delete_directory(out_src_dir)
+  # Debian-specific: Run gclient sync to process patched DEPS file.
+  msg('Debian: Running gclient sync to process patched DEPS')
+  run("gclient sync --nohooks", chromium_dir)
+  msg('Debian: gclient sync completed')
+
+# Patch the Chromium runhooks scripts if necessary.
+apply_runhooks_patch()
+
+# Runs hooks for files that have been modified in the local working copy.
+run("gclient runhooks", chromium_dir)
 
 if cef_dir == cef_src_dir:
