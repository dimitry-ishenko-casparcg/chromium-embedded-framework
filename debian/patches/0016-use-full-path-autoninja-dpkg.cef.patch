Description: Use full path to autoninja for dpkg-buildpackage compatibility
 The dpkg-buildpackage environment may not inherit PATH correctly to Python
 subprocesses. Using the full path to autoninja based on depot_tools_dir
 ensures the build tool is found regardless of PATH configuration.
 .
 This fixes "exit status 127" (command not found) errors when automate-git.py
 tries to run autoninja during the build phase.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-12-17

diff --git a/tools/automate/automate-git.py b/tools/automate/automate-git.py
index 5289992..0828a90 100644
--- a/tools/automate/automate-git.py
+++ b/tools/automate/automate-git.py
@@ -1796,7 +1796,9 @@ if not options.nobuild and (chromium_checkout_changed or \
   run('%s %s' % (python_exe, tool), cef_src_dir)

   # Build using autoninja for automatic `-j (#cores)` configuration.
-  command = 'autoninja '
+  # Debian: Use full path to autoninja to avoid PATH issues in dpkg-buildpackage
+  autoninja_path = os.path.join(depot_tools_dir, 'autoninja')
+  command = autoninja_path + ' '
   if options.verbosebuild:
     command += '-v '
   if options.buildfailurelimit != 1:
