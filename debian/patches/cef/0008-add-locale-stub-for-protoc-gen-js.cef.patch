Description: Add locale stub file for protoc-gen-js linking
 This patch creates debian/cef_locale_stub.cpp in the CEF source tree.
 The stub provides minimal std::__Cr::locale symbols needed by protoc-gen-js
 without requiring compilation of the problematic locale.cpp from bundled libc++.
 .
 protoc-gen-js is a build-time code generator that only needs locale symbols
 for iostream initialization. Since it runs with LC_ALL=C and only outputs
 generated code, it doesn't need actual locale functionality.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Forwarded: not-needed
Last-Update: 2025-11-14

--- /dev/null
+++ b/debian/cef_locale_stub.cpp
@@ -0,0 +1,128 @@
+// Debian: Minimal locale stub for protoc-gen-js linking
+// protoc-gen-js is a build tool that only needs locale symbols for iostream
+// initialization. It doesn't perform actual locale processing, so empty
+// stubs are sufficient.
+//
+// Background: locale.cpp from bundled libc++ cannot be compiled on Debian
+// due to type conflicts between glibc headers and libc++ wrappers
+// (__newlocale/__freelocale parameter type mismatches).
+//
+// This stub provides the minimum symbols needed for linking without
+// implementing actual locale functionality.
+
+#include <cstddef>  // For size_t
+
+namespace std {
+namespace __Cr {
+
+// Forward declarations
+class locale {
+public:
+    class facet;
+    class id {
+    public:
+        id() noexcept {}
+    };
+
+    // Constructors and destructor
+    locale() noexcept {}
+    locale(const locale&) noexcept {}
+    locale& operator=(const locale&) noexcept { return *this; }
+    ~locale() {}
+
+    // use_facet - returns nullptr (not used by protoc-gen-js)
+    const facet* use_facet(const id&) const { return nullptr; }
+};
+
+// Base facet class
+class locale::facet {
+protected:
+    explicit facet(size_t refs = 0) {}
+public:
+    virtual ~facet() {}
+
+private:
+    facet(const facet&) = delete;
+    void operator=(const facet&) = delete;
+};
+
+// Specific facet types needed by iostream
+template<typename CharT>
+struct ctype_base {
+    typedef unsigned int mask;
+};
+
+template<typename CharT>
+class ctype : public locale::facet, public ctype_base<CharT> {
+public:
+    static locale::id id;
+
+    explicit ctype(size_t = 0) : locale::facet(0) {}
+    virtual ~ctype() {}
+};
+
+template<typename CharT, typename OutputIter = char*>
+class num_put : public locale::facet {
+public:
+    static locale::id id;
+
+    explicit num_put(size_t = 0) : locale::facet(0) {}
+    virtual ~num_put() {}
+};
+
+template<typename InternT, typename ExternT, typename StateT>
+class codecvt : public locale::facet {
+public:
+    static locale::id id;
+
+    explicit codecvt(size_t = 0) : locale::facet(0) {}
+    virtual ~codecvt() {}
+};
+
+// Static member definitions for common instantiations
+template<> locale::id ctype<char>::id;
+template<> locale::id ctype<wchar_t>::id;
+template<> locale::id num_put<char>::id;
+template<> locale::id num_put<wchar_t>::id;
+template<> locale::id codecvt<char, char, int>::id;
+template<> locale::id codecvt<wchar_t, char, int>::id;
+
+// Explicit template instantiations
+template class ctype<char>;
+template class ctype<wchar_t>;
+template class num_put<char>;
+template class num_put<wchar_t>;
+template class codecvt<char, char, int>;
+template class codecvt<wchar_t, char, int>;
+
+} // namespace __Cr
+} // namespace std
+
+// libc++abi symbols needed for static initialization
+// These are typically provided by libc++abi library, but are stubbed here
+// to avoid additional linking dependencies
+extern "C" {
+    // Guard functions for one-time initialization of static variables
+    int __cxa_guard_acquire(void* guard) {
+        // Return 1 to indicate we acquired the guard (proceed with initialization)
+        // For a stub, we assume single-threaded execution during build
+        return 1;
+    }
+
+    void __cxa_guard_release(void* guard) {
+        // Mark guard as released (initialization complete)
+        // No-op in stub
+    }
+
+    void __cxa_guard_abort(void* guard) {
+        // Called if initialization throws exception
+        // No-op in stub
+    }
+
+    // Pure virtual function handler (should never be called in valid code)
+    void __cxa_pure_virtual() {
+        // In a real implementation, this would terminate
+        // For stub, we just return (protoc-gen-js shouldn't call this)
+    }
+}
+
