Description: Add locale stub for protoc-gen-js linking (fix use_facet signature)
 protoc-gen-js is a build tool that generates JavaScript bindings from
 Protocol Buffer files. It requires locale symbols from libc++ for iostream
 initialization, but the bundled libc++'s locale.cpp cannot be compiled on
 Debian due to type conflicts with glibc headers.
 .
 Missing symbols: std::__Cr::locale::*, std::__Cr::num_put::id,
 std::__Cr::ctype::id, __cxa_guard_*, __cxa_pure_virtual
 .
 This patch adds a minimal stub implementation (cef_locale_stub.cpp) that
 provides the necessary locale symbols for linking. Since protoc-gen-js is
 a build tool that runs with LC_ALL=C and only outputs generated code, it
 doesn't need actual locale functionality.
 .
 Build 165h-165i: Inline namespace mismatch - symbols compiled but not exported
 Build 166-168: LTO stripped symbols, undefined symbols at link time
 Build 169: Template parameter mismatch - compilation failed
 Build 170: Fixed use_facet signature to non-const reference (id&)
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-14

diff --git a/debian/cef_locale_stub.cpp b/debian/cef_locale_stub.cpp
new file mode 100644
index 0000000..5ce415c
--- /dev/null
+++ b/debian/cef_locale_stub.cpp
@@ -0,0 +1,136 @@
+// Debian: Minimal locale stub for protoc-gen-js linking
+
+#include <cstddef>
+
+namespace std {
+inline namespace __Cr {
+
+class locale {
+public:
+    class facet;
+    class id {
+    public:
+        id() noexcept;
+        ~id() noexcept;
+    };
+
+    locale() noexcept;
+    locale(const locale&) noexcept;
+    locale& operator=(const locale&) noexcept;
+    ~locale();
+
+    const facet* use_facet(id&) const;  // Non-const id& parameter
+};
+
+class locale::facet {
+protected:
+    explicit facet(size_t refs = 0);
+public:
+    virtual ~facet();
+
+private:
+    facet(const facet&) = delete;
+    void operator=(const facet&) = delete;
+};
+
+template<typename CharT>
+struct ctype_base {
+    typedef unsigned int mask;
+};
+
+template<typename CharT>
+class ctype : public locale::facet, public ctype_base<CharT> {
+public:
+    static locale::id id;
+
+    explicit ctype(size_t = 0);
+    virtual ~ctype();
+};
+
+template<typename CharT, typename OutputIter = char*>
+class num_put : public locale::facet {
+public:
+    static locale::id id;
+
+    explicit num_put(size_t = 0);
+    virtual ~num_put();
+};
+
+template<typename InternT, typename ExternT, typename StateT>
+class codecvt : public locale::facet {
+public:
+    static locale::id id;
+
+    explicit codecvt(size_t = 0);
+    virtual ~codecvt();
+};
+
+// Out-of-line definitions
+locale::id::id() noexcept {}
+locale::id::~id() noexcept {}
+
+locale::locale() noexcept {}
+locale::locale(const locale&) noexcept {}
+locale& locale::operator=(const locale&) noexcept { return *this; }
+locale::~locale() {}
+const locale::facet* locale::use_facet(id&) const { return nullptr; }
+
+locale::facet::facet(size_t) {}
+locale::facet::~facet() {}
+
+template<typename CharT>
+ctype<CharT>::ctype(size_t) : locale::facet(0) {}
+
+template<typename CharT>
+ctype<CharT>::~ctype() {}
+
+template<typename CharT, typename OutputIter>
+num_put<CharT, OutputIter>::num_put(size_t) : locale::facet(0) {}
+
+template<typename CharT, typename OutputIter>
+num_put<CharT, OutputIter>::~num_put() {}
+
+template<typename InternT, typename ExternT, typename StateT>
+codecvt<InternT, ExternT, StateT>::codecvt(size_t) : locale::facet(0) {}
+
+template<typename InternT, typename ExternT, typename StateT>
+codecvt<InternT, ExternT, StateT>::~codecvt() {}
+
+// Static member definitions with storage
+template<> locale::id ctype<char>::id{};
+template<> locale::id ctype<wchar_t>::id{};
+template<> locale::id num_put<char>::id{};
+template<> locale::id num_put<wchar_t>::id{};
+template<> locale::id codecvt<char, char, int>::id{};
+template<> locale::id codecvt<wchar_t, char, int>::id{};
+
+// Explicit instantiations
+template class ctype<char>;
+template class ctype<wchar_t>;
+template class num_put<char>;
+template class num_put<wchar_t>;
+template class codecvt<char, char, int>;
+template class codecvt<wchar_t, char, int>;
+
+} // namespace __Cr
+
+int uncaught_exceptions() noexcept {
+    return 0;
+}
+
+} // namespace std
+
+extern "C" {
+    int __cxa_guard_acquire(void* guard) {
+        return 1;
+    }
+
+    void __cxa_guard_release(void* guard) {
+    }
+
+    void __cxa_guard_abort(void* guard) {
+    }
+
+    void __cxa_pure_virtual() {
+    }
+}
