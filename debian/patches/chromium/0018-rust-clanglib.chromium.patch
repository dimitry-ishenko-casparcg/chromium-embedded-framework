Description: Use system compiler-rt libraries with architecture-specific paths for Linux
 Rust adds new clang dependencies, specifically libclang_rt.builtins.a.
 .
 This library is in the libclang-rt-22-dev package (for LLVM 22), but with a
 different and architecture-specific path than what Chromium's bundled LLVM
 expects. We separate Linux from ChromeOS handling and use the "linux"
 directory with architecture-specific suffixes (-x86_64, -i386, -aarch64,
 -armhf, -powerpc64le) instead of the full target triple paths that ChromeOS
 uses.
 .
 This allows the build system to find system-installed compiler-rt libraries
 in paths like /usr/lib/llvm-22/lib/clang/22/lib/linux/libclang_rt.builtins-x86_64.a
 instead of looking for chromium-style paths like
 /usr/lib/llvm-22/lib/clang/22/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-17

diff --git a/build/config/clang/BUILD.gn b/build/config/clang/BUILD.gn
index b171ee1..a1c2916 100644
--- a/build/config/clang/BUILD.gn
+++ b/build/config/clang/BUILD.gn
@@ -168,7 +168,22 @@ template("clang_lib") {
         }
       } else if (is_apple) {
         _dir = "darwin"
-      } else if (is_linux || is_chromeos) {
+      } else if (is_linux) {
+        _dir = "linux"
+        if (current_cpu == "x64") {
+          _suffix = "-x86_64"
+        } else if (current_cpu == "x86") {
+          _suffix = "-i386"
+        } else if (current_cpu == "arm64") {
+          _suffix = "-aarch64"
+        } else if (current_cpu == "arm") {
+          _suffix = "-armhf"
+        } else if (current_cpu == "ppc64") {
+          _suffix = "-powerpc64le"
+        } else {
+          assert(false)  # Unhandled cpu type
+        }
+      } else if (is_chromeos) {
         if (current_cpu == "x64") {
           _dir = "x86_64-unknown-linux-gnu"
         } else if (current_cpu == "x86") {
