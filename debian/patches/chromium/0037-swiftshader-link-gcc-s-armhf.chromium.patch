Description: Link libgcc_s for SwiftShader on armhf
 On armhf, __register_frame and __deregister_frame symbols from LLVM-16's
 RTDyldMemoryManager.cpp are not implicitly linked into libvk_swiftshader.so.
 These symbols are provided by libgcc_s. On amd64/arm64 they resolve
 implicitly, but armhf requires an explicit -lgcc_s.
 .
 Add the library on the _swiftshader_libvulkan source_set (not the
 shared_library target) so GN places -lgcc_s AFTER the object files
 in the link command. lld requires libraries to appear after the
 objects that reference them.
Author: Juan Manuel Mendez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-04-27

diff --git a/third_party/swiftshader/src/Vulkan/BUILD.gn b/third_party/swiftshader/src/Vulkan/BUILD.gn
index 852068c..5a58e36 100644
--- a/third_party/swiftshader/src/Vulkan/BUILD.gn
+++ b/third_party/swiftshader/src/Vulkan/BUILD.gn
@@ -175,6 +175,13 @@ swiftshader_source_set("_swiftshader_libvulkan") {
       "gdi32.lib",
       "user32.lib",
     ]
+  } else if (current_cpu == "arm") {
+    # On armhf, __register_frame/__deregister_frame from LLVM-16's
+    # RTDyldMemoryManager are not implicitly linked. Pull from libgcc_s.
+    # Must be in the source_set (not shared_library) so GN places the
+    # library AFTER the object files in the link command -- lld requires
+    # libraries to appear after the objects that reference them.
+    libs += [ "gcc_s" ]
   }

   public_deps = [
