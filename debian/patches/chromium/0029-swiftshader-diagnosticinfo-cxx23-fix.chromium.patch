Description: Fix DiagnosticInfo rvalue reference return types for C++23
 In C++23 with libc++, returning non-const lvalue reference from rvalue
 parameter is stricter. Use std::remove_reference_t to properly handle
 forwarding references in operator<< overloads, and add static_cast
 to return statements.
Author: Debian Chromium Team
Forwarded: not-needed
Last-Update: 2025-11-21

--- a/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/IR/DiagnosticInfo.h
+++ b/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/IR/DiagnosticInfo.h
@@ -552,14 +552,15 @@ operator<<(RemarkT &R,
 /// Also allow r-value for the remark to allow insertion into a
 /// temporarily-constructed remark.
 template <class RemarkT>
-RemarkT &
+std::remove_reference_t<RemarkT> &
 operator<<(RemarkT &&R,
            std::enable_if_t<
-               std::is_base_of<DiagnosticInfoOptimizationBase, RemarkT>::value,
+               std::is_base_of<DiagnosticInfoOptimizationBase,
+                               std::remove_reference_t<RemarkT>>::value,
                StringRef>
                S) {
   R.insert(S);
-  return R;
+  return static_cast<std::remove_reference_t<RemarkT> &>(R);
 }

 template <class RemarkT>
@@ -574,14 +575,15 @@ operator<<(RemarkT &R,
 }

 template <class RemarkT>
-RemarkT &
+std::remove_reference_t<RemarkT> &
 operator<<(RemarkT &&R,
            std::enable_if_t<
-               std::is_base_of<DiagnosticInfoOptimizationBase, RemarkT>::value,
+               std::is_base_of<DiagnosticInfoOptimizationBase,
+                               std::remove_reference_t<RemarkT>>::value,
                DiagnosticInfoOptimizationBase::Argument>
                A) {
   R.insert(A);
-  return R;
+  return static_cast<std::remove_reference_t<RemarkT> &>(R);
 }

 template <class RemarkT>
@@ -596,14 +598,15 @@ operator<<(RemarkT &R,
 }

 template <class RemarkT>
-RemarkT &
+std::remove_reference_t<RemarkT> &
 operator<<(RemarkT &&R,
            std::enable_if_t<
-               std::is_base_of<DiagnosticInfoOptimizationBase, RemarkT>::value,
+               std::is_base_of<DiagnosticInfoOptimizationBase,
+                               std::remove_reference_t<RemarkT>>::value,
                DiagnosticInfoOptimizationBase::setIsVerbose>
                V) {
   R.insert(V);
-  return R;
+  return static_cast<std::remove_reference_t<RemarkT> &>(R);
 }
