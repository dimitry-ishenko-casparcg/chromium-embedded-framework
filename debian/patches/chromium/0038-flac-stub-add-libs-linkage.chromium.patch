Description: Add library linkage to flac BUILD.gn stub
 The Debian Chromium tarball replaces bundled flac with a stub BUILD.gn
 that uses system libFLAC. However, the stub was missing the libs = [ "FLAC" ]
 declaration. This would cause undefined symbol errors for FLAC_* functions
 at link time.
 .
 Fix by adding proper config with include_dirs and libs declaration.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-12-05

diff --git a/third_party/flac/BUILD.gn b/third_party/flac/BUILD.gn
index 1ef5583..b40c9b8 100644
--- a/third_party/flac/BUILD.gn
+++ b/third_party/flac/BUILD.gn
@@ -1,2 +1,12 @@
 # Stub BUILD.gn for Debian builds - uses system flac
-source_set("flac") { sources = [] }
+# Links to system libFLAC via libs = [ "FLAC" ]
+
+config("flac_config") {
+  include_dirs = [ "/usr/include/FLAC" ]
+}
+
+source_set("flac") {
+  sources = []
+  public_configs = [ ":flac_config" ]
+  libs = [ "FLAC" ]
+}
