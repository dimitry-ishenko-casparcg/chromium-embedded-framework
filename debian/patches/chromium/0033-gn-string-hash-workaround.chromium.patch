Description: Work around missing string_hash() in older GN versions
 Debian's generate-ninja package does not yet include the string_hash()
 builtin function required by Chromium 145. Replace string_hash() calls
 with exec_script() calling a Python helper that computes SHA-256 hashes.
 .
 Based on Debian Chromium's trixie/gn-string-hash.patch by Andres Salomon.
 See Debian bug #1127702 for the generate-ninja update request.
Author: Juan Manuel Méndez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-02-15

diff --git a/build/dotfile_settings.gni b/build/dotfile_settings.gni
index 4911002..1408da9 100644
--- a/build/dotfile_settings.gni
+++ b/build/dotfile_settings.gni
@@ -16,6 +16,8 @@ build_dotfile_settings = {
     "//build/config/ios/ios_sdk.gni",
     "//build/config/ios/rules.gni",
     "//build/config/linux/atk/BUILD.gn",
+    "//build/rust/gni_impl/rust_target.gni",
+    "//build/rust/rust_static_library.gni",
     "//build/config/linux/atspi2/BUILD.gn",
     "//build/config/linux/BUILD.gn",
     "//build/config/linux/dri/BUILD.gn",
diff --git a/build/rust/gni_impl/rust_target.gni b/build/rust/gni_impl/rust_target.gni
index 2aed760..93552d1 100644
--- a/build/rust/gni_impl/rust_target.gni
+++ b/build/rust/gni_impl/rust_target.gni
@@ -48,7 +48,8 @@ template("rust_target") {
   if (defined(invoker.crate_name)) {
     _crate_name = invoker.crate_name
   } else {
-    _dir_hash = string_hash(get_label_info(":${_target_name}", "dir"))
+    lbl = get_label_info(":${_target_name}", "dir")
+    _dir_hash = string_join("", exec_script("//stringhash.py", [ lbl ], "list lines"))
     _crate_name = "${_target_name}_${_dir_hash}"
   }
   _generate_crate_root =
diff --git a/build/rust/rust_static_library.gni b/build/rust/rust_static_library.gni
index c8f78a8..3b8b56c 100644
--- a/build/rust/rust_static_library.gni
+++ b/build/rust/rust_static_library.gni
@@ -187,7 +187,8 @@ template("rust_static_library") {
       if (defined(invoker.crate_name)) {
         _crate_name = invoker.crate_name
       } else {
-        _dir_hash = string_hash(get_label_info(":${_target_name}", "dir"))
+        lbl = get_label_info(":${_target_name}", "dir")
+        _dir_hash = string_join("", exec_script("//stringhash.py", [ lbl ], "list lines"))
         _crate_name = "${_target_name}_${_dir_hash}"
       }

diff --git a/stringhash.py b/stringhash.py
new file mode 100644
index 0000000..97fe42b
--- /dev/null
+++ b/stringhash.py
@@ -0,0 +1,6 @@
+# string_hash() implementation for older versions of gn
+
+import hashlib
+import sys
+
+print(hashlib.sha256(sys.argv[1].encode('UTF-8')).hexdigest()[:8])
