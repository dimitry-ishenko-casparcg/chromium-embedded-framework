Description: Fix GN unused variable error in gcc_toolchain.gni
 GN enforces strict variable scoping and reports an error when variables
 are assigned but not used within the same scope. The deb_build_arch and
 deb_host_arch variables were declared outside the toolchain_args scope
 but only used inside it, causing "Assignment had no effect" errors during
 build.ninja regeneration. This patch moves the getenv() calls inside the
 toolchain_args scope and prefixes them with underscore to indicate they
 are private to that scope.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-27

diff --git a/build/toolchain/gcc_toolchain.gni b/build/toolchain/gcc_toolchain.gni
index d458560..09b4400 100644
--- a/build/toolchain/gcc_toolchain.gni
+++ b/build/toolchain/gcc_toolchain.gni
@@ -795,9 +795,6 @@ template("gcc_rust_host_build_tools_toolchain") {
                            "*",
                            TESTONLY_AND_VISIBILITY + [ "toolchain_args" ])

-    deb_build_arch = getenv("DEB_BUILD_ARCH")
-    deb_host_arch  = getenv("DEB_HOST_ARCH")
-
     #cxx           = getenv("RUST_MACRO_CXX")
     extra_ldflags  = getenv("RUST_MACRO_LDFLAGS")

@@ -816,20 +813,24 @@ template("gcc_rust_host_build_tools_toolchain") {
       generate_linker_map = false
       use_thin_lto = false

-      if (deb_host_arch != "" && deb_build_arch != "" &&
-          deb_host_arch != deb_build_arch) {
+      # Move getenv() calls inside toolchain_args to fix GN scoping error
+      _deb_build_arch = getenv("DEB_BUILD_ARCH")
+      _deb_host_arch  = getenv("DEB_HOST_ARCH")
+
+      if (_deb_host_arch != "" && _deb_build_arch != "" &&
+          _deb_host_arch != _deb_build_arch) {
         # Debian cross build: Use the build (native) arch for Rust macro
         # code, as it needs to dlopen()ed by rustc.

-        if (deb_build_arch == "amd64") {
+        if (_deb_build_arch == "amd64") {
           current_cpu = "x64"
-        } else if (deb_build_arch == "armhf") {
+        } else if (_deb_build_arch == "armhf") {
           current_cpu = "arm"
-        } else if (deb_build_arch == "arm64") {
+        } else if (_deb_build_arch == "arm64") {
           current_cpu = "arm64"
-        } else if (deb_build_arch == "i386") {
+        } else if (_deb_build_arch == "i386") {
           current_cpu = "x86"
-        } else if (deb_build_arch == "ppc64el") {
+        } else if (_deb_build_arch == "ppc64el") {
           current_cpu = "ppc64"
         } else {
           assert(false)  # Unhandled CPU type
