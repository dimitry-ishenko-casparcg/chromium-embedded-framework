Description: Fix APFloat C++23 compatibility in SwiftShader's bundled LLVM-16
 In C++23 with libc++, std::unique_ptr's destructor is constexpr, which
 forces early instantiation requiring the complete type at class definition.
 Since APFloat is only forward-declared when DoubleAPFloat is defined,
 this causes "incomplete type" errors.
 .
 This patch replaces unique_ptr<APFloat[]> with a raw pointer, adds
 an explicit destructor, and moves inline accessors out-of-line.
 This matches the fix in LLVM's main branch.
Author: CEF Debian Maintainers
Last-Update: 2025-11-20

diff --git a/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/ADT/APFloat.h b/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/ADT/APFloat.h
index c0e2d13..01107ff 100644
--- a/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/ADT/APFloat.h
+++ b/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/ADT/APFloat.h
@@ -622,7 +622,10 @@ IEEEFloat frexp(const IEEEFloat &Val, int &Exp, IEEEFloat::roundingMode RM);
 class DoubleAPFloat final : public APFloatBase {
   // Note: this must be the first data member.
   const fltSemantics *Semantics;
-  std::unique_ptr<APFloat[]> Floats;
+  // Use raw pointer instead of unique_ptr for C++23 compatibility.
+  // In C++23, unique_ptr's constexpr destructor requires complete type at
+  // class definition, but APFloat is only forward-declared at this point.
+  APFloat *Floats;

   opStatus addImpl(const APFloat &a, const APFloat &aa, const APFloat &c,
                    const APFloat &cc, roundingMode RM);
@@ -638,6 +641,7 @@ public:
   DoubleAPFloat(const fltSemantics &S, APFloat &&First, APFloat &&Second);
   DoubleAPFloat(const DoubleAPFloat &RHS);
   DoubleAPFloat(DoubleAPFloat &&RHS);
+  ~DoubleAPFloat();

   DoubleAPFloat &operator=(const DoubleAPFloat &RHS);

@@ -651,10 +655,11 @@ public:

   bool needsCleanup() const { return Floats != nullptr; }

-  APFloat &getFirst() { return Floats[0]; }
-  const APFloat &getFirst() const { return Floats[0]; }
-  APFloat &getSecond() { return Floats[1]; }
-  const APFloat &getSecond() const { return Floats[1]; }
+  // Out-of-line definitions required for C++23 compatibility
+  APFloat &getFirst();
+  const APFloat &getFirst() const;
+  APFloat &getSecond();
+  const APFloat &getSecond() const;

   opStatus add(const DoubleAPFloat &RHS, roundingMode RM);
   opStatus subtract(const DoubleAPFloat &RHS, roundingMode RM);
diff --git a/third_party/swiftshader/third_party/llvm-16.0/llvm/lib/Support/APFloat.cpp b/third_party/swiftshader/third_party/llvm-16.0/llvm/lib/Support/APFloat.cpp
index eae4fdb..cac5d17 100644
--- a/third_party/swiftshader/third_party/llvm-16.0/llvm/lib/Support/APFloat.cpp
+++ b/third_party/swiftshader/third_party/llvm-16.0/llvm/lib/Support/APFloat.cpp
@@ -4548,11 +4548,19 @@ DoubleAPFloat::DoubleAPFloat(const DoubleAPFloat &RHS)
 }

 DoubleAPFloat::DoubleAPFloat(DoubleAPFloat &&RHS)
-    : Semantics(RHS.Semantics), Floats(std::move(RHS.Floats)) {
+    : Semantics(RHS.Semantics), Floats(RHS.Floats) {
+  RHS.Floats = nullptr;
   RHS.Semantics = &semBogus;
   assert(Semantics == &semPPCDoubleDouble);
 }

+DoubleAPFloat::~DoubleAPFloat() { delete[] Floats; }
+
+APFloat &DoubleAPFloat::getFirst() { return Floats[0]; }
+const APFloat &DoubleAPFloat::getFirst() const { return Floats[0]; }
+APFloat &DoubleAPFloat::getSecond() { return Floats[1]; }
+const APFloat &DoubleAPFloat::getSecond() const { return Floats[1]; }
+
 DoubleAPFloat &DoubleAPFloat::operator=(const DoubleAPFloat &RHS) {
   if (Semantics == RHS.Semantics && RHS.Floats) {
     Floats[0] = RHS.Floats[0];
