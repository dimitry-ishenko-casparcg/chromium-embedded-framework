Description: Compile locale stub library using GN action to bypass ThinLTO
 protoc-gen-js requires locale symbols from libc++ for iostream initialization.
 The bundled libc++'s locale.cpp cannot be compiled on Debian due to type
 conflicts with glibc headers.
 .
 This patch uses a GN action() target to compile the locale stub library
 (liblocale_stub.a) using clang++ directly, completely bypassing the GN config
 system and ThinLTO. The action runs after gn gen but before ninja compiles
 protoc-gen-js, ensuring correct timing and symbol preservation.
 .
 Previous approaches (Builds 165-175h):
 - Build 165-174: Adding stub to sources with config changes - FAILED (ThinLTO still applied)
 - Build 175: Pre-compiling in debian/rules - FAILED (gn gen cleans out/ directory)
 .
 GN action() approach (Build 175i):
 - Compiles AFTER gn gen (correct timing)
 - Uses direct clang++ invocation (bypasses GN configs)
 - Bypasses ThinLTO completely (no -flto flags applied)
 - Library available when ninja needs it
 .
 Technical details:
 - action() executes shell commands, not GN compilation
 - rebase_path() converts GN paths to filesystem paths
 - $root_out_dir expands to out/Debug_GN_x64
 - deps = [ ":compile_locale_stub" ] ensures correct build order
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-14

--- a/third_party/protobuf-javascript/BUILD.gn
+++ b/third_party/protobuf-javascript/BUILD.gn
@@ -4,6 +4,32 @@

 # Only compile the compiler for the host architecture.
 if (current_toolchain == host_toolchain) {
+  # Debian: Compile locale stub library outside GN config system
+  # This action() compiles the stub with clang++ directly, bypassing ThinLTO
+  action("compile_locale_stub") {
+    script = "//build/gn_run_binary.py"
+
+    # Input: Debian stub source file
+    sources = [ "//debian/cef_locale_stub.cpp" ]
+
+    # Output: Static library
+    outputs = [ "$root_out_dir/obj/debian/liblocale_stub.a" ]
+
+    # Create output directory and compile stub
+    # Use rebase_path to convert GN paths to filesystem paths
+    args = [
+      "/bin/sh",
+      "-c",
+      "mkdir -p $root_out_dir/obj/debian && " +
+      "clang++ -std=c++17 -c " +
+      "-isystem " + rebase_path("//third_party/libc++/src/include", root_build_dir) + " " +
+      "-isystem " + rebase_path("//third_party/perfetto/buildtools/libcxx_config", root_build_dir) + " " +
+      rebase_path("//debian/cef_locale_stub.cpp", root_build_dir) + " " +
+      "-o $root_out_dir/obj/debian/locale_stub.o && " +
+      "ar rcs $root_out_dir/obj/debian/liblocale_stub.a $root_out_dir/obj/debian/locale_stub.o"
+    ]
+  }
+
   executable("protoc-gen-js") {
     sources = [
       "src/generator/js_generator.cc",
@@ -13,12 +39,19 @@ if (current_toolchain == host_toolchain) {
       "src/generator/well_known_types_embed.h",
     ]
     include_dirs = [ "src" ]
+
     deps = [
+      ":compile_locale_stub",  # Debian: Ensure stub compiles first
       "//third_party/protobuf:protoc_lib",

       # Default manifest on Windows (a no-op elsewhere).
       "//build/win:default_exe_manifest",
     ]
+
+    # Debian: Link against locale stub library
+    libs = [ "locale_stub" ]
+    lib_dirs = [ "$root_out_dir/obj/debian" ]
+
     configs -= [ "//build/config/compiler:chromium_code" ]
     configs += [ "//build/config/compiler:no_chromium_code" ]
   }
