Description: Fix GCC 15 consteval error with MakeFixedFlatSet<AddressCountryCode>
 GCC 15's consteval MakeFixedFlatSet cannot be used with AddressCountryCode
 because it wraps std::string (via base::StrongAlias) which involves heap
 allocation at compile time. Replace with a runtime helper function using
 a constexpr string_view array for the country codes lookup.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-30

diff --git a/components/autofill/core/browser/data_model/addresses/autofill_structured_address_component.cc b/components/autofill/core/browser/data_model/addresses/autofill_structured_address_component.cc
index 42aadc4..5160eb4 100644
--- a/components/autofill/core/browser/data_model/addresses/autofill_structured_address_component.cc
+++ b/components/autofill/core/browser/data_model/addresses/autofill_structured_address_component.cc
@@ -31,8 +31,18 @@ namespace autofill {

 namespace {
 // The list of countries where the fallback parsing is not supported.
-static constexpr auto countries_not_supporting_fallback_parsing =
-    base::MakeFixedFlatSet<AddressCountryCode>({AddressCountryCode("IN")});
+// GCC 15: Cannot use MakeFixedFlatSet<AddressCountryCode> because AddressCountryCode
+// wraps std::string which cannot be consteval-constructed. Use string_view comparison.
+constexpr std::string_view kCountriesNotSupportingFallbackParsing[] = {"IN"};
+
+bool IsCountryNotSupportingFallbackParsing(const AddressCountryCode& country) {
+  for (std::string_view code : kCountriesNotSupportingFallbackParsing) {
+    if (country.value() == code) {
+      return true;
+    }
+  }
+  return false;
+}
 }  // namespace

 std::string_view VerificationStatusToStringView(VerificationStatus status) {
@@ -501,7 +511,7 @@ void AddressComponent::ParseValueAndAssignSubcomponents() {
   // As a final fallback, parse using the fallback method.
   // In some countries (e.g. India), the parsing cannot be reliably implemented
   // and the fallback method does more harm than good.
-  if (!countries_not_supporting_fallback_parsing.contains(GetCountryCode())) {
+  if (!IsCountryNotSupportingFallbackParsing(GetCountryCode())) {
     ParseValueAndAssignSubcomponentsByFallbackMethod();
   }
 }
