Description: Replace ++std::find rvalue increment with std::next in private_key_factory.cc
 clang-19 with system libc++ rejects pre-incrementing the rvalue iterator
 returned by std::find: "expression is not assignable". The prefix ++ operator
 requires a non-const lvalue reference, but std::find returns a temporary.
 Replace with std::next() which accepts an iterator by value and returns the
 next iterator, without requiring an lvalue. Also adds <iterator> explicitly
 since std::next lives there.
Author: Juan Manuel Méndez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-04-08

diff --git a/components/enterprise/client_certificates/core/private_key_factory.cc b/components/enterprise/client_certificates/core/private_key_factory.cc
index f2365aa..ab41e12 100644
--- a/components/enterprise/client_certificates/core/private_key_factory.cc
+++ b/components/enterprise/client_certificates/core/private_key_factory.cc
@@ -5,6 +5,7 @@
 #include "components/enterprise/client_certificates/core/private_key_factory.h"
 
 #include <array>
+#include <iterator>
 #include <optional>
 
 #include "base/functional/callback.h"
@@ -123,8 +124,8 @@ void PrivateKeyFactoryImpl::OnPrivateKeyCreated(
     scoped_refptr<PrivateKey> private_key) {
   if (!private_key && source != PrivateKeySource::kSoftwareKey) {
     for (auto fallback_source =
-             ++std::find(std::begin(kKeySourcesOrderedBySecurity),
-                         std::end(kKeySourcesOrderedBySecurity), source);
+             std::next(std::find(std::begin(kKeySourcesOrderedBySecurity),
+                                 std::end(kKeySourcesOrderedBySecurity), source));
          fallback_source != std::end(kKeySourcesOrderedBySecurity);
          fallback_source++) {
       auto it = sub_factories_.find(*fallback_source);
