Description: Fix AAResults::Concept C++23 incomplete type error
 In C++23 with libc++, std::unique_ptr destructor is constexpr and requires
 complete type at class definition. Replace unique_ptr with raw pointers
 and explicit cleanup in destructor for AAResults::Concept.
Author: Debian Chromium Team
Forwarded: not-needed
Last-Update: 2025-11-21

--- a/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/Analysis/AliasAnalysis.h
+++ b/third_party/swiftshader/third_party/llvm-16.0/llvm/include/llvm/Analysis/AliasAnalysis.h
@@ -596,7 +596,7 @@ private:

   const TargetLibraryInfo &TLI;

-  std::vector<std::unique_ptr<Concept>> AAs;
+  std::vector<Concept*> AAs;

   std::vector<AnalysisKey *> AADeps;

--- a/third_party/swiftshader/third_party/llvm-16.0/llvm/lib/Analysis/AliasAnalysis.cpp
+++ b/third_party/swiftshader/third_party/llvm-16.0/llvm/lib/Analysis/AliasAnalysis.cpp
@@ -76,7 +76,10 @@ static const bool EnableAATrace = false;
 AAResults::AAResults(AAResults &&Arg)
     : TLI(Arg.TLI), AAs(std::move(Arg.AAs)), AADeps(std::move(Arg.AADeps)) {}

-AAResults::~AAResults() {}
+AAResults::~AAResults() {
+  for (Concept *AA : AAs)
+    delete AA;
+}

 bool AAResults::invalidate(Function &F, const PreservedAnalyses &PA,
                            FunctionAnalysisManager::Invalidator &Inv) {
