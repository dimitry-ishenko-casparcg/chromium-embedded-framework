Description: Fix libc++ value_or template deduction with SkPoint
 libc++ cannot deduce the template argument for std::optional::value_or()
 from a brace-initializer list like {0, 0}. This is a known difference
 between libc++ and libstdc++.
 .
 The fix is to explicitly construct SkPoint using SkPoint::Make(0, 0)
 instead of relying on implicit construction from {0, 0}.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Forwarded: not-needed
Last-Update: 2026-01-15

diff --git a/ui/gfx/paint_vector_icon.cc b/ui/gfx/paint_vector_icon.cc
index eef47b4..cb6dc3e 100644
--- a/ui/gfx/paint_vector_icon.cc
+++ b/ui/gfx/paint_vector_icon.cc
@@ -235,7 +235,7 @@ void PaintPath(Canvas* canvas,
         break;

       case H_LINE_TO: {
-        const SkPoint last_point = path.getLastPt().value_or({0, 0});
+        const SkPoint last_point = path.getLastPt().value_or(SkPoint::Make(0, 0));
         path.lineTo(arg(0), last_point.fY);
         break;
       }
@@ -245,7 +245,7 @@ void PaintPath(Canvas* canvas,
         break;

       case V_LINE_TO: {
-        const SkPoint last_point = path.getLastPt().value_or({0, 0});
+        const SkPoint last_point = path.getLastPt().value_or(SkPoint::Make(0, 0));
         path.lineTo(last_point.fX, arg(0));
         break;
       }
@@ -273,7 +273,7 @@ void PaintPath(Canvas* canvas,
         // details.
         // Note that |x1| and |y1| will correspond to the sole control point if
         // calculating a quadratic curve.
-        const SkPoint last_point = path.getLastPt().value_or({0, 0});
+        const SkPoint last_point = path.getLastPt().value_or(SkPoint::Make(0, 0));
         SkScalar delta_x = 0;
         SkScalar delta_y = 0;
         if (IsCommandTypeCurve(previous_command_type)) {
