Description: Fix GCC 15 libstdc++ flat_map with move-only OnceCallback
 GCC 15's libstdc++ flat_map implementation triggers construct_at during
 template instantiation for value types, which fails for move-only types
 like base::OnceCallback that have deleted copy constructors.
 .
 The fix replaces base::flat_map with std::map for the pending_callbacks_
 and pending_creations_ members. std::map uses node-based storage that
 doesn't require copying value types during internal operations.
 .
 Error was: no matching function for call to 'construct_at'
 note: 'OnceCallback' has been explicitly marked deleted here
Author: Juan Manuel Mendez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-12-02

diff --git a/ui/ozone/platform/wayland/host/wayland_wp_color_manager.h b/ui/ozone/platform/wayland/host/wayland_wp_color_manager.h
index 0599b06..c750850 100644
--- a/ui/ozone/platform/wayland/host/wayland_wp_color_manager.h
+++ b/ui/ozone/platform/wayland/host/wayland_wp_color_manager.h
@@ -8,6 +8,7 @@
 #include <color-management-v1-client-protocol.h>

 #include <cstdint>
+#include <map>
 #include <memory>

 #include "base/containers/flat_map.h"
@@ -120,12 +121,15 @@ class WaylandWpColorManager
       image_description_cache_{64};

   // Callbacks for image descriptions that are being created.
-  base::flat_map<ImageDescription,
-                 std::vector<WaylandWpImageDescription::CreationCallback>>
+  // Using std::map instead of base::flat_map because GCC 15 libstdc++'s
+  // flat_map template instantiation triggers construct_at for value types,
+  // which fails for move-only types like OnceCallback.
+  std::map<ImageDescription,
+           std::vector<WaylandWpImageDescription::CreationCallback>>
       pending_callbacks_;

   // Holds the image description objects while their creation is pending.
-  base::flat_map<ImageDescription, scoped_refptr<WaylandWpImageDescription>>
+  std::map<ImageDescription, scoped_refptr<WaylandWpImageDescription>>
       pending_creations_;

   // Feature support, as bitsets.
