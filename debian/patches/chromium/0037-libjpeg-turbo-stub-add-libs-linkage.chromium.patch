Description: Add library linkage to libjpeg_turbo BUILD.gn stub
 The Debian Chromium tarball replaces bundled libjpeg-turbo with a stub BUILD.gn
 that uses system libjpeg. However, the stub was missing the libs = [ "jpeg" ]
 declaration and the main libjpeg source_set target. This would cause undefined
 symbol errors for jpeg_* functions at link time.
 .
 Fix by adding proper config with include_dirs, libjpeg source_set with libs
 declaration, and applying config to simd/simd_asm targets.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-12-05

diff --git a/third_party/libjpeg_turbo/BUILD.gn b/third_party/libjpeg_turbo/BUILD.gn
index 2ff91aa..51000e1 100644
--- a/third_party/libjpeg_turbo/BUILD.gn
+++ b/third_party/libjpeg_turbo/BUILD.gn
@@ -1,5 +1,23 @@
 # Stub BUILD.gn for Debian builds
 # Debian uses system libjpeg instead of bundled libjpeg-turbo
+# Links to system libjpeg via libs = [ "jpeg" ]
 
-source_set("simd") { sources = [] }
-source_set("simd_asm") { sources = [] }
+config("libjpeg_config") {
+  include_dirs = [ "/usr/include" ]
+}
+
+source_set("libjpeg") {
+  sources = []
+  public_configs = [ ":libjpeg_config" ]
+  libs = [ "jpeg" ]
+}
+
+source_set("simd") {
+  sources = []
+  public_configs = [ ":libjpeg_config" ]
+}
+
+source_set("simd_asm") {
+  sources = []
+  public_configs = [ ":libjpeg_config" ]
+}
