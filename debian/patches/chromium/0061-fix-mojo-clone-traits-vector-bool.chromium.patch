Description: Add mojo::CloneTraits specialization for vector<bool> (system libc++)
 libc++ vector<bool> uses bit packing, so its const_reference type is
 __bit_const_reference<vector<bool>>, not bool. The generic CloneTraits<vector<T>>
 template iterates over elements and calls mojo::Clone(element), but
 mojo::Clone<__bit_const_reference> has no specialization and fails the
 static_assert in the default CloneTraits ("T is not copyable and has no
 Clone() method"). This manifests when using system libc++ (use_custom_libcxx=false).
 .
 Since vector<bool> is itself copyable (it has a copy constructor that correctly
 copies all bits), a specialization that simply returns a copy avoids the
 element-wise iteration entirely.
Author: Juan Manuel Méndez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-04-07

diff --git a/mojo/public/cpp/bindings/clone_traits.h b/mojo/public/cpp/bindings/clone_traits.h
index 1cb9629..b62ecce 100644
--- a/mojo/public/cpp/bindings/clone_traits.h
+++ b/mojo/public/cpp/bindings/clone_traits.h
@@ -63,6 +63,17 @@ struct CloneTraits<std::vector<T>> {
   }
 };
 
+// Specialization for vector<bool>: libc++ vector<bool> uses bit packing and
+// its const_reference type is __bit_const_reference (not bool), which is not
+// cloneable via the generic template above. Since vector<bool> is copyable,
+// use its copy constructor directly.
+template <>
+struct CloneTraits<std::vector<bool>> {
+  static std::vector<bool> Clone(const std::vector<bool>& input) {
+    return input;
+  }
+};
+
