Description: Remove nightly-only Rust options from crabbyavif BUILD.gn
 Debian uses stable Rust, which does not support nightly-only -Z options.
 The -Zallow-features=sanitize flag is required for the disable_cfi feature
 but fails on stable Rust. This patch removes both the nightly-only rustflag
 and the disable_cfi feature to enable compilation with stable Rust.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-27

diff --git a/third_party/crabbyavif/BUILD.gn b/third_party/crabbyavif/BUILD.gn
index 38b2055..2ef6b13 100644
--- a/third_party/crabbyavif/BUILD.gn
+++ b/third_party/crabbyavif/BUILD.gn
@@ -197,12 +197,12 @@ rust_static_library("crabbyavif") {
     "dav1d",
     "libyuv",
     "capi",
-    "disable_cfi",
+    # "disable_cfi" removed - requires nightly-only -Zallow-features=sanitize
   ]

-  # Required for disable_cfi feature.
-  configs -= [ "//build/config/compiler:disallow_unstable_features" ]
-  rustflags = [ "-Zallow-features=sanitize" ]
+  # Removed nightly-only Rust options for stable Rust compatibility:
+  # configs -= [ "//build/config/compiler:disallow_unstable_features" ]
+  # rustflags = [ "-Zallow-features=sanitize" ]

   public_deps = [ ":header_files" ]
   deps = [
