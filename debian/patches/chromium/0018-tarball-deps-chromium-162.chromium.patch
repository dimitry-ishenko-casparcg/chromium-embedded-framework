Description: Disable git-dependent gclient hooks for Chromium 142.0.7444.162 tarball builds
 CEF's tarball_deps.patch is designed for Chromium .134 and fails on .162 due to
 line number changes in DEPS file. This Debian patch replicates the same
 functionality for Chromium .162 by adding 'not source_tarball' conditions to
 5 gclient hooks that query git history.
 .
 These hooks (lastchange, lastchange_commit_position_cros, gpu_lists_version,
 lastchange_skia, lastchange_dawn) fail in Debian builds because git history
 doesn't exist in source tarballs. Disabling them prevents build failures while
 maintaining compatibility with Debian Policy §4.9 (no network access).
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-15

diff --git a/DEPS b/DEPS
index 2c9319b..9e91238 100644
--- a/DEPS
+++ b/DEPS
@@ -4198,6 +4198,7 @@ hooks = [
     # Update LASTCHANGE.
     'name': 'lastchange',
     'pattern': '.',
+    'condition': 'not source_tarball',
     'action': ['python3', 'src/build/util/lastchange.py',
                '-o', 'src/build/util/LASTCHANGE'],
   },
@@ -4205,7 +4206,7 @@ hooks = [
     # Update lastchange_commit_position.h (only for CrOS).
     'name': 'lastchange_commit_position_cros',
     'pattern': '.',
-    'condition': 'checkout_chromeos',
+    'condition': 'checkout_chromeos and not source_tarball',
     'action': ['python3', 'src/build/util/lastchange.py',
                '-m', 'CHROMIUM',
                '--commit-position-header',
@@ -4215,6 +4216,7 @@ hooks = [
     # Update GPU lists version string (for gpu/config).
     'name': 'gpu_lists_version',
     'pattern': '.',
+    'condition': 'not source_tarball',
     'action': ['python3', 'src/build/util/lastchange.py',
                '-m', 'GPU_LISTS_VERSION',
                '--revision-id-only',
@@ -4224,6 +4226,7 @@ hooks = [
     # Update skia_commit_hash.h.
     'name': 'lastchange_skia',
     'pattern': '.',
+    'condition': 'not source_tarball',
     'action': ['python3', 'src/build/util/lastchange.py',
                '-m', 'SKIA_COMMIT_HASH',
                '-s', 'src/third_party/skia',
@@ -4233,6 +4236,7 @@ hooks = [
     # Update dawn_version.h.
     'name': 'lastchange_dawn',
     'pattern': '.',
+    'condition': 'not source_tarball',
     'action': ['python3', 'src/build/util/lastchange.py',
                '-m', 'DAWN_COMMIT_HASH',
                '-s', 'src/third_party/dawn',
