Description: Fix C++23 incomplete type error in gin/public/isolate_holder.h
 With C++23 and libc++, std::unique_ptr<T> default parameter initialization
 requires T to be a complete type because the destructor may be instantiated.
 v8::CppHeap is only forward-declared in v8/include/v8-isolate.h, causing:
 .
   error: invalid application of 'sizeof' to an incomplete type 'v8::CppHeap'
 .
 This patch splits the constructor with std::unique_ptr<v8::CppHeap> cpp_heap = {}
 default parameter into two overloads:
 1. One without cpp_heap parameter (uses defaults from header)
 2. One with explicit cpp_heap parameter (no default, type complete in .cc)
 .
 The .cc file includes v8/include/v8-cppgc.h where CppHeap is fully defined.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-27

diff --git a/gin/isolate_holder.cc b/gin/isolate_holder.cc
index 8a9be90..5af239f 100644
--- a/gin/isolate_holder.cc
+++ b/gin/isolate_holder.cc
@@ -71,6 +71,30 @@ IsolateHolder::IsolateHolder(
                     isolate_type,
                     IsolateCreationMode::kNormal) {}

+// Debian: Delegating constructor for C++23 compatibility.
+// This overload without cpp_heap delegates to the one with cpp_heap=nullptr.
+// v8::CppHeap is complete here (v8-cppgc.h is included above).
+IsolateHolder::IsolateHolder(
+    scoped_refptr<base::SingleThreadTaskRunner> task_runner,
+    AccessMode access_mode,
+    AllowAtomicsWaitMode atomics_wait_mode,
+    IsolateType isolate_type,
+    IsolateCreationMode isolate_creation_mode,
+    v8::CreateHistogramCallback create_histogram_callback,
+    v8::AddHistogramSampleCallback add_histogram_sample_callback,
+    scoped_refptr<base::SingleThreadTaskRunner> user_visible_task_runner,
+    scoped_refptr<base::SingleThreadTaskRunner> best_effort_task_runner)
+    : IsolateHolder(std::move(task_runner),
+                    access_mode,
+                    atomics_wait_mode,
+                    isolate_type,
+                    isolate_creation_mode,
+                    create_histogram_callback,
+                    add_histogram_sample_callback,
+                    std::move(user_visible_task_runner),
+                    std::move(best_effort_task_runner),
+                    nullptr) {}
+
 IsolateHolder::IsolateHolder(
     scoped_refptr<base::SingleThreadTaskRunner> task_runner,
     AccessMode access_mode,
diff --git a/gin/public/isolate_holder.h b/gin/public/isolate_holder.h
index ff42cfb..f85b665 100644
--- a/gin/public/isolate_holder.h
+++ b/gin/public/isolate_holder.h
@@ -76,6 +76,9 @@ class GIN_EXPORT IsolateHolder {
   IsolateHolder(scoped_refptr<base::SingleThreadTaskRunner> task_runner,
                 AccessMode access_mode,
                 IsolateType isolate_type);
+  // Debian: Split constructor to avoid C++23 incomplete type error with
+  // std::unique_ptr<v8::CppHeap> default parameter. v8::CppHeap is forward-
+  // declared in v8-isolate.h but unique_ptr's destructor needs complete type.
   IsolateHolder(
       scoped_refptr<base::SingleThreadTaskRunner> task_runner,
       AccessMode access_mode,
@@ -87,8 +90,19 @@ class GIN_EXPORT IsolateHolder {
       scoped_refptr<base::SingleThreadTaskRunner> user_visible_task_runner =
           nullptr,
       scoped_refptr<base::SingleThreadTaskRunner> best_effort_task_runner =
-          nullptr,
-      std::unique_ptr<v8::CppHeap> cpp_heap = {});
+          nullptr);
+  // Overload with explicit CppHeap parameter (no default, type complete in .cc)
+  IsolateHolder(
+      scoped_refptr<base::SingleThreadTaskRunner> task_runner,
+      AccessMode access_mode,
+      AllowAtomicsWaitMode atomics_wait_mode,
+      IsolateType isolate_type,
+      IsolateCreationMode isolate_creation_mode,
+      v8::CreateHistogramCallback create_histogram_callback,
+      v8::AddHistogramSampleCallback add_histogram_sample_callback,
+      scoped_refptr<base::SingleThreadTaskRunner> user_visible_task_runner,
+      scoped_refptr<base::SingleThreadTaskRunner> best_effort_task_runner,
+      std::unique_ptr<v8::CppHeap> cpp_heap);
   IsolateHolder(
       scoped_refptr<base::SingleThreadTaskRunner> task_runner,
       AccessMode access_mode,
