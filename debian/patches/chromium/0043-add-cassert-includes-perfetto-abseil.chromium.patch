Description: Add cassert includes to perfetto headers
 After disabling assert redefinition in base/logging.h (patch 0041) and
 partition_alloc logging.h (patch 0042), some third-party headers that use
 assert() need explicit #include <cassert> to ensure assert is available.
 .
 Perfetto scattered_stream_writer.h was using <assert.h> (C-style), changed
 to <cassert>. Perfetto locked_handle.h was missing the include entirely.
 .
 Note: data_source_type.h fix was upstreamed in Chromium 145 (already has
 <cassert>), so that hunk was removed from this patch.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-02-16

diff --git a/third_party/perfetto/include/perfetto/protozero/scattered_stream_writer.h b/third_party/perfetto/include/perfetto/protozero/scattered_stream_writer.h
index 719c490..81007e1 100644
--- a/third_party/perfetto/include/perfetto/protozero/scattered_stream_writer.h
+++ b/third_party/perfetto/include/perfetto/protozero/scattered_stream_writer.h
@@ -17,7 +17,7 @@
 #ifndef INCLUDE_PERFETTO_PROTOZERO_SCATTERED_STREAM_WRITER_H_
 #define INCLUDE_PERFETTO_PROTOZERO_SCATTERED_STREAM_WRITER_H_
 
-#include <assert.h>
+#include <cassert>
 #include <stddef.h>
 #include <stdint.h>
 #include <string.h>
diff --git a/third_party/perfetto/include/perfetto/tracing/locked_handle.h b/third_party/perfetto/include/perfetto/tracing/locked_handle.h
index 9f1c65b..0fe7cb1 100644
--- a/third_party/perfetto/include/perfetto/tracing/locked_handle.h
+++ b/third_party/perfetto/include/perfetto/tracing/locked_handle.h
@@ -17,6 +17,7 @@
 #ifndef INCLUDE_PERFETTO_TRACING_LOCKED_HANDLE_H_
 #define INCLUDE_PERFETTO_TRACING_LOCKED_HANDLE_H_
 
+#include <cassert>
 #include <mutex>
 
 namespace perfetto {
