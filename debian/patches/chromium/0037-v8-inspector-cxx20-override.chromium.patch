Description: Compile V8 inspector with C++20 via config to avoid libc++ C++23 errors
 C++23 with libc++ introduced strict incomplete type checking for std::unique_ptr
 (static_assert(sizeof(_Tp) >= 0) in destructor). The V8 inspector protocol
 generated code has circular type dependencies (ObjectPreview <-> PropertyPreview
 <-> ObjectPreview) that cannot be resolved without major template changes.
 .
 This patch creates a new config "inspector_cxx20" with -std=c++20 and adds it to
 the inspector target's configs list. Since v8_source_set template adds invoker
 configs LAST, the C++20 flag will appear after the global C++23 flag, and the
 last flag wins.
 .
 Previous approaches that failed:
 - cflags_cc = ["-std=c++20"]: GN adds target flags before config flags, so C++23 wins
 - cflags_cc -= ["-std=c++23"]: GN error "Undefined identifier" since cflags_cc not defined
 .
 See: https://github.com/llvm/llvm-project/issues/111185
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-27

diff --git a/v8/src/inspector/BUILD.gn b/v8/src/inspector/BUILD.gn
index 9a86323..d6304f3 100644
--- a/v8/src/inspector/BUILD.gn
+++ b/v8/src/inspector/BUILD.gn
@@ -72,6 +72,16 @@ config("inspector_internal_config") {
   include_dirs = [ "../../include" ]
 }

+# C++23 with libc++ has strict incomplete type checking for unique_ptr.
+# The inspector protocol generated code has circular type dependencies
+# (ObjectPreview <-> PropertyPreview) that cannot be fixed without
+# major template changes. Compile inspector with C++20 to avoid this issue.
+# See: https://github.com/llvm/llvm-project/issues/111185
+config("inspector_cxx20") {
+  visibility = [ ":*" ]
+  cflags_cc = [ "-std=c++20" ]
+}
+
 v8_header_set("inspector_test_headers") {
   configs = [ ":inspector_internal_config" ]

@@ -103,7 +113,10 @@ v8_source_set("inspector") {
     "../../:v8_libbase",
   ]

-  configs = [ ":inspector_internal_config" ]
+  configs = [
+    ":inspector_internal_config",
+    ":inspector_cxx20",  # Must be last to override global C++23 flag
+  ]

   public_configs = [ ":inspector_config" ]

