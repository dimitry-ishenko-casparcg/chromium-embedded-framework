Description: Fix C++23 incomplete type error in ui::Shadow::ShadowLayerOwner
 C++23 with libc++ requires complete type when unique_ptr destructor is
 instantiated. The default parameter `= nullptr` in the constructor declaration
 causes unique_ptr<Layer>::~unique_ptr() to be instantiated in the header
 where Layer is only forward-declared.
 .
 Fix by splitting into two constructors: one taking only Shadow* owner,
 and one taking both Shadow* and unique_ptr<Layer>. Both are defined in the
 .cc file where Layer is complete.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-27

diff --git a/ui/compositor_extra/shadow.cc b/ui/compositor_extra/shadow.cc
index 4b88203..f129dbc 100644
--- a/ui/compositor_extra/shadow.cc
+++ b/ui/compositor_extra/shadow.cc
@@ -111,6 +111,10 @@ void Shadow::OnImplicitAnimationsCompleted() {
 // -----------------------------------------------------------------------------
 // Shadow::ShadowLayerOwner:

+// C++23 fix: Single-argument constructor defined here where Layer is complete.
+Shadow::ShadowLayerOwner::ShadowLayerOwner(Shadow* owner)
+    : owner_shadow_(owner) {}
+
 Shadow::ShadowLayerOwner::ShadowLayerOwner(Shadow* owner,
                                            std::unique_ptr<Layer> layer)
     : LayerOwner(std::move(layer)), owner_shadow_(owner) {}
diff --git a/ui/compositor_extra/shadow.h b/ui/compositor_extra/shadow.h
index 9d32872..aa5c623 100644
--- a/ui/compositor_extra/shadow.h
+++ b/ui/compositor_extra/shadow.h
@@ -76,8 +76,10 @@ class Shadow : public ui::ImplicitAnimationObserver, public ui::LayerOwner {
   // when it gets recreated.
   class ShadowLayerOwner : public ui::LayerOwner {
    public:
-    explicit ShadowLayerOwner(Shadow* owner,
-                              std::unique_ptr<Layer> layer = nullptr);
+    // C++23 fix: Split into two constructors to avoid default parameter
+    // instantiating unique_ptr destructor with incomplete Layer type.
+    explicit ShadowLayerOwner(Shadow* owner);
+    ShadowLayerOwner(Shadow* owner, std::unique_ptr<Layer> layer);

     ShadowLayerOwner(const ShadowLayerOwner&) = delete;
     ShadowLayerOwner& operator=(const ShadowLayerOwner&) = delete;
