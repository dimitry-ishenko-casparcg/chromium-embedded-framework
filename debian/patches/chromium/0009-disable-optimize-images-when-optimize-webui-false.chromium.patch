Description: Conditionally enable optimize_images based on optimize_webui flag
 When optimize_webui=false (Debian policy), the optimize_images target should
 not execute, avoiding WASM/rollup dependencies. This patch wraps optimize_images
 in an if(optimize_webui) condition and provides a stub action target when disabled
 that declares the same outputs as optimize_images but without optimization.
 .
 This prevents the build from requiring node_modules/@rollup/wasm-node WASM files
 when optimize_webui=false is set in GN_DEFINES, while maintaining compatibility
 with targets that depend on optimize_images outputs.
Author: Debian CEF Maintainers
Forwarded: not-needed
Last-Update: 2025-11-06

diff --git a/third_party/devtools-frontend/src/front_end/Images/BUILD.gn b/third_party/devtools-frontend/src/front_end/Images/BUILD.gn
index a651eb7..94062b4 100644
--- a/third_party/devtools-frontend/src/front_end/Images/BUILD.gn
+++ b/third_party/devtools-frontend/src/front_end/Images/BUILD.gn
@@ -3,6 +3,7 @@
 # found in the LICENSE file.
 
 import("//build/timestamp.gni")
+import("//ui/webui/resources/tools/build_webui.gni")
 import("../../config/gni/devtools_image_files.gni")
 import("../../scripts/build/ninja/devtools_pre_built.gni")
 import("../../scripts/build/ninja/node.gni")
@@ -27,6 +28,9 @@ node_action("generate_css_vars") {
   ]
 }
 
+# Only optimize images if optimize_webui is enabled (Debian uses optimize_webui=false)
+# When disabled, create a stub action that declares outputs without optimization
+if (optimize_webui) {
 node_action("optimize_images") {
   script = "node_modules/@rollup/wasm-node/dist/bin/rollup"
 
@@ -73,3 +77,47 @@ node_action("optimize_images") {
     }
   }
 }
+} else {
+  # Stub action when optimize_webui=false - declares same outputs as optimize_images
+  # but without optimization. Copy Images.prebundle.js to Images.js.
+  # The SVG files are generated by generate_css_vars, so we depend on that target
+  # and declare the SVG outputs so other targets can depend on them.
+  action("optimize_images") {
+    _bundled_entrypoint = target_gen_dir + "/Images.prebundle.js"
+    _output_file_location = target_gen_dir + "/Images.js"
+    
+    public_deps = [
+      ":Images",
+      ":generate_css_vars",
+    ]
+    
+    # Copy Images.prebundle.js to Images.js (no optimization)
+    script = "//build/copy.py"
+    inputs = [ _bundled_entrypoint ]
+    outputs = [ _output_file_location ]
+    args = [
+      rebase_path(_bundled_entrypoint, root_build_dir),
+      rebase_path(_output_file_location, root_build_dir),
+    ]
+    
+    # Declare SVG outputs (they're generated by generate_css_vars dependency)
+    # We need to declare them here so other targets can depend on optimize_images
+    # and get access to the SVG files. The SVG files are already generated by
+    # generate_css_vars in the same target_gen_dir, we just need to declare them
+    # as outputs so GN knows they're available.
+    foreach(svg_image, devtools_svg_sources) {
+      outputs += [ "$target_gen_dir/$svg_image" ]
+    }
+    
+    # Declare metadata with grd_files (same as optimize_images)
+    metadata = {
+      grd_files = [ _output_file_location ]
+      foreach(svg_image, devtools_svg_sources) {
+        grd_files += [ "$target_gen_dir/$svg_image" ]
+      }
+      foreach(_image_file, devtools_image_files) {
+        grd_files += [ "$target_gen_dir/$_image_file" ]
+      }
+    }
+  }
+}
