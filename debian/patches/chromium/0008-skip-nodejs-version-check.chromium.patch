Description: Skip Node.js version check for Debian builds
 Replace node("check_version") target with a no-op action() that creates
 an empty output file. This allows the build to use system Node.js (v20.19.5)
 instead of the bundled version (v22.11.0) without failing the version check.
 .
 The target is kept (not removed) to satisfy GN dependencies from hundreds
 of WebUI and TypeScript build targets.
Author: Juan Manuel Méndez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-01-17

diff --git a/third_party/node/BUILD.gn b/third_party/node/BUILD.gn
index 1741e14..2f2e29b 100644
--- a/third_party/node/BUILD.gn
+++ b/third_party/node/BUILD.gn
@@ -4,22 +4,18 @@

 import("//third_party/node/node.gni")

-node("check_version") {
-  script = "check_version.py"
-
-  expected_version_file = "update_node_binaries"
-  inputs = [
-    expected_version_file,
-    "check_version.js",
-  ]
+# Debian: Skip Node.js version check - system node (v20.19.5) is compatible
+# even though bundled version expects v22.11.0. Create no-op action that
+# satisfies dependencies without running the actual check.
+action("check_version") {
+  script = "//build/gn_run_binary.py"

   out_file = "${target_gen_dir}/check_version_result.txt"
   outputs = [ out_file ]

+  # Use touch to create empty output file
   args = [
-    "--expected_version_file",
-    rebase_path(expected_version_file, root_build_dir),
-    "--out_file",
+    "/usr/bin/touch",
     rebase_path(out_file, root_build_dir),
   ]
 }
