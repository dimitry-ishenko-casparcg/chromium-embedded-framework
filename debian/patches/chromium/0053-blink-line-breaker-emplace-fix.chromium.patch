Description: Fix GCC 15 libstdc++ optional::emplace() error in line_breaker.cc
 GCC 15's libstdc++ std::optional::emplace() requires is_constructible_v<T>
 to be satisfied. TrailingCollapsibleSpace is an aggregate with default member
 initializers, which makes it non-constructible in the traditional sense.
 Use aggregate initialization assignment instead of emplace().
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-30

diff --git a/third_party/blink/renderer/core/layout/inline/line_breaker.cc b/third_party/blink/renderer/core/layout/inline/line_breaker.cc
index bbc44ec..6a81c6f 100644
--- a/third_party/blink/renderer/core/layout/inline/line_breaker.cc
+++ b/third_party/blink/renderer/core/layout/inline/line_breaker.cc
@@ -2742,7 +2742,9 @@ bool LineBreaker::ComputeTrailingCollapsibleSpaceHelper(LineInfo& line_info) {
       if (!trailing_collapsible_space_.has_value() ||
           trailing_collapsible_space_->item_results != results ||
           trailing_collapsible_space_->item_result_index != index) {
-        trailing_collapsible_space_.emplace();
+        // GCC 15 libstdc++: Use aggregate initialization instead of emplace()
+        // for types with default member initializers.
+        trailing_collapsible_space_ = TrailingCollapsibleSpace{};
         trailing_collapsible_space_->item_results = results;
         trailing_collapsible_space_->item_result_index = index;
         if (item_result.EndOffset() - 1 > item_result.StartOffset()) {
