Description: Fix C++23 incomplete type error in ui::LayerOwner
 C++23 with libc++ requires complete type when unique_ptr destructor is
 instantiated. The default parameter `= nullptr` in the constructor declaration
 causes unique_ptr<Layer>::~unique_ptr() to be instantiated in the header
 where Layer is only forward-declared.
 .
 Fix by splitting into two constructors: a default constructor and one
 taking a unique_ptr<Layer>. Both are defined in the .cc file where Layer
 is complete.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-27

diff --git a/ui/compositor/layer_owner.cc b/ui/compositor/layer_owner.cc
index 66968a3..e2690a6 100644
--- a/ui/compositor/layer_owner.cc
+++ b/ui/compositor/layer_owner.cc
@@ -13,6 +13,9 @@

 namespace ui {

+// C++23 fix: Explicit default constructor defined here where Layer is complete.
+LayerOwner::LayerOwner() = default;
+
 LayerOwner::LayerOwner(std::unique_ptr<Layer> layer) {
   if (layer)
     SetLayer(std::move(layer));
diff --git a/ui/compositor/layer_owner.h b/ui/compositor/layer_owner.h
index 2a74e89..73d24f8 100644
--- a/ui/compositor/layer_owner.h
+++ b/ui/compositor/layer_owner.h
@@ -29,7 +29,10 @@ class COMPOSITOR_EXPORT LayerOwner {
     virtual ~Observer() = default;
   };

-  explicit LayerOwner(std::unique_ptr<Layer> layer = nullptr);
+  // C++23 fix: Split into two constructors to avoid default parameter
+  // instantiating unique_ptr destructor with incomplete Layer type.
+  LayerOwner();
+  explicit LayerOwner(std::unique_ptr<Layer> layer);

   LayerOwner(const LayerOwner&) = delete;
   LayerOwner& operator=(const LayerOwner&) = delete;
