Description: Remove Rust nightly-only flags for Debian stable rustc compatibility
 Chromium uses several -Z flags that require nightly rustc. Debian only
 provides stable rustc (1.90.0), so these flags must be removed.
 .
 Removed flags:
 - -Zdep-info-omit-d-target: Ninja dependency file handling (non-critical)
 - -Zmacro-backtrace: Macro debugging (non-critical)
 - -Zremap-cwd-prefix: Path remapping for reproducibility (nice-to-have)
 - -Zexternal-clangrt: Clang runtime (may affect linking, but try without)
 - -Zunstable-options: Required for panic=immediate-abort (remove both)
 - -Zpanic_abort_tests: Panic handling in tests (non-critical)
 - -Zallow-features=: Feature gating (security, but non-blocking)
 - -Zdwarf-version: Debug format (keep DWARF 4 default from clang)
 - -Zsplit-lto-unit: LTO handling (only affects LTO builds)
 .
 Impact: May affect incremental builds, debugging experience, and
 reproducibility, but allows building with Debian stable rustc.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Forwarded: not-needed
Last-Update: 2025-11-10

diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index 078c04943c..c422fd70e5 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -931,8 +931,10 @@ config("compiler") {
         # whole-program-vtables implies -fsplit-lto-unit, and Rust needs to match
         # behaviour. Rust needs to know the linker will be doing LTO in this case
         # or it rejects the Zsplit-lto-unit flag.
+        # Debian: -Zsplit-lto-unit is nightly-only, remove for stable rustc
+        # LTO will still work, just without split units
         rustflags += [
-          "-Zsplit-lto-unit",
+          # "-Zsplit-lto-unit",
           "-Clinker-plugin-lto=yes",
         ]
       } else {
@@ -1125,19 +1127,20 @@ config("compiler") {
     # to compile dylibs on Android, such as for constructing unit test APKs.
     "-Cdefault-linker-libraries",
 
-    # To make Rust .d files compatible with ninja
-    "-Zdep-info-omit-d-target",
-
-    # If a macro panics during compilation, show which macro and where it is
-    # defined.
-    "-Zmacro-backtrace",
-
-    # For deterministic builds, keep the local machine's current working
-    # directory from appearing in build outputs.
-    "-Zremap-cwd-prefix=.",
-
-    # We use clang-rt sanitizer runtimes.
-    "-Zexternal-clangrt",
+    # Debian: Removed nightly-only -Z flags for stable rustc compatibility
+    # These are non-critical optimizations/debugging aids:
+    #
+    # -Zdep-info-omit-d-target: Makes Rust .d files compatible with ninja
+    #   Impact: May affect incremental build dependency tracking
+    #
+    # -Zmacro-backtrace: Shows macro panic locations during compilation
+    #   Impact: Slightly less helpful error messages
+    #
+    # -Zremap-cwd-prefix=.: Removes CWD from build outputs
+    #   Impact: Build outputs may contain absolute paths (reproducibility)
+    #
+    # -Zexternal-clangrt: Uses clang-rt sanitizer runtimes
+    #   Impact: May affect sanitizer support, testing needed
   ]
 
   if (!is_win || force_rustc_color_output) {
@@ -1173,14 +1176,16 @@ config("compiler") {
     # TODO(crbug.com/447558108): Use immediate-abort in AOSP once stabilized.
     if (is_official_build && !is_cronet_for_aosp_build) {
       rustflags += [
-        "-Zunstable-options",
-        "-Cpanic=immediate-abort",
-        "-Zpanic_abort_tests",
+        # Debian: -Cpanic=immediate-abort requires -Zunstable-options (nightly)
+        # Fall back to stable -Cpanic=abort
+        "-Cpanic=abort",
       ]
     } else {
+      # Debian: Removed -Zpanic_abort_tests (nightly-only)
+      # Tests will use standard panic=abort behavior
+      # Impact: Slightly different test panic handling
       rustflags += [
         "-Cpanic=abort",
-        "-Zpanic_abort_tests",
       ]
     }
   }
@@ -1205,7 +1210,10 @@ config("compiler") {
 # Don't allow unstable features to be enabled by `#![feature()]` without
 # additional command line flags.
 config("disallow_unstable_features") {
-  rustflags = [ "-Zallow-features=" ]
+  # Debian: -Zallow-features= is nightly-only
+  # Stable rustc doesn't allow unstable features by default anyway
+  # Impact: Relies on stable rustc's built-in feature gating
+  rustflags = []
 }
 
 config("libcxx_hardening") {
@@ -3074,7 +3082,9 @@ config("symbols") {
     if (current_os != "aix" && current_os != "zos") {
       if (use_dwarf5) {
         cflags += [ "-gdwarf-5" ]
-        rustflags += [ "-Zdwarf-version=5" ]
+        # Debian: -Zdwarf-version is nightly-only
+        # Rustc will use clang's default DWARF 4
+        # rustflags += [ "-Zdwarf-version=5" ]
       } else {
         # Recent clang versions default to DWARF5 on Linux, and Android is about
         # to switch. TODO: Adopt that in controlled way. For now, keep DWARF4.
@@ -3086,7 +3096,9 @@ config("symbols") {
 
         # On Apple, rustc defaults to DWARF2 so it needs to be told how to
         # match clang.
-        rustflags += [ "-Zdwarf-version=4" ]
+        # Debian: -Zdwarf-version is nightly-only
+        # Rustc will use default DWARF format
+        # rustflags += [ "-Zdwarf-version=4" ]
       }
     }
 
@@ -3221,18 +3233,21 @@ config("minimal_symbols") {
       # at least 10.11.
       # TODO(thakis): Remove this once mac_deployment_target is 10.11.
       cflags += [ "-gdwarf-4" ]
-      rustflags += [ "-Zdwarf-version=4" ]
+      # Debian: -Zdwarf-version is nightly-only
+      # rustflags += [ "-Zdwarf-version=4" ]
     } else if (!use_dwarf5 && current_os != "aix") {
       # On aix -gdwarf causes linker failures due to thread_local variables.
       # Recent clang versions default to DWARF5 on Linux, and Android is about
       # to switch. TODO: Adopt that in controlled way.
       cflags += [ "-gdwarf-4" ]
-      rustflags += [ "-Zdwarf-version=4" ]
+      # Debian: -Zdwarf-version is nightly-only
+      # rustflags += [ "-Zdwarf-version=4" ]
     }
 
     if (use_dwarf5) {
       cflags += [ "-gdwarf-5" ]
-      rustflags += [ "-Zdwarf-version=5" ]
+      # Debian: -Zdwarf-version is nightly-only
+      # rustflags += [ "-Zdwarf-version=5" ]
     }
 
     cflags += [ "-g1" ]
