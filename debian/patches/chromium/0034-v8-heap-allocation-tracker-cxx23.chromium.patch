+// Heap::AllocationTrackerForDebugging moved before Heap::Heap() for C++23
+// compatibility (complete type required for std::unique_ptr destructor).

 void Heap::AddHeapObjectAllocationTracker(
     HeapObjectAllocationTracker* tracker) {
