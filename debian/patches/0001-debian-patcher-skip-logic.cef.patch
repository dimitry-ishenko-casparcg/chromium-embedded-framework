Description: Add skip logic for patches that fail but are safe to skip on Debian
 Some CEF patches are unnecessary or conflict with Debian builds:
 - gn_config: Debian strips Windows-specific files
 - libxml_visibility: Debian unbundles libraries to use system versions
 - chrome_browser_browser: Conflicts with Debian's chromium UI patches
 - chrome_browser_profile_menu: Version mismatch with Debian chromium
 - v8_build: V8 build configuration conflicts with Debian's V8 patches
 - angle_commit_config: ANGLE graphics library config conflicts
 - linux_assets_path_1936: Superseded by Debian patch 0036-angle-libs-cef-subdir
 These patches fail but are safe to skip for Debian builds.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Forwarded: not-needed
Last-Update: 2025-12-21

diff --git a/cef/tools/patcher.py b/cef/tools/patcher.py
index 9877ad7..5b0d899 100644
--- a/cef/tools/patcher.py
+++ b/cef/tools/patcher.py
@@ -47,6 +47,25 @@ def apply_patch_file(patch_file, patch_dir):

   result = git_apply_patch_file(patch_path, patch_dir)
   if result == 'fail':
+    # Debian-specific: Some patches are unnecessary or conflict with Debian builds:
+    # - gn_config: Debian strips Windows-specific files (chrome/installer/mini_installer/*)
+    # - libxml_visibility: Debian unbundles libraries to use system versions (libxml)
+    # - chrome_browser_browser: Conflicts with Debian's chromium UI patches
+    # - chrome_browser_profile_menu: Same version mismatch issue as tarball_deps
+    # - v8_build: V8 build configuration conflicts with Debian's V8 patches
+    # - angle_commit_config: ANGLE graphics library config conflicts with Debian patches
+    # - linux_assets_path_1936: Superseded by Debian patch 0036-angle-libs-cef-subdir.chromium.patch
+    #   which includes the same DIR_EXE/DIR_MODULE->DIR_ASSETS changes plus cef/ subdirectory for ANGLE
+    # These patches fail but are safe to skip for Debian builds.
+    # Note: tarball_deps and tarball_gclient now have Debian-specific versions (patches 0007-0008)
+    debian_skip_patches = ['gn_config', 'libxml_visibility', 'chrome_browser_browser',
+                            'chrome_browser_profile_menu', 'v8_build', 'angle_commit_config',
+                            'tarball_deps', 'tarball_gclient', 'linux_assets_path_1936']
+    patch_base = os.path.splitext(patch_file)[0]  # Remove .patch extension
+    # Skip these patches unconditionally for Debian builds (incompatible with Debian chromium)
+    if patch_base in debian_skip_patches:
+      sys.stdout.write('\n... Debian build: treating as skip (incompatible with Debian chromium).\n')
+      return 'skip'
     write_note('ERROR',
                'This patch failed to apply. Your build will not be correct.')
   return result
