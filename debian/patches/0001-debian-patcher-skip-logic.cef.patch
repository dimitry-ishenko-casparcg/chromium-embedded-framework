Description: Skip all CEF patches when DEBIAN_BUILD=1 (pre-applied in debian/rules)
 Debian builds apply CEF patches to vanilla Chromium in debian/rules Step 5.3
 (before Debian Chromium patches in Step 5.5). When automate-git.py later calls
 patcher.py during gclient runhooks, all patches are already applied.
 .
 This avoids conflicts between CEF patches (designed for vanilla Chromium) and
 Debian Chromium patches that modify the same files.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-02-15

diff --git a/cef/tools/patcher.py b/cef/tools/patcher.py
index 6797052..268f4c3 100644
--- a/cef/tools/patcher.py
+++ b/cef/tools/patcher.py
@@ -31,6 +31,12 @@ def write_note(type, note):

 def apply_patch_file(patch_file, patch_dir):
   ''' Apply a specific patch file in optional patch directory. '''
+  # Debian builds: All CEF patches are pre-applied in debian/rules Step 5.3
+  # (before Debian Chromium patches). Skip everything here to avoid conflicts.
+  if os.environ.get('DEBIAN_BUILD') == '1':
+    sys.stdout.write('\nSkipping %s.patch (Debian: pre-applied in debian/rules)\n' % patch_file)
+    return 'skip'
+
   patch_name = patch_file + '.patch'
   patch_path = os.path.join(cef_patch_dir, 'patches', patch_name)

