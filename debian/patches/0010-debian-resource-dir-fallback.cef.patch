Description: Fallback to /usr/share/cef for CEF resource files on Debian
 CEF resolves resource paths (icudtl.dat, PAK files, locales) relative to
 libcef.so via DIR_ASSETS, which points to /usr/lib/<multiarch>/ on Debian.
 Debian policy requires arch-independent data in /usr/share/, so resources
 are installed to /usr/share/cef/ by libcef-common.
 .
 This patch modifies OverrideAssetPath() to check whether icudtl.dat exists
 next to libcef.so; if not, it falls back to /usr/share/cef/ before setting
 DIR_ASSETS. This is critical because base/i18n/icu_util.cc reads DIR_ASSETS
 (not chrome::DIR_RESOURCES) to locate icudtl.dat for both the browser
 process and child processes. Without this, CEF crashes with "Invalid file
 descriptor to ICU data received".
Author: Juan Manuel Mendez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-04-26

diff --git a/cef/libcef/common/resource_util.cc b/cef/libcef/common/resource_util.cc
index 22e6672..c05c7cc 100644
--- a/cef/libcef/common/resource_util.cc
+++ b/cef/libcef/common/resource_util.cc
@@ -6,6 +6,7 @@

 #if BUILDFLAG(IS_LINUX)
 #include <dlfcn.h>
+#include "base/files/file_util.h"
 #endif

 #include "base/base_paths.h"
@@ -145,6 +146,17 @@ void OverrideAssetPath() {
   Dl_info dl_info;
   if (dladdr(reinterpret_cast<const void*>(&OverrideAssetPath), &dl_info)) {
     base::FilePath path = base::FilePath(dl_info.dli_fname).DirName();
+    // Debian: resources (icudtl.dat, PAK files, locales) are installed to
+    // /usr/share/cef/ (FHS-compliant), not next to libcef.so in /usr/lib/.
+    // DIR_ASSETS is used by base/i18n/icu_util.cc to find icudtl.dat, so it
+    // must point to the directory containing the actual resource files.
+    if (!base::PathExists(path.Append(FILE_PATH_LITERAL("icudtl.dat")))) {
+      const base::FilePath debian_dir(FILE_PATH_LITERAL("/usr/share/cef"));
+      if (base::PathExists(
+              debian_dir.Append(FILE_PATH_LITERAL("icudtl.dat")))) {
+        path = debian_dir;
+      }
+    }
     base::PathService::Override(base::DIR_ASSETS, path);
   }
 }
