Description: Add GetDebianArgs() function for system libc++ support
 Adds GetDebianArgs() function to gn_args.py which injects unbundle toolchain
 selection for Debian builds. This enables the use of system libc++ by allowing
 CXXFLAGS and LDFLAGS from debian/rules to reach the compiler.
 .
 The unbundle toolchain at //build/toolchain/linux/unbundle:default reads
 environment variables via getenv(), making -stdlib=libc++ flags from
 debian/rules effective during compilation.
 .
 This completes Debian Chromium's three-component strategy for system libc++:
  1. Stub BUILD.gn for bundled libc++ (patch 0022)
  2. use_custom_libcxx=false (set in tarball_args.gn)
  3. Unbundle toolchain selection (this patch)
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-18

diff --git a/tools/gn_args.py b/tools/gn_args.py
index 5cec1ab..4f02bb9 100644
--- a/tools/gn_args.py
+++ b/tools/gn_args.py
@@ -348,6 +348,31 @@ def GetGNEnvArgs():
   return ParseNameValueList(ShlexEnv('GN_DEFINES'))


+def GetDebianArgs():
+  """
+  Return GN args for Debian builds with system libc++.
+
+  Debian builds use the unbundle toolchain which reads CXXFLAGS and LDFLAGS
+  from environment variables via getenv(). This enables -stdlib=libc++ flags
+  (set in debian/rules) to reach the compiler, allowing system libc++ to be
+  used instead of Chromium's bundled libc++.
+
+  This approach follows Debian Chromium's strategy:
+  1. Stub BUILD.gn for bundled libc++ (patch 0022)
+  2. use_custom_libcxx=false (already set in tarball_args.gn)
+  3. Unbundle toolchain selection (this function)
+  """
+  result = {}
+
+  if os.environ.get('DEBIAN_BUILD') == '1':
+    # Use unbundle toolchain to read CXXFLAGS/LDFLAGS from environment
+    # This enables -stdlib=libc++ flags to reach the compiler
+    result['custom_toolchain'] = '//build/toolchain/linux/unbundle:default'
+    result['host_toolchain'] = '//build/toolchain/linux/unbundle:default'
+
+  return result
+
+
 def GetRequiredArgs():
   """
   Return required GN args. Also enforced by assert() in //cef/BUILD.gn.
@@ -385,7 +410,7 @@ def GetMergedArgs(build_args):
   """
   Return merged GN args.
   """
-  dict = MergeDicts(GetRecommendedDefaultArgs(), GetGNEnvArgs(), build_args)
+  dict = MergeDicts(GetRecommendedDefaultArgs(), GetGNEnvArgs(), GetDebianArgs(), build_args)

   # Verify that the user is not trying to override required args.
   required = GetRequiredArgs()
