Description: Add GetDebianArgs() function for Debian build configuration
 Adds GetDebianArgs() function to gn_args.py which configures GN args for
 Debian builds. This enables system libc++ support and disables incompatible
 SwiftShader subzero backend while using LLVM backend.
 .
 System libc++ support: Uses unbundle toolchain which reads CXXFLAGS/LDFLAGS
 from environment via getenv(), making -stdlib=libc++ flags from debian/rules
 effective during compilation.
 .
 SwiftShader: Disable subzero backend, enable LLVM backend like Debian Chromium.
 The LLVM-16 bundled with Chromium handles C++23 APFloat correctly.
 Overrides supports_subzero from reactor.gni
Author: Juan Manuel Méndez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-18

diff --git a/cef/tools/gn_args.py b/cef/tools/gn_args.py
index 5cec1ab..9b84916 100644
--- a/cef/tools/gn_args.py
+++ b/cef/tools/gn_args.py
@@ -348,6 +348,35 @@ def GetGNEnvArgs():
   return ParseNameValueList(ShlexEnv('GN_DEFINES'))


+def GetDebianArgs():
+  """
+  Return GN args for Debian builds with system libc++ and compatible backends.
+
+  System libc++ support:
+  - Uses unbundle toolchain which reads CXXFLAGS/LDFLAGS from environment
+  - Enables -stdlib=libc++ flags (set in debian/rules) to reach compiler
+
+  SwiftShader LLVM backend:
+  - Disable subzero backend, use LLVM backend like Debian Chromium
+  - The bundled LLVM-16.0 handles C++23 APFloat correctly
+  - Overrides supports_subzero from reactor.gni
+  """
+  result = {}
+
+  if os.environ.get('DEBIAN_BUILD') == '1':
+    # Use unbundle toolchain to read CXXFLAGS/LDFLAGS from environment
+    # This enables -stdlib=libc++ flags to reach the compiler
+    result['custom_toolchain'] = '//build/toolchain/linux/unbundle:default'
+    result['host_toolchain'] = '//build/toolchain/linux/unbundle:default'
+
+    # Disable subzero backend, use LLVM backend (like Debian Chromium)
+    # Override architecture-based defaults from reactor.gni
+    result['supports_subzero'] = False
+    # supports_llvm defaults to True for Linux, use bundled LLVM-16.0
+
+  return result
+
+
 def GetRequiredArgs():
   """
   Return required GN args. Also enforced by assert() in //cef/BUILD.gn.
@@ -385,7 +414,7 @@ def GetMergedArgs(build_args):
   """
   Return merged GN args.
   """
-  dict = MergeDicts(GetRecommendedDefaultArgs(), GetGNEnvArgs(), build_args)
+  dict = MergeDicts(GetRecommendedDefaultArgs(), GetGNEnvArgs(), GetDebianArgs(), build_args)

   # Verify that the user is not trying to override required args.
   required = GetRequiredArgs()
