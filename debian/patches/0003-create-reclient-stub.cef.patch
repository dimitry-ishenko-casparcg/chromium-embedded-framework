Description: Create stub for reclient_cfgs and remove catapult dependency
 Creates a stub for reclient_cfgs/configure_reclient_cfgs.py which is
 missing from Debian's chromium tarball. Also removes the catapult/telemetry
 dependency from BUILD.gn since Debian unbundles this development tool.
Author: Juan Manuel Mendez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-12-29

diff --git a/tools/automate/automate-git.py b/tools/automate/automate-git.py
index 9f2f932..c107d75 100644
--- a/tools/automate/automate-git.py
+++ b/tools/automate/automate-git.py
@@ -1584,6 +1584,29 @@ if chromium_checkout_changed:
   # Patch the Chromium runhooks scripts if necessary.
   apply_runhooks_patch()
 
+##
+## Create stub for reclient_cfgs (missing from Debian chromium tarball)
+##
+
+reclient_stub = os.path.join(chromium_src_dir, 'buildtools', 'reclient_cfgs', 'configure_reclient_cfgs.py')
+os.makedirs(os.path.dirname(reclient_stub), exist_ok=True)
+with open(reclient_stub, 'w') as f:
+  f.write('#!/usr/bin/env python3\n# Stub for Debian builds\nimport sys\nsys.exit(0)\n')
+
+##
+## Patch chromium BUILD.gn to remove catapult/telemetry dependency
+## (Debian unbundled this development tool not needed for CEF)
+##
+
+build_gn = os.path.join(chromium_src_dir, 'BUILD.gn')
+with open(build_gn, 'r') as f:
+  content = f.read()
+content = content.replace(
+  '"//third_party/catapult/telemetry:bitmaptools($host_toolchain)",',
+  '# Debian: catapult/telemetry unbundled\n        # "//third_party/catapult/telemetry:bitmaptools($host_toolchain)",')
+with open(build_gn, 'w') as f:
+  f.write(content)
+
   # Runs hooks for files that have been modified in the local working copy.
   run("gclient runhooks", chromium_dir)
 
