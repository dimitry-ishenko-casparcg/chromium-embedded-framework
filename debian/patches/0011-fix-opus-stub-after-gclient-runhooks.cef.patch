Description: Fix opus stub BUILD.gn and create libXNVCtrl symlink after gclient runhooks
 Modifies automate-git.py to inject include_dirs into the empty opus_config
 created by debian/rules, and creates symlink for system libxnvctrl-dev header.
 .
 The debian/rules creates an opus stub with an empty config("opus_config") {}
 with no include_dirs, preventing FFmpeg from finding opus headers. This patch
 adds include_dirs to the config so dependent targets can access system headers.
 .
 Also creates symlink from third_party/libXNVCtrl/NVCtrl.h to system header
 /usr/include/NVCtrl/NVCtrl.h for ANGLE GPU info utility compilation.
 .
 This is executed only when DEBIAN_BUILD=1 environment variable is set, ensuring
 it doesn't affect upstream or non-Debian builds.
Author: Juan Manuel Méndez Rey <vejeta@gmail.com>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-11-23

diff --git a/cef/tools/automate/automate-git.py b/cef/tools/automate/automate-git.py
index b6c0b3f..c3e8a4a 100644
--- a/cef/tools/automate/automate-git.py
+++ b/cef/tools/automate/automate-git.py
@@ -1689,6 +1689,38 @@ apply_runhooks_patch()
 # Runs hooks for files that have been modified in the local working copy.
 run("gclient runhooks", chromium_dir)

+# Debian: Fix opus stub BUILD.gn after gclient runhooks
+if os.environ.get('DEBIAN_BUILD') == '1':
+  msg('Debian: Fixing opus stub BUILD.gn to add include_dirs for system libopus headers')
+  opus_build_file = os.path.join(chromium_src_dir, 'third_party', 'opus', 'BUILD.gn')
+  if os.path.exists(opus_build_file):
+    with open(opus_build_file, 'r') as f:
+      content = f.read()
+    # Add include_dirs to opus_config so FFmpeg can find opus headers
+    if 'include_dirs = [ "/usr/include/opus" ]' not in content:
+      content = content.replace(
+        'config("opus_config") {}',
+        'config("opus_config") {\n  include_dirs = [ "/usr/include/opus" ]\n}'
+      )
+      with open(opus_build_file, 'w') as f:
+        f.write(content)
+      msg('Debian: Fixed opus stub BUILD.gn to add include_dirs for system libopus headers')
+
+# Debian: Create libXNVCtrl symlinks for system libxnvctrl-dev
+# Location matches -I../../third_party/angle/src include path
+if os.environ.get('DEBIAN_BUILD') == '1':
+  msg('Debian: Creating libXNVCtrl symlinks to system headers')
+  nvctrl_dir = os.path.join(chromium_src_dir, 'third_party', 'angle', 'src', 'third_party', 'libXNVCtrl')
+  os.makedirs(nvctrl_dir, exist_ok=True)
+  for header in ['NVCtrl.h', 'NVCtrlLib.h']:
+    src = '/usr/include/NVCtrl/' + header
+    dst = os.path.join(nvctrl_dir, header)
+    if os.path.exists(src):
+      if os.path.exists(dst):
+        os.remove(dst)
+      os.symlink(src, dst)
+      msg('Debian: Created symlink %s -> %s' % (dst, src))
+
 if cef_dir == cef_src_dir:
   # Running in fast update mode.
   if cef_checkout_changed or chromium_checkout_changed:
