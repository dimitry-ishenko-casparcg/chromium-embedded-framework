Description: Allow optimize_webui=false for Debian builds
 Removes optimize_webui from CEF's required GN arguments to align with
 Debian Chromium policy. Debian uses optimize_webui=false because it
 requires specific Node.js tooling that differs from Chromium's bundled
 version. This allows CEF to build with Debian's configuration.
Author: Juan Manuel Mendez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2025-12-29

diff --git a/cef/tools/gn_args.py b/cef/tools/gn_args.py
index 56c83bb..5cec1ab 100644
--- a/cef/tools/gn_args.py
+++ b/cef/tools/gn_args.py
@@ -353,7 +353,9 @@ def GetRequiredArgs():
   Return required GN args. Also enforced by assert() in //cef/BUILD.gn.
   """
   result = {
-      'optimize_webui': True,
+      # Note: optimize_webui removed from required args to align with Debian
+      # chromium policy (which uses optimize_webui=false). This allows Debian
+      # builds to use optimize_webui=false while maintaining CEF compatibility.
       # Enable support for Widevine CDM.
       'enable_widevine': True,
 
