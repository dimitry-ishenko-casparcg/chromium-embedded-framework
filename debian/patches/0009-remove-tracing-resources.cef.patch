Description: Remove content/browser/tracing references for Chromium 145
 Chromium 145 removed the content/browser/tracing/BUILD.gn and its
 tracing_resources target entirely. CEF's BUILD.gn still referenced both
 the generated header and the GN dependency, causing gn gen to fail.
Author: Juan Manuel Méndez Rey <juan.mendezr@proton.me>
Bug-Debian: https://bugs.debian.org/915400
Forwarded: not-needed
Last-Update: 2026-02-15

diff --git a/cef/BUILD.gn b/cef/BUILD.gn
index 05671d1..0913450 100644
--- a/cef/BUILD.gn
+++ b/cef/BUILD.gn
@@ -1460,7 +1460,6 @@ make_pack_header("resources") {
     "$root_gen_dir/components/grit/components_resources.h",
     "$root_gen_dir/components/grit/dev_ui_components_resources.h",
     "$root_gen_dir/content/browser/devtools/grit/devtools_resources.h",
-    "$root_gen_dir/content/browser/tracing/grit/tracing_resources.h",
     "$root_gen_dir/content/browser/webrtc/resources/grit/webrtc_internals_resources.h",
     "$root_gen_dir/content/grit/content_resources.h",
     "$root_gen_dir/content/grit/gpu_resources.h",
@@ -1491,7 +1490,6 @@ make_pack_header("resources") {
     "//components/resources:dev_ui_components_resources",
     "//content/browser/devtools:devtools_resources",
     "//content/browser/resources",
-    "//content/browser/tracing:resources",
     "//content/browser/webrtc/resources",
     "//content:content_resources",
     "//extensions:extensions_browser_resources",
