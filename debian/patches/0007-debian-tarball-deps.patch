Description: Add source_tarball conditions to chromium DEPS for tarball builds
 This patch adds 'condition': 'not source_tarball' to prevent git operations
 when building from Debian-provided chromium tarball sources.
 .
 Modified sections:
 - Five hooks (lastchange, gpu_lists_version, lastchange_skia, lastchange_dawn, lastchange_commit_position_cros)
 - Four dependency entries (webvr_info, crossbench, crossbench-web-tests, dom_distiller_js, crabbyavif)
 .
 This eliminates all git fetch/clone operations during Phase 2a build,
 ensuring compliance with Debian's no-internet build policy.
 .
 Regenerated for Debian chromium 142.0.7444.59 (CEF's original patch was for .53)
Author: Debian CEF Maintainers
Forwarded: not-needed
Last-Update: 2025-11-05

--- a/chromium/src/DEPS
+++ b/chromium/src/DEPS
@@ -4198,6 +4198,7 @@ hooks = [
   {
     # Update LASTCHANGE.
     'name': 'lastchange',
     'pattern': '.',
+    'condition': 'not source_tarball',
     'action': ['python3', 'src/build/util/lastchange.py',
                '-o', 'src/build/util/LASTCHANGE'],
   },
@@ -4205,7 +4206,7 @@ hooks = [
     # Update lastchange_commit_position.h (only for CrOS).
     'name': 'lastchange_commit_position_cros',
     'pattern': '.',
-    'condition': 'checkout_chromeos',
+    'condition': 'checkout_chromeos and not source_tarball',
     'action': ['python3', 'src/build/util/lastchange.py',
                '-m', 'CHROMIUM',
