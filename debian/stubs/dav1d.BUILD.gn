# Stub BUILD.gn for Debian builds - uses system dav1d
# Links to system libdav1d via libs = [ "dav1d" ]

source_set("dav1d") {
  sources = []
  public_configs = [ ":dav1d_config" ]
  libs = [ "dav1d" ]
}
config("dav1d_config") {
  include_dirs = [ "/usr/include/dav1d" ]
}
group("dav1d_headers") {
  public_configs = [ ":dav1d_config" ]
}
