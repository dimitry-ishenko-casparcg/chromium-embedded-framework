# === Rust Component (interim bundled dependency) ===
Files: rust/*
Copyright: The Rust Project Developers
License: Apache-2.0 or MIT
Comment: Bundled Rust standard library source. Required because Debian rust-src
 1.90.0 is missing files that Chromium's build system expects
 (sync/nonpoison/condvar.rs, rwlock.rs). This component can be removed when
 Debian rust-src provides these files.

# Rust vendored crates: Windows API bindings
Files: rust/lib/rustlib/src/rust/library/vendor/windows-targets-*/*
       rust/lib/rustlib/src/rust/library/vendor/windows_*/*
Copyright: Microsoft Corporation
License: Apache-2.0 or MIT

# Rust vendored crates: Core utilities by Alex Crichton
Files: rust/lib/rustlib/src/rust/library/vendor/cfg-if-*/*
       rust/lib/rustlib/src/rust/library/vendor/cc-*/*
       rust/lib/rustlib/src/rust/library/vendor/dlmalloc-*/*
       rust/lib/rustlib/src/rust/library/vendor/rustc-demangle-*/*
       rust/lib/rustlib/src/rust/library/backtrace/*
Copyright: 2014 Alex Crichton
License: Apache-2.0 or MIT

# Rust vendored crates: memchr (fast byte searching)
