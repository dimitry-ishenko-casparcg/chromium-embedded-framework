	## Why: In incremental builds, .gn may already exist and need patching
	## Fix: Add //cef/BUILD.gn to exec_script_allowlist (not exec_script_whitelist)
	## This matches CEF's gn_config.patch
	@echo "==> Pre-patching .gn file if it exists"
	if [ -f $(CURDIR)/chromium_src/chromium/src/.gn ]; then \
		if ! grep -q '"//cef/BUILD.gn"' $(CURDIR)/chromium_src/chromium/src/.gn; then \
			sed -i '/"\/\/build_overrides\/build.gni",/a\      "//cef/BUILD.gn",' $(CURDIR)/chromium_src/chromium/src/.gn; \
		fi; \
	fi

	## Step 7c: Create symlinks from system clang-19 to bundled LLVM location
	## Why: Chromium expects compiler-rt libraries at third_party/llvm-build/Release+Asserts/
	## But Debian clang-19 provides them at /usr/lib/llvm-19/lib/clang/19/lib/linux/
	## Path mapping:
	##   Chromium expects: third_party/llvm-build/Release+Asserts/lib/clang/19/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a
	##   Debian provides: /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.builtins-x86_64.a
	@echo "==> Creating symlinks from system clang-19 to bundled LLVM location"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/x86_64-unknown-linux-gnu
	# Symlink compiler-rt builtins library (primary dependency for Rust builds)
	ln -sf /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.builtins-x86_64.a \
		$(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a
	# Symlink all other compiler-rt libraries (for completeness)
	for lib in /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.*-x86_64.a; do \
		base=$$(basename $$lib); \
		target=$$(echo $$base | sed 's/-x86_64\.a$$/.a/'); \
		ln -sf $$lib $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/x86_64-unknown-linux-gnu/$$target; \
	done
	# Symlink i386 libraries (in case needed for 32-bit targets)
	for lib in /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.*-i386.a; do \
		base=$$(basename $$lib); \
		target=$$(echo $$base | sed 's/-i386\.a$$/.a/'); \
		ln -sf $$lib $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/x86_64-unknown-linux-gnu/$$target; \
	done
	@echo "==> LLVM symlinks created successfully"
	# libclang discovery is handled by patch 0019-bindgen-libclang-abspath.chromium.patch
	# which converts relative paths to absolute paths in run_bindgen.py

	## Step 7d: Symlink system Node.js to expected location
	## Why: Chromium expects Node.js at third_party/node/linux/node-linux-x64/bin/node
	## But Debian uses system Node.js from nodejs package (/usr/bin/node)
	## Solution: Create directory structure and symlink system node binary
	@echo "==> Symlinking system Node.js"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-x64/bin
	ln -sf /usr/bin/node $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-x64/bin/node
	@echo "==> Node.js symlink created successfully"

	## Step 7e: Extract complete Rust std library from rust-toolchain tarball
	## Why: Chromium requires NEWER Rust std library than Debian 1.90.0 provides
	## Debian's rust-src (1.90.0) is missing files like:
	##   - sync/nonpoison/condvar.rs, rwlock.rs (newer std library features)
	##   - cross-platform files (cygwin/net.rs, darwin/objc.rs - these we'll stub)
	## Solution: Extract COMPLETE std library from rust-toolchain.tar.xz (bundled dependency)
	## This tarball contains the exact Rust version Chromium expects (matches DEPS)
	@echo "==> Extracting complete Rust std library from rust-toolchain tarball"
	@if [ ! -f $(CURDIR)/../rust-toolchain.tar.xz ]; then \
		echo "❌ ERROR: rust-toolchain.tar.xz not found"; \
		echo "Expected location: $(CURDIR)/../rust-toolchain.tar.xz"; \
		exit 1; \
	fi
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/
	# Extract ONLY the library/ directory from rust-toolchain tarball
	# This contains ALL std library crates (alloc, core, std, etc.) at correct versions
	tar -xf $(CURDIR)/../rust-toolchain.tar.xz \
		-C $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/ \
		--strip-components=4 \
		lib/rustlib/src/rust/library
	@echo "==> Complete Rust std library extracted from rust-toolchain tarball"
	@# Verify critical files exist (condvar.rs was missing in Debian 1.90.0)
	@if [ -f $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/sync/nonpoison/condvar.rs ]; then \
		echo "✅ Verified: condvar.rs exists (was missing in Debian rust-src 1.90.0)"; \
	else \
		echo "❌ ERROR: condvar.rs still missing after extraction"; \
		exit 1; \
	fi
	@echo "==> Creating symlink to system rustc in third_party/rust-toolchain/bin/"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin
	ln -sf /usr/bin/rustc $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/rustc
	# Node.js version check is disabled by patch 0020-skip-nodejs-version-check.chromium.patch
	# System node (v20.19.5) is used directly without symlink

	## Step 7f: Copy bundled Rust std library vendor crates
	## Why: Rust std library needs vendor dependencies to compile (object, libc, gimli, etc.)
	## These ~36 vendor crates are bundled in debian/vendor-crates/vendor/
	## They are NOT in Debian packages yet (RFP bugs filed - see bugs/ directory)
	## Copy them to third_party/rust-toolchain/lib/rustlib/src/rust/library/vendor/
	## DISABLED: vendor-crates directory doesn't exist in current source tree
	@echo "==> Skipping bundled Rust std library vendor crates (not present in source)"
	# mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/vendor
	# cp -r $(CURDIR)/debian/vendor-crates/vendor/* \
	# 	$(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/vendor/
	# @vendor_count=$$(ls -1 $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/vendor/ | wc -l); \
	# echo "📦 Copied $$vendor_count vendor crates for Rust std library compilation"; \
	# if [ $$vendor_count -ge 30 ]; then \
	# 	echo "✅ Vendor crates copied successfully"; \
	# else \
	# 	echo "❌ ERROR: Expected ~36 vendor crates, found $$vendor_count"; \
	# 	exit 1; \
	# fi

	## Step 7f.1: Create stubs for missing platform-specific files
	## Why: Debian's rust-src only contains Linux sources, but Rust std lib references
	## cross-platform files (cygwin/net.rs, darwin/objc.rs, etc.) that don't exist in /usr/src/rustc-*/
	## Solution: Create minimal stub files that re-export Unix functionality
	## Note: These stubs are NEVER used (Debian only builds for Linux), but must exist
	## for Rust compiler's module resolution during std lib compilation
	@echo "==> Creating stubs for missing cross-platform os files (Windows, macOS, Cygwin)"
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/cygwin
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/darwin
	@printf '%s\n' \
		'//! Cygwin-specific networking functionality (stub for Debian builds).' \
		'//! Cygwin is a POSIX compatibility layer for Windows.' \
		'//! This file is NOT used in Debian builds (Linux-only), but must exist' \
		'//! for Rust compiler module resolution during std library compilation.' \
		'' \
		'// Re-export Unix networking (Cygwin is POSIX-compatible)' \
		'pub use crate::os::unix::net::*;' \
		> $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/cygwin/net.rs
	@printf '%s\n' \
		'//! macOS-specific Objective-C functionality (stub for Debian builds).' \
		'//! This file is NOT used in Debian builds (Linux-only), but must exist' \
		'//! for Rust compiler module resolution during std library compilation.' \
		'' \
		'// Empty module - no Objective-C on Linux' \
		> $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/darwin/objc.rs
	@echo "✅ Created stubs: cygwin/net.rs, darwin/objc.rs"

	## Step 7f: Verify Rust vendor crates from Chromium tarball exist
	## Why: Chromium tarball (extracted in Step 5) ALREADY contains all Rust dependencies:
	##   - 145 application crates at third_party/rust/
	##   - 153 vendor crates at third_party/rust/chromium_crates_io/vendor/
	## NO downloads needed - everything from orig.tar.xz (Debian Policy compliant)
	## See: CLAUDE.md Critical Lesson 9 for details
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	@echo "🦀 Verifying Rust crates from Chromium tarball"
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
	@app_crates=$$(ls -1d $(CURDIR)/chromium_src/chromium/src/third_party/rust/*/ 2>/dev/null | wc -l); \
	vendor_crates=$$(ls -1 $(CURDIR)/chromium_src/chromium/src/third_party/rust/chromium_crates_io/vendor/ 2>/dev/null | wc -l); \
	echo "📦 Application crates: $$app_crates (expected: 145)"; \
	echo "📦 Vendor crates: $$vendor_crates (expected: 153)"; \
	echo ""; \
	if [ $$app_crates -ge 140 ] && [ $$vendor_crates -ge 150 ]; then \
		echo "✅ All Rust dependencies available from Chromium tarball"; \
		echo "✅ No downloads needed - Debian Policy compliant"; \
	else \
		echo "❌ ERROR: Missing Rust crates from Chromium tarball!"; \
		echo "   App crates: $$app_crates (need 140+)"; \
		echo "   Vendor crates: $$vendor_crates (need 150+)"; \
		exit 1; \
	fi
	@echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

	## Step 8: Run automate-git.py build script
	## This single command handles: depot_tools download, Chromium sync, GN config, and build
	## The exec_script restriction is handled by patch 0004-patch-gn-for-exec-script.patch
	## which modifies automate-git.py to patch .gn after sync but before running hooks
	##
	## CRITICAL: --no-depot-tools-update flag prevents update_depot_tools from running
	## Without this flag, automate-git.py calls update_depot_tools which does 'git checkout'
	## to upstream HEAD, overwriting our committed patches 0008 and 0015 in depot_tools.
	## This causes gclient to lose the source_tarball check and attempt to clone 37+ dependencies,
	## violating Debian's no-internet build policy.
	cd $(CURDIR)/chromium_src/cef && \
	export DEBIAN_BUILD=1 && \
	export GN_DEFINES="rust_sysroot_absolute=\"$(rust_sysroot)\" rust_bindgen_root=\"/usr\" rustc_version=\"$$($(rust_sysroot)/bin/rustc --version 2>/dev/null)\" clang_base_path=\"/usr/lib/llvm-$(CLANG_MVERS)\" clang_version=\"$(CLANG_MVERS)\" use_custom_libcxx=false use_system_zlib=true use_system_lcms2=true use_system_libjpeg=true use_system_libpng=true use_system_freetype=true use_system_harfbuzz=true use_system_libopenjpeg2=true is_debug=false symbol_level=0 enable_vr=false enable_hangout_services_extension=false build_dawn_tests=false angle_build_tests=false build_angle_perftests=false enable_iterator_debugging=false is_cfi=false chrome_pgo_phase=0 use_sysroot=false treat_warnings_as_errors=false is_official_build=true safe_browsing_use_unrar=false optimize_webui=false use_remoteexec=false use_siso=false use_thin_lto=false enable_cef=true cef_build_tests=false" && \
	export PATH=$(CURDIR)/depot_tools:/usr/lib/llvm-$(CLANG_MVERS)/bin:$$PATH && \
	export LIBCLANG_PATH=/usr/lib/llvm-$(CLANG_MVERS)/lib && \
	python3 tools/automate/automate-git.py \
		--download-dir=$(CURDIR)/chromium_src \
		--depot-tools-dir=$(CURDIR)/depot_tools \
		--branch=$(CEF_BRANCH) \
		--chromium-archive=$(CURDIR)/../chromium_143.0.7499.169.orig.tar.xz \
		--no-cef-update \
		--no-depot-tools-update \
		--force-build \
		--x64-build \
		--no-debug-build \
		--no-distrib-archive \
		--minimal-distrib

override_dh_auto_install:
	# Create package directories first
	mkdir -p $(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu
	mkdir -p $(CURDIR)/debian/libcef-dev/usr/include
	mkdir -p $(CURDIR)/debian/cef-resources/usr/share/cef

	# Install libcef.so (use _linux64 pattern to exclude _linux64_minimal)
	install -m644 chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Release/libcef.so \
		$(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu/libcef.so.138.0.1

	# Add RPATH for CEF's private ANGLE libraries (libEGL.so, libGLESv2.so)
	# These are Google's ANGLE implementation (OpenGL ES on Vulkan), NOT Mesa.
	# Debian policy allows RPATH for private shared libraries in /usr/lib/<package>/
	# See: https://wiki.debian.org/RpathIssue
	# The ANGLE libraries must be in a separate directory to avoid conflicts with system Mesa.
	# libcef.so already has $ORIGIN RUNPATH from upstream, we append the CEF private lib dir.
	patchelf --set-rpath '$$ORIGIN:/usr/lib/x86_64-linux-gnu/cef' \
		$(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu/libcef.so.138.0.1

	# Fix SONAME for proper library versioning (upstream uses unversioned "libcef.so")
	# This ensures proper library dependency tracking and ldconfig symlink creation
	patchelf --set-soname libcef.so.138 \
		$(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu/libcef.so.138.0.1

	# Create soname symlink
	ln -s libcef.so.138.0.1 \
		$(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu/libcef.so.138

	# Install headers (use _linux64 pattern to exclude _linux64_minimal)
	mkdir -p $(CURDIR)/debian/libcef-dev/usr/include/
	cp -r chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/include \
		$(CURDIR)/debian/libcef-dev/usr/include/cef

	# Install cmake config files if they exist (use _linux64 pattern)
	if [ -d chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/cmake ]; then \
		mkdir -p $(CURDIR)/debian/libcef-dev/usr/lib/x86_64-linux-gnu/cmake/cef/; \
		cp -r chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/cmake/* \
			$(CURDIR)/debian/libcef-dev/usr/lib/x86_64-linux-gnu/cmake/cef/; \
	fi

	# Install resources (PAK files) - use _linux64 pattern
	# PAK files are in Resources/ directory, NOT Release/
	mkdir -p $(CURDIR)/debian/cef-resources/usr/share/cef/
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Resources/*.pak \
		$(CURDIR)/debian/cef-resources/usr/share/cef/

	# Install ICU data file (CRITICAL for internationalization) - use _linux64 pattern
	# icudtl.dat is in Resources/ directory, NOT Release/
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Resources/icudtl.dat \
		$(CURDIR)/debian/cef-resources/usr/share/cef/

	# Install V8 context snapshot (CRITICAL for JavaScript) - use _linux64 pattern
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Release/v8_context_snapshot.bin \
		$(CURDIR)/debian/cef-resources/usr/share/cef/ || true

	# Install locales - use _linux64 pattern
	# Locales are in Resources/ directory, NOT Release/
	if [ -d chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Resources/locales ]; then \
		mkdir -p $(CURDIR)/debian/cef-resources/usr/share/cef/locales/; \
		cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Resources/locales/*.pak \
			$(CURDIR)/debian/cef-resources/usr/share/cef/locales/; \
	fi

	# Install other required libraries from Release directory
	# Skip libvulkan.so (conflicts with system libvulkan1 package)
	# Note: libEGL.so and libGLESv2.so are ANGLE libraries (NOT Mesa) - installed separately below
	for lib in chromium_src/chromium/src/cef/binary_distrib/cef_binary_*/Release/*.so*; do \
		libname="$$(basename $$lib)"; \
		if [ -f "$$lib" ] && [ "$$libname" != "libcef.so" ] && \
		   ! echo "$$libname" | grep -qE '^lib(EGL|GLESv2|vulkan)\.so'; then \
			install -D -m644 "$$lib" \
				"$(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu/$$libname"; \
		fi \
	done

	# Install ANGLE libraries (libEGL.so, libGLESv2.so) to CEF-specific directory
	# These are Google's ANGLE implementation (OpenGL ES on Vulkan), NOT Mesa.
	# CEF's GPU process requires these specific ANGLE libraries for hardware acceleration.
	# Installing to /usr/lib/x86_64-linux-gnu/cef/ avoids conflicts with system Mesa (libegl1, libgles2).
	# Applications using CEF should set LD_LIBRARY_PATH or use rpath to find these.
	mkdir -p $(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu/cef/
	for lib in chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Release/libEGL.so \
	           chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Release/libGLESv2.so; do \
		if [ -f "$$lib" ]; then \
			install -m644 "$$lib" $(CURDIR)/debian/libcef138/usr/lib/x86_64-linux-gnu/cef/; \
		fi \
	done

	# Install SwiftShader Vulkan ICD config (for software rendering fallback)
	# Generate with absolute path instead of relative path (original has ./libvk_swiftshader.so)
	# This is needed for Vulkan loader to find the library from any working directory
	mkdir -p $(CURDIR)/debian/libcef138/usr/share/vulkan/icd.d/
	echo '{"file_format_version": "1.0.0", "ICD": {"library_path": "/usr/lib/x86_64-linux-gnu/libvk_swiftshader.so", "api_version": "1.0.5"}}' \
		> $(CURDIR)/debian/libcef138/usr/share/vulkan/icd.d/vk_swiftshader_icd.json

	# Install chrome-sandbox (needed for CEF process isolation)
	# Note: This binary requires setuid root to function, but we install it without setuid
	# for security. Users who need sandbox support should either:
	# - Run the application with --no-sandbox flag, OR
	# - Configure setuid permissions manually: sudo chown root:root /usr/lib/cef/chrome-sandbox && sudo chmod 4755 /usr/lib/cef/chrome-sandbox
	for sandbox in chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_linux64/Release/chrome-sandbox; do \
		if [ -f "$$sandbox" ]; then \
			mkdir -p $(CURDIR)/debian/libcef138/usr/lib/cef/; \
			install -m755 "$$sandbox" $(CURDIR)/debian/libcef138/usr/lib/cef/chrome-sandbox; \
			break; \
		fi \
	done

override_dh_auto_test:
	# Skip tests for now - CEF tests require X display
	@echo "Skipping CEF tests (require X display)"

override_dh_auto_clean:
	# Clean Node.js and rollup symlinks (following Debian Chromium approach)
	# These are inside chromium_src/ but we clean them explicitly for clarity
	rm -rf chromium_src/chromium/src/third_party/node/linux/node-linux-x64 2>/dev/null || true
	rm -rf chromium_src/chromium/src/third_party/node/node_modules/rollup 2>/dev/null || true
	rm -f chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules/rollup3 2>/dev/null || true
	# Clean entire build directory
	rm -rf chromium_src/ || find chromium_src -type f -delete && find chromium_src -type d -empty -delete 2>/dev/null; rm -rf chromium_src/ 2>/dev/null || true
	# NOTE: depot_tools is treated as BUNDLED DEPENDENCY (not removed during clean)
	# TEMPORARY APPROACH: For official Debian submission, depot_tools must be:
	#   - Included in orig.tar.xz, OR
	#   - Packaged separately as debian package
	# Future: Phase 2 will include depot_tools in orig.tar.xz (see README.source)
	# DO NOT remove depot_tools/ here - it's part of the source package
	dh_auto_clean
