#!/usr/bin/make -f

# Align with Debian Chromium configuration (chromium_143.0.7499.169-1.debian.tar.xz)
# Reference: /tmp/chromium-debian-reference/debian/rules

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEBIAN_BUILD = 1

# Enable unstable Rust features with stable rustc (from Debian chromium line 67)
# Chromium uses -Z flags (nightly-only) but Debian only provides stable rustc
# RUSTC_BOOTSTRAP=1 tells rustc to allow nightly features on stable compiler
export RUSTC_BOOTSTRAP = 1

# Compiler toolchain (from Debian chromium lines 34-37)
# Align with Debian Chromium configuration (uses clang-19)
export AR = ar
export NM = nm
export CC = clang-19
export CXX = clang++-19

# Debian hardening flags (from Debian Chromium lines 39-42)
export DEB_CXXFLAGS_MAINT_STRIP=-g

# Standard build flags with system libc++ support
# These are read by CEF's unbundle toolchain (patch 0011) at GN parse time
# via getenv() to enable system libc++ (use_custom_libcxx=false)
export CXXFLAGS:=$(shell dpkg-buildflags --get CXXFLAGS) -stdlib=libc++
export LDFLAGS:=$(shell dpkg-buildflags --get LDFLAGS) -stdlib=libc++

# Rust toolchain configuration (from Debian chromium lines 66-74)
# Use system Rust instead of downloading from GCS
# Symlinks for clang-19 are set up at lines 380+
CLANG_MVERS := 19
rust_sysroot = /usr
export GN_DEFINES += rust_sysroot_absolute=\"$(rust_sysroot)\"
export GN_DEFINES += rust_bindgen_root=\"/usr\"
export GN_DEFINES += rustc_version=\"$(shell $(rust_sysroot)/bin/rustc --version 2>/dev/null)\"
export GN_DEFINES += clang_base_path=\"/usr/lib/llvm-$(CLANG_MVERS)\"
export GN_DEFINES += clang_version=\"$(CLANG_MVERS)\"

# FFmpeg: Use system libffmpeg.so for codec support (H.264/AAC when available)
export GN_DEFINES += is_component_ffmpeg=true

## ============================================================================
## LIBC++ CONFIGURATION: System libc++ via Custom Unbundle Toolchain
## ============================================================================
## DECISION (Build 206+): Use SYSTEM libc++ (use_custom_libcxx=false)
##
## Implementation:
## - Patch 0011: Created CEF unbundle toolchain (cef/toolchain/linux/debian/BUILD.gn)
## - Patch 0012: Added GetDebianArgs() to cef/tools/gn_args.py
## - When DEBIAN_BUILD=1 (line 7), GetDebianArgs() injects custom_toolchain
## - Toolchain reads CXXFLAGS/LDFLAGS from environment at GN parse time via getenv()
## - CXXFLAGS/LDFLAGS contain -stdlib=libc++ (lines 27-28)
## - Toolchain sets use_custom_libcxx=false in toolchain_args
##
## How It Works:
## 1. debian/rules exports DEBIAN_BUILD=1 (line 7)
## 2. debian/rules exports CXXFLAGS/LDFLAGS with -stdlib=libc++ (lines 27-28)
## 3. automate-git.py runs, which calls gn_args.py
## 4. GetDebianArgs() detects DEBIAN_BUILD=1, returns custom_toolchain
## 5. GN selects //cef/toolchain/linux/debian:default
## 6. Toolchain reads CXXFLAGS/LDFLAGS via getenv() at GN parse time
## 7. Toolchain sets use_custom_libcxx=false in toolchain_args
## 8. Build uses system libc++-19 (/usr/lib/llvm-19/lib/libc++.so.1)
##
## Why This Works (Build 206+ Success):
## ✅ Aligns with Debian Chromium unbundling policy
## ✅ Uses system libc++-19-dev package (no bundled libraries)
## ✅ Custom toolchain reads environment variables at GN parse time
## ✅ Based on Debian Chromium's unbundle toolchain approach
## ✅ No need to port Debian Chromium's 50+ unbundle patches
## ✅ CEF-specific solution that works with automate-git.py
##
## Previous Approach (Builds 199-205):
## - Builds 199-202: Failed with system libc++ due to missing unbundle infrastructure
## - Builds 203-205: Used bundled libc++ (use_custom_libcxx=true) as workaround
## - Problem: Bundled libc++ doesn't align with Debian policy
##
## Key Difference from Previous Failures:
## - Previous: Tried to use system libc++ WITHOUT unbundle toolchain
## - Now: Created CEF unbundle toolchain inspired by Debian Chromium
## - Critical: Toolchain reads flags via getenv() at GN PARSE time (not build time)
## ============================================================================
# Note: GN_DEFINES is set in the automate-git.py invocation (line ~797)
# Individual settings like use_custom_libcxx=false and use_thin_lto=false are there

# CEF version/branch
# Branch 7499 matches Chromium 143.0.7499.x (Debian chromium 143.0.7499.169)
CEF_BRANCH = 7499

%:
	dh $@

override_dh_auto_configure:
	# automate-git.py handles configuration
	@echo "CEF build will be configured by automate-git.py"

override_dh_dwz:
	# Skip dwz - Chromium uses DWARF5 debug info with .debug_str_offsets
	# sections that dwz doesn't understand
	@echo "Skipping dwz (incompatible DWARF5 debug info)"

## ============================================================================
## BUILD PROCESS DOCUMENTATION
## ============================================================================
## This build has 3 main challenges requiring the complex steps below:
##
## 1. EXEC_SCRIPT RESTRICTION FIX
##    - Problem: CEF uses exec_script in BUILD.gn (security-restricted by GN)
##    - Challenge: .gn config file doesn't exist until automate-git.py syncs Chromium
##    - Solution: Patch automate-git.py (0004-patch-gn-for-exec-script.patch)
##      to insert .gn patching logic after gclient sync but before gclient runhooks
##    - This is the professional approach: uses upstream tooling, single patch file,
##      no complex multi-phase shell logic, easy to maintain
##
## 2. STUB BUILD.GN FILES (34+ stubs currently)
##    - Problem: GN requires BUILD.gn files for all dependencies during configuration
##    - Challenge: Debian strips bundled third-party sources per policy
##    - Solution: Create empty stub BUILD.gN files with group() or source_set() targets
##    - Simplification: If Debian policy allows bundled sources, remove all stubs
##
## 3. GIT REPOSITORY REQUIREMENTS
##    - Problem: automate-git.py expects git repositories for CEF and Chromium
##    - Challenge: Debian source packages aren't git repositories
##    - Solution: Initialize temporary git repos in Steps 3.5 and 6
##    - Simplification: Could patch automate-git.py to skip git checks
## ============================================================================

override_dh_auto_build:
	## Step 1: Copy CEF source to build directory
	mkdir -p $(CURDIR)/chromium_src
	cp -a $(CURDIR)/cef $(CURDIR)/chromium_src/

	# Step 2: Remove old quilt state that would confuse patch application
	rm -rf $(CURDIR)/chromium_src/cef/.pc

	# Step 3: Apply Debian patches to CEF source
	cd $(CURDIR)/chromium_src/cef && \
		QUILT_PATCHES=$(CURDIR)/debian/patches quilt push -a || \
		(echo "ERROR: Failed to apply Debian patches"; exit 1)

	# Step 3.5: Initialize CEF directory as git repository (required by automate-git.py)
	@echo "==> Initializing git repository in CEF source"
	cd $(CURDIR)/chromium_src/cef && \
		git init && \
		git add . && \
		git commit -m "CEF source with Debian patches applied"
	@echo "==> CEF git repository initialized"

	# Step 4: Fix version mismatch (CEF expects specific tag, Debian has different point release)
	sed -i "s/143\.0\.7499\.[0-9]*/143.0.7499.169/" \
		$(CURDIR)/chromium_src/cef/CHROMIUM_BUILD_COMPATIBILITY.txt

	# Step 5: Extract Debian chromium source tarball
	@echo "==> Extracting Debian chromium source"
	tar -xf $(CURDIR)/../chromium_143.0.7499.169.orig.tar.xz \
		-C $(CURDIR)/chromium_src
	mkdir -p $(CURDIR)/chromium_src/chromium
	@if [ -d $(CURDIR)/chromium_src/chromium-* ]; then \
		mv $(CURDIR)/chromium_src/chromium-* $(CURDIR)/chromium_src/chromium/src 2>/dev/null || true; \
	fi
	@echo "==> Chromium extracted successfully"

	# Step 5.1: Setup system Node.js and rollup (following Debian Chromium approach)
	# Source: debian/rules lines 186-191 from Debian Chromium package
	# This ensures devtools-frontend can use system rollup instead of bundled version
	@echo "==> Setting up system Node.js and rollup"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-x64/bin
	-ln -sf /usr/bin/node $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-x64/bin/node 2>/dev/null || true
	# use system rollup
	cp -ra /usr/share/nodejs/rollup $(CURDIR)/chromium_src/chromium/src/third_party/node/node_modules/
	-test -L $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules/rollup3 || \
		ln -s /usr/share/nodejs/rollup $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules/rollup3
	@echo "==> Node.js and rollup3 symlink created"

	# Step 5.5: Apply Debian Chromium patches to vanilla source
	# Extract Debian Chromium packaging (includes patches and build configuration)
	@echo "==> Applying Debian Chromium patches for system integration"
	tar -xf $(CURDIR)/../chromium_143.0.7499.169-1.debian.tar.xz \
		-C $(CURDIR)/chromium_src/chromium/
	# Apply debianization patches (system libraries, build fixes, security patches)
	@cd $(CURDIR)/chromium_src/chromium/src && \
		for patch_dir in debianization fixes system; do \
			if [ -d "../debian/patches/$$patch_dir" ]; then \
				for patch in ../debian/patches/$$patch_dir/*.patch; do \
					[ -f "$$patch" ] && { \
						echo "Applying $$patch"; \
						patch -p1 < "$$patch" || { \
							echo "WARNING: Patch $$patch failed, continuing..."; \
						}; \
					}; \
				done; \
			fi; \
		done
	@echo "==> Debian Chromium patches applied successfully"

	# Step 6: Initialize git repository in chromium (required by automate-git.py)
	@echo "==> Initializing git repository in chromium source"
	# Remove ALL .git directories from Debian chromium tarball to prevent conflicts
	# gclient sync will move any existing .git directories to _bad_scm, which breaks the build
	# Note: We intentionally do NOT add 'origin' remote or tags here because:
	#   1. We're using Debian tarball sources, not upstream chromium
	#   2. Patch 0005 skips gclient revert which would need 'origin'
	#   3. Patch 0006 skips chromium checkout which would need tags
	#   4. Patches 0007-0008 handle tarball mode (source_tarball=True in .gclient)
	#   5. No git/network operations needed - all sources are local (Debian CI compatible)
	#   6. Forward compatible: when chromium-source package exists, patch 0006
	#      will skip checkout and preserve the real git repo with real tags
	@echo "==> Removing all .git directories from chromium tree (prevents gclient sync conflicts)"
	find $(CURDIR)/chromium_src/chromium/src -type d -name '.git' -exec rm -rf {} + 2>/dev/null || true
	@echo "==> Creating new git repository in chromium/src"
	cd $(CURDIR)/chromium_src/chromium/src && \
		git init && \
		git config user.name "Debian Builder" && \
		git config user.email "builder@debian.org" && \
		git commit --allow-empty -m "Initial chromium source from Debian tarball"
	@echo "==> Git repository initialized (empty commit to avoid OOM)"

	# Step 6.3: Copy locale stub source to Chromium source tree (Build 175i)
	# GN action() will compile it after gn gen but before ninja compiles protoc-gen-js
	# Note: Patch 0008 creates this file in chromium_src/cef/tools/debian_stubs/cef_locale_stub.cpp
	@echo "==> Copying locale stub source to chromium/src/debian/"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/debian
	cp $(CURDIR)/chromium_src/cef/tools/debian_stubs/cef_locale_stub.cpp $(CURDIR)/chromium_src/chromium/src/debian/
	@echo "==> Locale stub source copied"

	# Step 6.5: Patch Chromium DEPS to disable git submodule checking
	# gclient runhooks calls GetSubmoduleDiff() when git_dependencies != 'DEPS'
	# Setting git_dependencies = 'DEPS' disables submodule checks (not needed for Debian builds)
	# Note: DEPS file uses SINGLE quotes around 'SYNC', not double quotes
	@echo "==> Patching chromium/src/DEPS to disable git submodule checks"
	@if [ -f $(CURDIR)/chromium_src/chromium/src/DEPS ]; then \
		sed -i "s/git_dependencies = 'SYNC'/git_dependencies = 'DEPS'/" \
			$(CURDIR)/chromium_src/chromium/src/DEPS && \
		echo "==> DEPS patched: git_dependencies set to 'DEPS'"; \
	else \
		echo "WARNING: DEPS file not found at $(CURDIR)/chromium_src/chromium/src/DEPS, skipping patch (may be handled by automate-git.py)"; \
	fi
	# Note: gclient sync --nohooks will be run by automate-git.py (see 0004 patch)
	# after depot_tools is cloned but before gclient runhooks
	# Note: automate-git.py ONLY applies tarball patches if chromium_src_dir doesn't exist
	# Since we extract chromium BEFORE running automate-git.py, we must apply patches ourselves

	# Step 6.6: Verify depot_tools is present (BUNDLED DEPENDENCY - Phase 1)
	# CURRENT APPROACH (Phase 1): depot_tools treated as bundled dependency
	#   - User clones depot_tools once: git clone https://...depot_tools.git
	#   - debian/rules clean PRESERVES depot_tools/ (not removed)
	#   - Works for local development and testing
	# FUTURE (Phase 2): Include depot_tools in orig.tar.xz
	#   - Option A: Bundle depot_tools in CEF source package
	#   - Option B: Package depot_tools separately as Debian package (ideal but blocked by Google's rolling release model)
	# Network isolation: NO downloads during build - depot_tools must pre-exist
	@echo "==> Verifying depot_tools is present (bundled dependency)"
	@if [ ! -d $(CURDIR)/depot_tools ]; then \
		echo "ERROR: depot_tools directory not found at $(CURDIR)/depot_tools"; \
		echo "ERROR:"; \
		echo "ERROR: FIRST-TIME SETUP REQUIRED:"; \
		echo "ERROR:   git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git depot_tools"; \
		echo "ERROR:"; \
		echo "ERROR: After setup, depot_tools will be preserved across builds (not removed by 'clean')."; \
		echo "ERROR: See debian/README.source for packaging details."; \
		exit 1; \
	fi
	@echo "==> depot_tools found (bundled dependency - Phase 1 approach)"

	# Step 6.6.0.5: Initialize depot_tools if needed (first-time setup)
	# depot_tools requires initialization to create python3_bin_reldir.txt
	# This file points to the bundled Python interpreter used by gclient/gn
	# Without it, gn gen fails with "need to initialize depot_tools"
	@echo "==> Checking if depot_tools needs initialization"
	@if [ ! -f $(CURDIR)/depot_tools/python3_bin_reldir.txt ]; then \
		echo "==> Initializing depot_tools (first-time setup)"; \
		cd $(CURDIR)/depot_tools && ./update_depot_tools; \
		echo "==> depot_tools initialization complete"; \
	else \
		echo "==> depot_tools already initialized"; \
	fi

	# Step 6.6.0.6: Use system Python instead of depot_tools bundled Python
	# depot_tools tries to use a bundled Python from bootstrap directory
	# For Debian builds, we use system Python3 instead (no network downloads)
	# Create the expected directory structure and symlink to system python3
	@echo "==> Setting up depot_tools to use system Python"
	@PYTHON_REL_DIR=$$(cat $(CURDIR)/depot_tools/python3_bin_reldir.txt); \
	mkdir -p "$(CURDIR)/depot_tools/$$PYTHON_REL_DIR"; \
	ln -sf /usr/bin/python3 "$(CURDIR)/depot_tools/$$PYTHON_REL_DIR/python3"; \
	echo "==> Created symlink: depot_tools/$$PYTHON_REL_DIR/python3 -> /usr/bin/python3"

	# Step 6.6.1: Reset depot_tools to pristine state (since it's preserved across builds)
	# depot_tools is a git repository, so we can reset it to clean state before patching
	# Reset to HEAD~1 to undo the "Apply Debian patches" commit from previous build
	@echo "==> Resetting depot_tools to pristine state (undoing previous Debian patches commit)"
	cd $(CURDIR)/depot_tools && git reset --hard HEAD~1 && git clean -fd
	@echo "==> depot_tools reset complete"

	# Step 6.7: Apply Debian-specific Chromium patches (Build 94 working solution)
	# These patches modify Chromium sources (not CEF), so they're in debian/patches/chromium/
	# and use .chromium.patch suffix to distinguish them from CEF patches
	# Note: depot_tools is now reset to pristine state, so patches apply cleanly every time
	# Note: libcpp-headers patch removed - Debian Chromium patches already handle this
	@echo "==> Applying Debian Chromium patches (DEPS, gclient, DRI, Rust, network isolation, test_fonts, warning-suppression, panic-abort)"
	patch -p1 -d $(CURDIR)/chromium_src < debian/patches/chromium/0001-debian-tarball-deps.chromium.patch
	patch -p1 -d $(CURDIR)/depot_tools < debian/patches/chromium/0002-debian-tarball-gclient-toplevel.chromium.patch
	patch -p1 -d $(CURDIR)/depot_tools < debian/patches/chromium/0003-network-isolation-disable-google-storage-downloads.chromium.patch
	patch -p1 -d $(CURDIR)/depot_tools < debian/patches/chromium/0004-skip-gcs-deps-when-source-tarball.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0005-make-siso-import-optional.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0006-skip-test-fonts.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0007-disable-warning-suppression-mappings.chromium.patch
	# Commit depot_tools patches to avoid git conflicts when automate-git.py calls update_depot_tools
	# Without this, git sees gclient.py and download_from_google_storage.py as "local changes"
	# and refuses to checkout when update_depot_tools tries to switch commits
	@echo "==> Committing depot_tools patches to avoid git conflicts"
	cd $(CURDIR)/depot_tools && git add -A && git commit -m "Apply Debian patches (0002, 0003, 0004)" --allow-empty
	@echo "==> depot_tools patches committed"
	patch -p1 -d $(CURDIR)/chromium_src < debian/patches/chromium/0008-fix-dri-pkg-config-debian.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0009-remove-rust-nightly-flags-debian.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0010-protoc-gen-js-gn-action-stub.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0011-disable-panic-immediate-abort.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0012-bindgen-libclang-abspath.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0013-skip-nodejs-version-check.chromium.patch
	# Patch 0014: Create stub BUILD.gn for bundled libc++ when using system libc++ (use_custom_libcxx=false)
	# When using custom unbundle toolchain, bundled libc++ directory doesn't exist
	# but GN still tries to load buildtools/third_party/libc++/BUILD.gn during parse phase
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0014-add-stub-libcxx-build-gn.chromium.patch
	# Patch 0015: Remove GCC libstdc++ optional header for system libc++ compatibility
	# The Chromium source tarball contains a file 'optional' at the root directory which is a GCC header
	# This header includes <bits/version.h> (GCC-specific, doesn't exist in libc++)
	# Must be removed AFTER gclient sync (which extracts tarball) but BEFORE compilation
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0015-remove-libstdcxx-optional-header.chromium.patch
	# Patch 0016: Fix Clang 19 warning flag names to eliminate warning spam
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0016-fix-clang-19-warning-flags.chromium.patch
	# Patch 0017: Handle SwiftShader reactor conditional target (for subzero-disabled builds)
	# With subzero disabled and LLVM enabled, this patch ensures proper GN target resolution
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0017-swiftshader-reactor-handle-no-backends.chromium.patch
	# Patch 0018: Skip JS proto generation due to protobuf version mismatch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0018-skip-js-proto-generation.chromium.patch
	# Patch 0019: Fix LLVM-16 C++23/libc++ compatibility in SwiftShader (unified patch)
	# Fixes incomplete type issues with std::unique_ptr in C++23 mode (APFloat, AAResults,
	# DiagnosticInfo, ModuleSummaryIndex and related files - 23 files total)
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0019-swiftshader-llvm16-cxx23-unified.chromium.patch
	# Patch 0020: Add xcb library to ANGLE X11 libs for Vulkan XCB backend
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0020-angle-add-xcb-library.chromium.patch
	# Patch 0021: Remove nightly-only Rust options from crabbyavif BUILD.gn
	# Removes -Zallow-features=sanitize and disable_cfi feature for stable Rust compatibility.
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0021-fix-rust-nightly-option-crabbyavif.chromium.patch
	# Patch 0022: Fix GN unused variable scoping error in gcc_toolchain.gni
	# Moves deb_build_arch/deb_host_arch getenv() calls inside toolchain_args scope.
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0022-fix-gn-unused-variable-scoping.chromium.patch
	# Patch 0023: Fix GCC 15 libstdc++ std::optional::emplace() with aggregate types
	# Replaces emplace() with aggregate initialization assignment for C++20 aggregates with
	# default member initializers (multiplex_router, rtp_config, gpu_image_decode_cache,
	# paint_layer_scrollable_area, line_breaker).
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0023-gcc15-optional-emplace-aggregate-fixes.chromium.patch
	# Patch 0024: Fix GCC 15 consteval errors with MakeFixedFlatSet/Map and std::string
	# GCC 15 consteval cannot use std::string (heap allocation). Fixes cookie_craving.cc,
	# autofill_structured_address_component.cc, generate_country_native_names.cc, country_names.cc.
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0024-gcc15-consteval-string-fixes.chromium.patch
	# Patch 0025: Fix GCC 15 libstdc++ flat_map with move-only OnceCallback
	# Use try_emplace instead of operator[] to avoid copy operations.
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0025-wayland-color-manager-flat-map-fix.chromium.patch
	# Patch 0026: Fix GCC 15 libstdc++ CodePointIterator incomplete type in wtf_string.h
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0026-wtf-string-codepoint-iterator-include.chromium.patch
	# Patch 0027: Fix GRIT tracing resources - create stub about_tracing files without catapult
	# Catapult is stripped from Debian source for DFSG compliance, so we generate stubs directly.
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0027-tracing-stub-catapult-removed.chromium.patch
	# Patch 0028: Add enable_cef to GRIT defines for components_strings
	# CEF patches add <if expr="enable_cef"> conditionals to GRD files, so GRIT needs enable_cef defined.
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0028-grit-enable-cef-define.chromium.patch
	# Patch 0029: Add enable_cef to chrome_grit_defines for preprocess_if_expr
	# CEF's about_version.ts/html use <if expr="enable_cef"> conditionals processed by build_webui.gni
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0029-add-enable-cef-to-chrome-grit-defines.chromium.patch
	# Patch 0030: Fix ToValueList to use std::move for projection results
	# std::ranges::for_each stores projection result as lvalue, causing Append(DictValue&&) mismatch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0030-fix-to-value-list-move-for-append.chromium.patch
	# NOTE: Patch 0031 removed - fontconfig stub is created directly below in Step 7.2
	# The fontconfig BUILD.gn with pkg-config support is created fresh, not patched
	# Patch 0032: Fix surface_aggregator AggregateStatistics emplace for GCC 15
	# GCC 15 libstdc++ std::optional::emplace() fails for aggregates with default initializers
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0032-surface-aggregator-emplace-fix.chromium.patch
	# Patch 0033: Fix compose config MakeFixedFlatSet consteval with std::string for GCC 15
	# consteval functions cannot use std::string (heap allocation not allowed at compile time)
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0033-compose-config-consteval-fix.chromium.patch
	# Patch 0034: Stub test_fonts/fontconfig BUILD.gn - test fonts stripped from Debian tarball
	# Without this, generate_fontconfig_caches fails because test_fonts directory is missing
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0034-test-fonts-fontconfig-stub.chromium.patch
	# NOTE: Patch 0035 removed - Chromium 143+ already includes <memory> in tips_agent.h
	# NOTE: Patches 0036-0039 removed - libpng, libjpeg_turbo, flac, openh264 stubs are created
	# directly below in Step 7.5 with proper libs linkage. These stubs don't exist at patch time.
	# Patch 0040: Fix StringPrintf format args for abseil strict checking
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0040-audio-device-stringprintf-cstr-fix.chromium.patch
