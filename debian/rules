#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEBIAN_BUILD = 1

# CEF version/branch
# Branch 7444 matches Chromium 142.0.7444.x (Debian chromium 142.0.7444.134)
CEF_BRANCH = 7444

%:
	dh $@

override_dh_auto_configure:
	# automate-git.py handles configuration
	@echo "CEF build will be configured by automate-git.py"

## ============================================================================
## BUILD PROCESS DOCUMENTATION
## ============================================================================
## This build has 3 main challenges requiring the complex steps below:
##
## 1. EXEC_SCRIPT RESTRICTION FIX
##    - Problem: CEF uses exec_script in BUILD.gn (security-restricted by GN)
##    - Challenge: .gn config file doesn't exist until automate-git.py syncs Chromium
##    - Solution: Patch automate-git.py (0004-patch-gn-for-exec-script.patch)
##      to insert .gn patching logic after gclient sync but before gclient runhooks
##    - This is the professional approach: uses upstream tooling, single patch file,
##      no complex multi-phase shell logic, easy to maintain
##
## 2. STUB BUILD.GN FILES (34+ stubs currently)
##    - Problem: GN requires BUILD.gn files for all dependencies during configuration
##    - Challenge: Debian strips bundled third-party sources per policy
##    - Solution: Create empty stub BUILD.gN files with group() or source_set() targets
##    - Simplification: If Debian policy allows bundled sources, remove all stubs
##
## 3. GIT REPOSITORY REQUIREMENTS
##    - Problem: automate-git.py expects git repositories for CEF and Chromium
##    - Challenge: Debian source packages aren't git repositories
##    - Solution: Initialize temporary git repos in Steps 3.5 and 6
##    - Simplification: Could patch automate-git.py to skip git checks
## ============================================================================

override_dh_auto_build:
	## Step 1: Copy CEF source to build directory
	mkdir -p $(CURDIR)/chromium_src
	cp -a $(CURDIR)/cef $(CURDIR)/chromium_src/

	# Step 2: Remove old quilt state that would confuse patch application
	rm -rf $(CURDIR)/chromium_src/cef/.pc

	# Step 3: Apply Debian patches to CEF source
	cd $(CURDIR)/chromium_src/cef && \
		QUILT_PATCHES=$(CURDIR)/debian/patches quilt push -a || \
		(echo "ERROR: Failed to apply Debian patches"; exit 1)

	# Step 3.5: Initialize CEF directory as git repository (required by automate-git.py)
	@echo "==> Initializing git repository in CEF source"
	cd $(CURDIR)/chromium_src/cef && \
		git init && \
		git add . && \
		git commit -m "CEF source with Debian patches applied"
	@echo "==> CEF git repository initialized"

	# Step 4: Fix version mismatch (CEF expects .53, Debian has .134)
	sed -i "s/142\.0\.7444\.53/142.0.7444.134/" \
		$(CURDIR)/chromium_src/cef/CHROMIUM_BUILD_COMPATIBILITY.txt

	# Step 5: Extract Debian chromium source tarball
	@echo "==> Extracting Debian chromium source"
	tar -xf $(CURDIR)/../chromium_142.0.7444.134.orig.tar.xz \
		-C $(CURDIR)/chromium_src
	mkdir -p $(CURDIR)/chromium_src/chromium
	@if [ -d $(CURDIR)/chromium_src/chromium-* ]; then \
		mv $(CURDIR)/chromium_src/chromium-* $(CURDIR)/chromium_src/chromium/src 2>/dev/null || true; \
	fi
	@echo "==> Chromium extracted successfully"

	# Step 6: Initialize git repository in chromium (required by automate-git.py)
	@echo "==> Initializing git repository in chromium source"
	# Remove ALL .git directories from Debian chromium tarball to prevent conflicts
	# gclient sync will move any existing .git directories to _bad_scm, which breaks the build
	# Note: We intentionally do NOT add 'origin' remote or tags here because:
	#   1. We're using Debian tarball sources, not upstream chromium
	#   2. Patch 0005 skips gclient revert which would need 'origin'
	#   3. Patch 0006 skips chromium checkout which would need tags
	#   4. Patches 0007-0008 handle tarball mode (source_tarball=True in .gclient)
	#   5. No git/network operations needed - all sources are local (Debian CI compatible)
	#   6. Forward compatible: when chromium-source package exists, patch 0006
	#      will skip checkout and preserve the real git repo with real tags
	@echo "==> Removing all .git directories from chromium tree (prevents gclient sync conflicts)"
	find $(CURDIR)/chromium_src/chromium/src -type d -name '.git' -exec rm -rf {} + 2>/dev/null || true
	@echo "==> Creating new git repository in chromium/src"
	cd $(CURDIR)/chromium_src/chromium/src && \
		git init && \
		git add . && \
		git commit -m "Initial chromium source from Debian tarball"
	@echo "==> Git repository initialized"

	# Step 6.5: Patch Chromium DEPS to disable git submodule checking
	# gclient runhooks calls GetSubmoduleDiff() when git_dependencies != 'DEPS'
	# Setting git_dependencies = 'DEPS' disables submodule checks (not needed for Debian builds)
	# Note: DEPS file uses SINGLE quotes around 'SYNC', not double quotes
	@echo "==> Patching chromium/src/DEPS to disable git submodule checks"
	@if [ -f $(CURDIR)/chromium_src/chromium/src/DEPS ]; then \
		sed -i "s/git_dependencies = 'SYNC'/git_dependencies = 'DEPS'/" \
			$(CURDIR)/chromium_src/chromium/src/DEPS && \
		echo "==> DEPS patched: git_dependencies set to 'DEPS'"; \
	else \
		echo "WARNING: DEPS file not found at $(CURDIR)/chromium_src/chromium/src/DEPS, skipping patch (may be handled by automate-git.py)"; \
	fi
	# Note: gclient sync --nohooks will be run by automate-git.py (see 0004 patch)
	# after depot_tools is cloned but before gclient runhooks
	# Note: automate-git.py ONLY applies tarball patches if chromium_src_dir doesn't exist
	# Since we extract chromium BEFORE running automate-git.py, we must apply patches ourselves

	# Step 6.6: Verify depot_tools is present (BUNDLED DEPENDENCY - Phase 1)
	# CURRENT APPROACH (Phase 1): depot_tools treated as bundled dependency
	#   - User clones depot_tools once: git clone https://...depot_tools.git
	#   - debian/rules clean PRESERVES depot_tools/ (not removed)
	#   - Works for local development and testing
	# FUTURE (Phase 2 - see debian/TODO-DEPOT-TOOLS.txt):
	#   - Option A: Include depot_tools in orig.tar.xz
	#   - Option B: Package depot_tools separately as Debian package
	# Network isolation: NO downloads during build - depot_tools must pre-exist
	@echo "==> Verifying depot_tools is present (bundled dependency)"
	@if [ ! -d $(CURDIR)/depot_tools ]; then \
		echo "ERROR: depot_tools directory not found at $(CURDIR)/depot_tools"; \
		echo "ERROR:"; \
		echo "ERROR: FIRST-TIME SETUP REQUIRED:"; \
		echo "ERROR:   git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git depot_tools"; \
		echo "ERROR:"; \
		echo "ERROR: After setup, depot_tools will be preserved across builds (not removed by 'clean')."; \
		echo "ERROR: See debian/TODO-DEPOT-TOOLS.txt for packaging plans."; \
		exit 1; \
	fi
	@echo "==> depot_tools found (bundled dependency - Phase 1 approach)"

	# Step 6.6.1: Reset depot_tools to pristine state (since it's preserved across builds)
	# depot_tools is a git repository, so we can reset it to clean state before patching
	@echo "==> Resetting depot_tools to pristine state"
	cd $(CURDIR)/depot_tools && git reset --hard HEAD && git clean -fd
	@echo "==> depot_tools reset complete"

	# Step 6.7: Apply Debian-specific Chromium patches (Build 94 working solution)
	# These patches modify Chromium sources (not CEF), so they're in debian/patches/chromium/
	# and use .chromium.patch suffix to distinguish them from CEF patches
	# Note: depot_tools is now reset to pristine state, so patches apply cleanly every time
	@echo "==> Applying Debian Chromium patches (DEPS, gclient, DRI, Rust, libc++, network isolation)"
	patch -p1 -d $(CURDIR)/chromium_src < debian/patches/chromium/0007-debian-tarball-deps.chromium.patch
	patch -p1 -d $(CURDIR)/depot_tools < debian/patches/chromium/0008-debian-tarball-gclient-toplevel.chromium.patch
	patch -p1 -d $(CURDIR)/depot_tools < debian/patches/chromium/0015-network-isolation-disable-google-storage-downloads.chromium.patch
	# Commit depot_tools patches to avoid git conflicts when automate-git.py calls update_depot_tools
	# Without this, git sees gclient.py and download_from_google_storage.py as "local changes"
	# and refuses to checkout when update_depot_tools tries to switch commits
	@echo "==> Committing depot_tools patches to avoid git conflicts"
	cd $(CURDIR)/depot_tools && git add -A && git commit -m "Apply Debian patches (0008, 0015)" --allow-empty
	@echo "==> depot_tools patches committed"
	patch -p1 -d $(CURDIR)/chromium_src < debian/patches/chromium/0010-fix-dri-pkg-config-debian.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0013-remove-rust-nightly-flags-debian.chromium.patch
	patch -p1 -d $(CURDIR)/chromium_src/chromium/src < debian/patches/chromium/0014-fix-protoc-gen-js-libcxx-linking.chromium.patch
	@echo "==> Debian Chromium patches applied"

	# Step 6.8: Additional DEPS fix for generate_location_tags hook
	# CEF's tarball_deps.patch doesn't include this hook, so we add it with sed
	@echo "==> Fixing generate_location_tags condition in DEPS"
	sed -i "s/'condition': 'generate_location_tags',/'condition': 'generate_location_tags and not source_tarball',/" \
		$(CURDIR)/chromium_src/chromium/src/DEPS
	@echo "==> generate_location_tags condition fixed"

	# Step 7: Create symlink to system GN executable
	@echo "==> Configuring to use system GN executable"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/buildtools/linux64/gn/
	ln -sf /usr/bin/gn $(CURDIR)/chromium_src/chromium/src/buildtools/linux64/gn/gn
	@echo "==> GN symlink created"

	# Step 7.5: Create stub files for Debian-stripped directories
	@echo "==> Creating stub BUILD.gn for third_party/opus (Debian uses system libopus)"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/opus
	echo '# Stub BUILD.gn for Debian builds' > $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo '# Debian uses system libopus instead of bundled version' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo '# These are test/demo targets not needed for CEF' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo '' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'source_set("opus") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'config("opus_config") {}' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'executable("opus_compare") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'executable("opus_demo") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'executable("test_opus_api") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'executable("test_opus_decode") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'executable("test_opus_encode") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	echo 'executable("test_opus_padding") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	@echo "==> Creating stub chrome/android/modules/buildflags.gni (Debian strips Android files)"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/chrome/android/modules
	echo '# Stub buildflags.gni for Debian builds' > $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	echo '# Debian strips Android files since we'"'"'re building for Linux only' >> $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	echo '' >> $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	echo 'declare_args() {' >> $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	echo '  # Android-specific flag for symbol partitioning (not used on Linux)' >> $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	echo '  use_native_partitions = false' >> $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	echo '}' >> $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	@echo "==> Creating stub build/config/freetype/freetype.gni (Debian uses system freetype)"
	echo '# Stub freetype.gni for Debian builds' > $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo '# Debian uses system freetype instead of bundled version' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo '' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo 'declare_args() {' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo '  # Use system freetype (overridden by GN_DEFINES)' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo '  use_system_freetype = true' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo '  # Enable freetype rendering' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo '  enable_freetype = true' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	echo '}' >> $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	@echo "==> Creating stub third_party/catapult/telemetry/BUILD.gn (Debian strips testing tools)"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry
	echo '# Stub BUILD.gn for Debian builds' > $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry/BUILD.gn
	echo '# Debian strips catapult testing tools' >> $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry/BUILD.gn
	echo '# This is a test/benchmark tool not needed for CEF' >> $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry/BUILD.gn
	echo '' >> $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry/BUILD.gn
	echo 'executable("bitmaptools") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry/BUILD.gn
	@echo "==> Creating stub third_party/libjpeg_turbo/BUILD.gn (Debian uses system libjpeg)"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo
	echo '# Stub BUILD.gn for Debian builds' > $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo/BUILD.gn
	echo '# Debian uses system libjpeg instead of bundled libjpeg-turbo' >> $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo/BUILD.gn
	echo '' >> $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo/BUILD.gn
	echo 'source_set("simd") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo/BUILD.gn
	echo 'source_set("simd_asm") { sources = [] }' >> $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo/BUILD.gn
	@echo "==> Creating stub third_party/catapult/third_party/typ/BUILD.gn"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult/third_party/typ
	echo '# Stub BUILD.gn for Debian builds - typ is a testing library' > $(CURDIR)/chromium_src/chromium/src/third_party/catapult/third_party/typ/BUILD.gn
	echo 'group("typ") {}' >> $(CURDIR)/chromium_src/chromium/src/third_party/catapult/third_party/typ/BUILD.gn
	# Create BUILD.gn stub for GN build system, AND copy __config_site + __assertion_handler from chromium tarball
	# BUILD.gn is required by //build/config/BUILDCONFIG.gn:606 (:all_modules target)
	# __config_site and __assertion_handler must be copied from chromium tarball (perfetto copy has full config)
	@echo "==> Creating buildtools/third_party/libc++/ BUILD.gn, __config_site, and __assertion_handler"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++
	# Create REAL BUILD.gn that builds bundled libc++ library (not stub)
	# Needed for patch 0014 v3 which links protoc-gen-js against bundled libc++
	# Uses all .cpp files from third_party/libc++/src/src/ (69 files)
	@echo "==> Building bundled libc++ static library (namespace __Cr from perfetto config)"
	echo '# Real BUILD.gn for Debian builds - compiles bundled libc++ library' > $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo 'static_library("libc++") {' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '  sources = [' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	find $(CURDIR)/chromium_src/chromium/src/third_party/libc++/src/src -name "*.cpp" | \
		grep -v '/win32/' | grep -v '/ibm/' | grep -v 'pstl/libdispatch' | \
		grep -v 'ryu/f2s.cpp' | grep -v 'ryu/d2s.cpp' | grep -v 'ryu/d2fixed.cpp' | \
		grep -v 'random_shuffle.cpp' | grep -v 'random.cpp' | grep -v 'locale.cpp' | \
		grep -v 'filesystem/path.cpp' | grep -v 'filesystem/filesystem_error.cpp' | grep -v 'filesystem/operations.cpp' | \
		grep -v 'exception.cpp' | \
		sed 's|$(CURDIR)/chromium_src/chromium/src/|    "//|' | sed 's/$$/",/' | \
		sort >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '  ]' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '  include_dirs = [' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '    "//buildtools/third_party/libc++",' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '    "//third_party/libc++/src/include",' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '  ]' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '  configs -= [ "//build/config/compiler:chromium_code" ]' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '  configs += [ "//build/config/compiler:no_chromium_code" ]' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '  cflags_cc = [ "-std=c++23" ]  # libc++ requires C++23 (from upstream chromium BUILD.gn)' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '}' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo '# Keep these groups for compatibility with GN configuration' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo 'group("custom_headers") {}' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo 'group("libcxx_headers") {}' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	echo 'group("all_modules") {}' >> $(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/BUILD.gn
	# PERFETTO-BASED CONFIG with ASAN + TRANSITIVE INCLUDES fixes (Build 117)
	# DATA: Build 116 (perfetto + ASAN fix) task 47, Build 115 (system) task 48
	# ANALYSIS: Build 116 failed with "no type named 'ostream'" in abseil-cpp
	#   - ROOT CAUSE: perfetto has #define _LIBCPP_REMOVE_TRANSITIVE_INCLUDES
	#   - Abseil expects transitive includes (doesn't explicitly #include <iostream>)
	#   - Build 114 had ASAN error at task 51, Build 116 fixed that but hit transitive includes error at task 47
	# HISTORICAL SOLUTION (CLAUDE.md:329): "Required multiple sed hacks to fix ASAN, REMOVE_TRANSITIVE_INCLUDES, etc."
	# FIX: Use perfetto base (correct ABI v2, namespace __Cr, hardening=NONE) + disable BOTH problematic macros
	@echo "==> Using perfetto libc++ config with ASAN + TRANSITIVE INCLUDES fixes (Build 117)"
	# Step 1: Copy perfetto __config_site (ABI v2, namespace __Cr, hardening=NONE)
	cp $(CURDIR)/chromium_src/chromium/src/third_party/perfetto/buildtools/libcxx_config/__config_site \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	# Step 2: FIX ASAN - Comment out empty macro that breaks preprocessor
	sed -i 's/^#define _LIBCPP_INSTRUMENTED_WITH_ASAN$$/\/* #define _LIBCPP_INSTRUMENTED_WITH_ASAN - disabled: empty macro causes preprocessor errors *\//' \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	# Step 3: FIX TRANSITIVE INCLUDES - Comment out to enable transitive includes for abseil-cpp
	sed -i 's/^#define _LIBCPP_REMOVE_TRANSITIVE_INCLUDES$$/\/* #define _LIBCPP_REMOVE_TRANSITIVE_INCLUDES - disabled: abseil needs transitive includes *\//' \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	# Step 4: DEFINE POSITIVE FEATURE MACROS - perfetto only undefines negatives, causing guards to fail
	# Without these, code that checks "#if _LIBCPP_HAS_THREADS" evaluates to false (undefined = 0)
	# This affects abseil-cpp, ICU, and other components using standard library features
	@echo "==> Defining positive libc++ feature macros in __config_site"
	sed -i '/^\/\* #undef _LIBCPP_HAS_NO_LOCALIZATION \*\/$$/a #define _LIBCPP_HAS_LOCALIZATION 1' \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	sed -i '/^\/\* #undef _LIBCPP_HAS_NO_MONOTONIC_CLOCK \*\/$$/a #define _LIBCPP_HAS_MONOTONIC_CLOCK 1' \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	sed -i '/^\/\* #undef _LIBCPP_HAS_NO_WIDE_CHARACTERS \*\/$$/a #define _LIBCPP_HAS_WIDE_CHARACTERS 1' \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	sed -i '/^\/\* #undef _LIBCPP_HAS_NO_FILESYSTEM \*\/$$/a #define _LIBCPP_HAS_FILESYSTEM 1' \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	sed -i '/^\/\* #undef _LIBCPP_HAS_NO_THREADS \*\/$$/a #define _LIBCPP_HAS_THREADS 1' \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__config_site
	# Step 5: Copy __assertion_handler (safe, generic)
	cp $(CURDIR)/chromium_src/chromium/src/third_party/perfetto/buildtools/libcxx_config/__assertion_handler \
		$(CURDIR)/chromium_src/chromium/src/buildtools/third_party/libc++/__assertion_handler
	@echo "==> Perfetto config applied: ABI v2, namespace=__Cr, hardening=NONE, ASAN disabled, transitive includes enabled, feature macros defined"
	# DO NOT symlink headers into buildtools/third_party/libc++/
	# build/config/c++/*.gn hardcodes: include_dirs += [ "//buildtools/third_party/libc++" ]
	# This creates -I../../buildtools/third_party/libc++ with HIGH priority
	# If headers are in that directory, compiler finds them via -I instead of -isystem
	# This breaks libc++ C wrapper headers (math.h, cstring) because #include_next fails
	# Correct setup: buildtools/third_party/libc++/ contains ONLY __config_site and __assertion_handler
	# Actual headers come from -isystem../../third_party/libc++/src/include (LOWER priority, correct)
	# Use system rollup instead of bundled @rollup/wasm-node (avoids WASM binary dependency)
	# CREATE SYMLINK at exact path BUILD.gn files expect: node_modules/@rollup/wasm-node/dist/bin/rollup
	@echo "==> Using system rollup (from rollup package)"
	if [ ! -f /usr/share/nodejs/rollup/dist/bin/rollup ]; then \
		echo "ERROR: System rollup binary not found at /usr/share/nodejs/rollup/dist/bin/rollup"; \
		echo "Install: apt-get install rollup"; \
		exit 1; \
	fi
	@echo "==> Creating symlink for @rollup/wasm-node → system rollup"
	cd $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src && \
	mkdir -p node_modules/@rollup/wasm-node/dist/bin && \
	ln -sf /usr/share/nodejs/rollup/dist/bin/rollup node_modules/@rollup/wasm-node/dist/bin/rollup
	@echo "==> Creating stub third_party/llvm-build/Release+Asserts/cr_build_revision (Debian uses system clang)"
