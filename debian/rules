#!/usr/bin/make -f

# Get package version from debian/changelog (provides DEB_VERSION_UPSTREAM, etc.)
include /usr/share/dpkg/pkg-info.mk

# CEF upstream version without +ds suffix (e.g., "146.0.5" from "146.0.5+ds1-1")
# Used for library filenames (libcef.so.146.0.5) which reflect the actual CEF version.
# For tarball names (which include +ds), use DEB_VERSION_UPSTREAM directly.
CEF_VERSION := $(firstword $(subst +, ,$(DEB_VERSION_UPSTREAM)))
CEF_MAJOR := $(firstword $(subst ., ,$(CEF_VERSION)))

# Chromium version tracking (update when syncing with new Debian Chromium)
# To find current version: apt-cache show chromium | grep ^Version
CHROMIUM_VERSION := 147.0.7727.101

include /usr/share/dpkg/buildopts.mk
include /usr/share/dpkg/architecture.mk

# Architecture-specific variables for CEF build.
# Maps Debian arch names to CEF/LLVM/Node naming conventions.
ifeq ($(DEB_HOST_ARCH),amd64)
  CEF_ARCH_FLAG   := --x64-build
  CEF_DISTRIB_DIR := linux64
  GN_BUILDTOOLS   := linux64
  GN_CPU          := x64
  LLVM_TRIPLE     := x86_64-unknown-linux-gnu
  LLVM_ARCH       := x86_64
  NODE_ARCH       := x64
else ifeq ($(DEB_HOST_ARCH),arm64)
  CEF_ARCH_FLAG   := --arm64-build
  CEF_DISTRIB_DIR := linuxarm64
  GN_BUILDTOOLS   := linux-arm64
  GN_CPU          := arm64
  LLVM_TRIPLE     := aarch64-unknown-linux-gnu
  LLVM_ARCH       := aarch64
  NODE_ARCH       := arm64
else ifeq ($(DEB_HOST_ARCH),armhf)
  CEF_ARCH_FLAG   := --arm-build
  CEF_DISTRIB_DIR := linuxarm
  GN_BUILDTOOLS   := linux-arm
  GN_CPU          := arm
  LLVM_TRIPLE     := armv7-unknown-linux-gnueabihf
  LLVM_ARCH       := arm
  NODE_ARCH       := arm
else
  $(error Unsupported architecture: $(DEB_HOST_ARCH). CEF supports amd64, arm64, armhf.)
endif

# Disable dpkg LTO flags -- CEF uses GN's use_thin_lto flag instead
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
export DEB_RULES_REQUIRES_ROOT = no
export DEBIAN_BUILD = 1

## ============================================================================
## RAM-BASED PARALLEL JOB LIMITING
## ============================================================================
## CEF/Chromium compilation requires ~3GB RAM per parallel job. Without limiting,
## ninja uses all CPU cores which can exhaust RAM and trigger OOM killer.
##
## This follows established Debian patterns:
## - llvm-toolchain-19: https://sources.debian.org/src/llvm-toolchain-19/1:19.1.4-1/debian/rules/#L92
## - polymake (4GB/job): https://sources.debian.org/src/polymake/4.12-3/debian/rules/?hl=15#L15
## - Pending debhelper MR: https://salsa.debian.org/debian/debhelper/-/merge_requests/128
##
## Behavior:
## - Respects DEB_BUILD_OPTIONS=parallel=N if set (never increases beyond it)
## - Calculates safe jobs based on available RAM (~3GB per job)
## - Uses the minimum of requested and RAM-safe values
## - Considers cgroup memory limits for containerized builds (buildds)
## ============================================================================

# RAM required per compilation job (in MB) - conservative estimate for Chromium
# Increased to 4GB to account for linking phases (libcef.so linking needs ~8GB alone)
# and to leave headroom for system processes to avoid OOM killer
CEF_RAM_PER_JOB_MB := 4096

# Get requested parallelism from DEB_BUILD_OPTIONS (via buildopts.mk) or nproc
ifdef DEB_BUILD_OPTION_PARALLEL
    REQUESTED_JOBS := $(DEB_BUILD_OPTION_PARALLEL)
else
    REQUESTED_JOBS := $(shell nproc 2>/dev/null || echo 1)
endif

# Calculate RAM-based limit, considering cgroup limits for containerized builds
# Check cgroup v2 first, then v1, then fall back to /proc/meminfo
MEM_LIMIT_BYTES := $(shell cat /sys/fs/cgroup/memory.max 2>/dev/null | grep -v max || \
                          cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null || \
                          echo 0)
MEM_TOTAL_KB := $(shell awk '/MemTotal/ {print $$2}' /proc/meminfo 2>/dev/null || echo 0)

# Reserved memory for system processes (kernel, desktop, etc.)
# This prevents OOM killer from terminating unrelated processes during build
CEF_SYSTEM_RESERVE_MB := 8192

# Use cgroup limit if set and smaller than total RAM, otherwise use total RAM
# Convert to MB for calculation, then subtract system reserve
RAM_AVAILABLE_MB := $(shell \
    cgroup_mb=$$(($(MEM_LIMIT_BYTES) / 1024 / 1024)); \
    total_mb=$$(($(MEM_TOTAL_KB) / 1024)); \
    reserve=$(CEF_SYSTEM_RESERVE_MB); \
    if [ "$$cgroup_mb" -gt 0 ] && [ "$$cgroup_mb" -lt "$$total_mb" ] 2>/dev/null; then \
        available=$$((cgroup_mb - reserve)); \
    else \
        available=$$((total_mb - reserve)); \
    fi; \
    [ "$$available" -lt 4096 ] && available=4096; \
    echo "$$available")

# Calculate safe number of jobs based on RAM
RAM_SAFE_JOBS := $(shell \
    jobs=$$(($(RAM_AVAILABLE_MB) / $(CEF_RAM_PER_JOB_MB))); \
    [ "$$jobs" -lt 1 ] && jobs=1; \
    echo "$$jobs")

# Use the lesser of requested and RAM-safe (never increase beyond requested)
NINJA_JOBS := $(shell \
    if [ "$(REQUESTED_JOBS)" -lt "$(RAM_SAFE_JOBS)" ] 2>/dev/null; then \
        echo "$(REQUESTED_JOBS)"; \
    else \
        echo "$(RAM_SAFE_JOBS)"; \
    fi)

# Debug output (visible in build logs)
$(info CEF Build: RAM=$(RAM_AVAILABLE_MB)MB, Requested=$(REQUESTED_JOBS) jobs, RAM-safe=$(RAM_SAFE_JOBS) jobs, Using=$(NINJA_JOBS) jobs)

# Enable unstable Rust features with stable rustc (from Debian chromium line 67)
# Chromium uses -Z flags (nightly-only) but Debian only provides stable rustc
# RUSTC_BOOTSTRAP=1 tells rustc to allow nightly features on stable compiler
export RUSTC_BOOTSTRAP = 1

# Compiler toolchain (from Debian chromium lines 34-37)
# Align with Debian Chromium configuration (uses clang-19)
export AR = ar
export NM = nm
export CC = clang-19
export CXX = clang++-19

# Debian hardening flags (from Debian Chromium lines 39-42)
# Strip -g from CXXFLAGS to avoid debug info bloating libcef.so (~260MB)
export DEB_CXXFLAGS_MAINT_STRIP=-g

# Standard build flags with system libc++ support
# These are read by CEF's unbundle toolchain (patch 0011) at GN parse time
# via getenv() to enable system libc++ (use_custom_libcxx=false)
export CXXFLAGS:=$(shell dpkg-buildflags --get CXXFLAGS) -stdlib=libc++ \
	-Wno-conversion -Wno-unused-function -Wno-unused-variable \
	-Wno-unused-private-field -Wno-deprecated-declarations -Wno-unknown-pragmas \
	-fno-delete-null-pointer-checks
export LDFLAGS:=$(shell dpkg-buildflags --get LDFLAGS) -stdlib=libc++ -static-libstdc++
# More verbose linker output (matches Debian Chromium)
export LDFLAGS+=-Wl,--stats

# Rust toolchain configuration (from Debian chromium lines 66-74)
# Use system Rust instead of downloading from GCS
# Symlinks for clang-19 are set up at lines 380+
CLANG_MVERS := 19
rust_sysroot = /usr
export GN_DEFINES += rust_sysroot_absolute=\"$(rust_sysroot)\"
export GN_DEFINES += rust_bindgen_root=\"/usr\"
export GN_DEFINES += rustc_version=\"$(shell $(rust_sysroot)/bin/rustc --version 2>/dev/null | awk -v OFS='-' '{print $$1,$$2}')\"
export GN_DEFINES += clang_base_path=\"/usr/lib/llvm-$(CLANG_MVERS)\"
export GN_DEFINES += clang_version=\"$(CLANG_MVERS)\"


# CEF build configuration
export GN_DEFINES += target_cpu=\"$(GN_CPU)\"
export GN_DEFINES += enable_cef=true
export GN_DEFINES += cef_build_tests=false
export GN_DEFINES += is_debug=false
# is_official_build enables size optimizations (identical to Debian Chromium)
export GN_DEFINES += is_official_build=true
export GN_DEFINES += symbol_level=0

# Debian toolchain: system libc++, no sysroot, no bundled tools
export GN_DEFINES += use_custom_libcxx=false
export GN_DEFINES += use_sysroot=false
export GN_DEFINES += treat_warnings_as_errors=false
export GN_DEFINES += is_cfi=false
export GN_DEFINES += chrome_pgo_phase=0
export GN_DEFINES += use_thin_lto=false
export GN_DEFINES += toolchain_supports_rust_thin_lto=false
export GN_DEFINES += clang_warning_suppression_file=\"\"
export GN_DEFINES += custom_toolchain=\"//build/toolchain/linux/unbundle:default\"
export GN_DEFINES += host_toolchain=\"//build/toolchain/linux/unbundle:default\"

# System libraries
export GN_DEFINES += use_system_zlib=true
export GN_DEFINES += use_system_lcms2=true
export GN_DEFINES += use_system_libjpeg=true
export GN_DEFINES += use_system_libpng=true
export GN_DEFINES += use_system_freetype=true
export GN_DEFINES += use_system_harfbuzz=true
export GN_DEFINES += use_system_libopenjpeg2=true

# CEF required args (from gn_args.py GetRequiredArgs, enforced by assert in BUILD.gn)
export GN_DEFINES += enable_widevine=true
export GN_DEFINES += clang_use_chrome_plugins=false
export GN_DEFINES += enable_linux_installer=false

# CEF recommended defaults (from gn_args.py GetRecommendedDefaultArgs)
export GN_DEFINES += is_component_build=false
export GN_DEFINES += enable_background_mode=false
export GN_DEFINES += enable_resource_allowlist_generation=false
export GN_DEFINES += enable_downgrade_processing=false
export GN_DEFINES += blink_heap_inside_shared_library=true

# Enabled features (matching Debian Chromium)
export GN_DEFINES += use_gio=true
export GN_DEFINES += use_pulseaudio=true
export GN_DEFINES += link_pulseaudio=true
export GN_DEFINES += rtc_use_pipewire=true
export GN_DEFINES += v8_enable_backtrace=true
export GN_DEFINES += angle_has_histograms=false

# Disable unused features
export GN_DEFINES += enable_vr=false
export GN_DEFINES += enable_hangout_services_extension=false
export GN_DEFINES += build_dawn_tests=false
export GN_DEFINES += angle_build_tests=false
export GN_DEFINES += build_angle_perftests=false
export GN_DEFINES += enable_iterator_debugging=false
export GN_DEFINES += safe_browsing_use_unrar=false
export GN_DEFINES += optimize_webui=false
export GN_DEFINES += use_remoteexec=false
export GN_DEFINES += use_siso=false
export GN_DEFINES += supports_subzero=false

# LiteRT/TFLite: Disable WebNN TFLite backend (litert src stripped from Debian tarball)
export GN_DEFINES += webnn_use_tflite=false
export GN_DEFINES += build_tflite_with_xnnpack=false

# Official build extras (from CEF gn_args.py GetConfigArgs)
export GN_DEFINES += disable_fieldtrial_testing_config=true
export GN_DEFINES += use_partition_alloc_as_malloc=false
export GN_DEFINES += enable_backup_ref_ptr_support=false

## ============================================================================
## LIBC++ CONFIGURATION: System libc++ via Custom Unbundle Toolchain
## ============================================================================
## Uses SYSTEM libc++ (use_custom_libcxx=false) instead of bundled.
##
## How It Works:
## 1. debian/rules exports DEBIAN_BUILD=1 and CXXFLAGS/LDFLAGS with -stdlib=libc++
## 2. CEF patch 0005 adds GetDebianArgs() to cef/tools/gn_args.py
## 3. GetDebianArgs() detects DEBIAN_BUILD=1, injects custom_toolchain
## 4. GN selects //cef/toolchain/linux/debian:default
## 5. Toolchain reads CXXFLAGS/LDFLAGS via getenv() at GN parse time
## 6. Toolchain sets use_custom_libcxx=false in toolchain_args
## 7. Build uses system libc++-19 (/usr/lib/llvm-19/lib/libc++.so.1)
##
## Based on Debian Chromium's unbundle toolchain approach.
## ============================================================================

# CEF branch (derived from CHROMIUM_VERSION - 3rd component: 146.0.7680.153 -> 7680)
CEF_BRANCH := $(word 3,$(subst ., ,$(CHROMIUM_VERSION)))

%:
	dh $@

override_dh_auto_configure:
	# Configuration is handled in override_dh_auto_build (gn gen)
	@echo "CEF build will be configured by gn gen in build step"

override_dh_dwz:
	# Skip dwz - Chromium uses DWARF5 debug info with .debug_str_offsets
	# sections that dwz doesn't understand
	@echo "Skipping dwz (incompatible DWARF5 debug info)"

## ============================================================================
## BUILD PROCESS DOCUMENTATION
## ============================================================================
## This build has 3 main challenges requiring the complex steps below:
##
## 1. EXEC_SCRIPT RESTRICTION FIX
##    - Problem: CEF uses exec_script in BUILD.gn (security-restricted by GN)
##    - Solution: setup-build patches .gn to add //cef/BUILD.gn to exec_script_allowlist
##
## 2. STUB BUILD.GN FILES (18 custom stubs + 17 upstream unbundle)
##    - Problem: GN requires BUILD.gn files for all dependencies during configuration
##    - Challenge: Debian strips bundled third-party sources per policy
##    - Solution: Install stub BUILD.gn files with group() or source_set() targets
##
## 3. GIT REPOSITORY REQUIREMENTS
##    - Problem: patcher.py and make_distrib.py expect git repositories
##    - Challenge: Debian source packages are not git repositories
##    - Solution: Initialize temporary git repos (setup-source steps 2 and 8)
## ============================================================================

override_dh_auto_build:
	# Phase 1: Assemble source tree from MUT tarballs and apply all patches
	debian/scripts/setup-source $(CURDIR) $(CHROMIUM_VERSION) $(NODE_ARCH)

	# Phase 2: Install stubs, symlinks, and toolchain wrappers
	debian/scripts/setup-build $(CURDIR) $(DEB_HOST_MULTIARCH) $(LLVM_TRIPLE) $(LLVM_ARCH) $(NODE_ARCH) $(CLANG_MVERS)

	## Phase 3: Build CEF (direct gn/ninja)
	## Like Debian Chromium, we call system /usr/bin/gn and /usr/bin/ninja directly.

	# 3a. Create rust-toolchain VERSION stub and symlinks
	@echo "==> Creating rust-toolchain stubs for system Rust"
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin
	@# VERSION is checked by Chromium's build system; generate from system rustc
	@rustc --version | sed 's/$$/ (system)/' > $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/VERSION
	@ln -sf /usr/bin/rustc $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/rustc
	@ln -sf /usr/bin/bindgen $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/bindgen
	@ln -sf /usr/bin/rustfmt $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/rustfmt

	# 3b. Run version_manager.py (generates CEF version/API headers)
	@echo "==> Running CEF version_manager.py"
	cd $(CURDIR)/chromium_src/chromium/src/cef && python3 tools/version_manager.py -u --fast-check

	# 3c. Write args.gn directly (GN_DEFINES defined at top of rules file)
	@echo "==> Writing out/Release_GN_$(GN_CPU)/args.gn"
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/out/Release_GN_$(GN_CPU)
	@echo '$(GN_DEFINES)' | tr ' ' '\n' | sed 's/\\"/"/g' > $(CURDIR)/chromium_src/chromium/src/out/Release_GN_$(GN_CPU)/args.gn

	# 3d. Run gn gen (system /usr/bin/gn from generate-ninja package)
	@echo "==> Running gn gen out/Release_GN_$(GN_CPU)"
	cd $(CURDIR)/chromium_src/chromium/src && \
	PATH=/usr/lib/llvm-$(CLANG_MVERS)/bin:$$PATH \
	/usr/bin/gn gen out/Release_GN_$(GN_CPU)

	# 3e. Run ninja (system /usr/bin/ninja from ninja-build package)
	@echo "==> Building CEF with ninja -j$(NINJA_JOBS)"
	cd $(CURDIR)/chromium_src/chromium/src && \
	export CC=clang-$(CLANG_MVERS) && \
	export CXX=clang++-$(CLANG_MVERS) && \
	export AR=ar && export NM=nm && \
	export RUSTC_BOOTSTRAP=1 && \
	export PATH=/usr/lib/llvm-$(CLANG_MVERS)/bin:$$PATH && \
	export LIBCLANG_PATH=/usr/lib/llvm-$(CLANG_MVERS)/lib && \
	/usr/bin/ninja -j$(NINJA_JOBS) -C out/Release_GN_$(GN_CPU) libcef chrome_sandbox

	# 3f. Run make_distrib.py (creates binary_distrib/ for packaging)
	# Re-init git in cef/ -- make_distrib.py requires git.is_checkout().
	@cd $(CURDIR)/chromium_src/chromium/src/cef && \
		git init -q && git add -A && git commit --no-gpg-sign -q -m "CEF" 2>/dev/null || true
	@echo "==> Creating CEF distribution"
	cd $(CURDIR)/chromium_src/chromium/src/cef && \
	python3 tools/make_distrib.py \
		--output-dir=$(CURDIR)/chromium_src/chromium/src/cef/binary_distrib \
		--allow-partial --ninja-build --no-format \
		$(CEF_ARCH_FLAG) --minimal

override_dh_auto_install:
	# Create package directories first
	mkdir -p $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)
	mkdir -p $(CURDIR)/debian/libcef-dev/usr/include
	mkdir -p $(CURDIR)/debian/libcef-common/usr/share/cef

	# Install libcef.so (use _$(CEF_DISTRIB_DIR)_minimal pattern for minimal-only distribution)
	install -m644 chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/libcef.so \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_VERSION)

	# Add RPATH for CEF's private ANGLE libraries (libEGL.so, libGLESv2.so)
	# These are Google's ANGLE implementation (OpenGL ES on Vulkan), NOT Mesa.
	# Debian policy allows RPATH for private shared libraries in /usr/lib/<package>/
	# See: https://wiki.debian.org/RpathIssue
	# The ANGLE libraries must be in a separate directory to avoid conflicts with system Mesa.
	# libcef.so already has $ORIGIN RUNPATH from upstream, we append the CEF private lib dir.
	patchelf --set-rpath '$$ORIGIN:/usr/lib/$(DEB_HOST_MULTIARCH)/cef' \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_VERSION)

	# Fix SONAME for proper library versioning (upstream uses unversioned "libcef.so")
	# This ensures proper library dependency tracking and ldconfig symlink creation
	patchelf --set-soname libcef.so.$(CEF_MAJOR) \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_VERSION)

	# Create soname symlink
	ln -s libcef.so.$(CEF_VERSION) \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_MAJOR)

	# Install headers (use _$(CEF_DISTRIB_DIR)_minimal pattern for minimal-only distribution)
	mkdir -p $(CURDIR)/debian/libcef-dev/usr/include/
	cp -r chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/include \
		$(CURDIR)/debian/libcef-dev/usr/include/cef

	# Install cmake config files if they exist (use _$(CEF_DISTRIB_DIR)_minimal pattern)
	if [ -d chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/cmake ]; then \
		mkdir -p $(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/cef/; \
		cp -r chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/cmake/* \
			$(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/cef/; \
	fi
	# Install Debian-specific CMake paths file so downstream packages know
	# where resources live without hardcoding /usr/share/cef.
	# Applications must pass these to CefSettings.resources_dir_path / locales_dir_path.
	printf '%s\n' \
		'# Debian CEF resource paths' \
		'set(CEF_RESOURCES_DIR "/usr/share/cef")' \
		'set(CEF_LOCALES_DIR   "/usr/share/cef/locales")' \
		> $(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/cef/cef-debian-paths.cmake

	# Install resources (PAK files) - use _$(CEF_DISTRIB_DIR)_minimal pattern
	# PAK files are in Resources/ directory, NOT Release/
	mkdir -p $(CURDIR)/debian/libcef-common/usr/share/cef/
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/*.pak \
		$(CURDIR)/debian/libcef-common/usr/share/cef/

	# Install ICU data file (CRITICAL for internationalization) - use _$(CEF_DISTRIB_DIR)_minimal pattern
	# icudtl.dat is in Resources/ directory, NOT Release/
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/icudtl.dat \
		$(CURDIR)/debian/libcef-common/usr/share/cef/

	# Install V8 context snapshot (required for JavaScript execution)
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/v8_context_snapshot.bin \
		$(CURDIR)/debian/libcef-common/usr/share/cef/

	# Install locales - use _$(CEF_DISTRIB_DIR)_minimal pattern
	# Locales are in Resources/ directory, NOT Release/
	if [ -d chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/locales ]; then \
		mkdir -p $(CURDIR)/debian/libcef-common/usr/share/cef/locales/; \
		cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/locales/*.pak \
			$(CURDIR)/debian/libcef-common/usr/share/cef/locales/; \
	fi

	# Install other required libraries from Release directory
	# Skip libvulkan.so (conflicts with system libvulkan1 package)
	# Note: libEGL.so and libGLESv2.so are ANGLE libraries (NOT Mesa) - installed separately below
	for lib in chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/*.so*; do \
		libname="$$(basename $$lib)"; \
		if [ -f "$$lib" ] && [ "$$libname" != "libcef.so" ] && \
		   ! echo "$$libname" | grep -qE '^lib(EGL|GLESv2|vulkan)\.so'; then \
			install -D -m644 "$$lib" \
				"$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/$$libname"; \
		fi \
	done

	# Install ANGLE libraries (libEGL.so, libGLESv2.so) to CEF-specific directory
	# These are Google's ANGLE implementation (OpenGL ES on Vulkan), NOT Mesa.
	# CEF's GPU process requires these specific ANGLE libraries for hardware acceleration.
	# Installing to /usr/lib/$(DEB_HOST_MULTIARCH)/cef/ avoids conflicts with system Mesa (libegl1, libgles2).
	# Applications using CEF should set LD_LIBRARY_PATH or use rpath to find these.
	mkdir -p $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/cef/
	for lib in chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/libEGL.so \
	           chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/libGLESv2.so; do \
		if [ -f "$$lib" ]; then \
			install -m644 "$$lib" $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/cef/; \
		fi \
	done

	# Install SwiftShader Vulkan ICD config (for software rendering fallback)
	# Generate with absolute path instead of relative path (original has ./libvk_swiftshader.so)
	# This is needed for Vulkan loader to find the library from any working directory
	mkdir -p $(CURDIR)/debian/libcef147/usr/share/vulkan/icd.d/
	echo '{"file_format_version": "1.0.0", "ICD": {"library_path": "/usr/lib/$(DEB_HOST_MULTIARCH)/libvk_swiftshader.so", "api_version": "1.0.5"}}' \
		> $(CURDIR)/debian/libcef147/usr/share/vulkan/icd.d/vk_swiftshader_icd.json

	# chrome-sandbox: CEF looks for it next to libcef.so (via dladdr/DIR_ASSETS).
	# We depend on chromium-sandbox and symlink to it.
	ln -s /usr/lib/chromium/chrome-sandbox \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/chrome-sandbox

	# ANGLE library version symlinks (CEF's dlopen looks for versioned sonames)
	ln -s libEGL.so $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/cef/libEGL.so.1
	ln -s libGLESv2.so $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/cef/libGLESv2.so.2

	# Dev symlink for -lcef linking
	mkdir -p $(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)
	ln -s libcef.so.$(CEF_MAJOR) \
		$(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so

override_dh_auto_test:
	# Skip tests for now - CEF tests require X display
	@echo "Skipping CEF tests (require X display)"

override_dh_auto_clean:
	rm -rf chromium_src/
	rm -rf .pc
	rm -rf depot_tools/
	dh_auto_clean
