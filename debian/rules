#!/usr/bin/make -f

# Get package version from debian/changelog (provides DEB_VERSION_UPSTREAM, etc.)
include /usr/share/dpkg/pkg-info.mk

# CEF upstream version without +ds suffix (e.g., "146.0.5" from "146.0.5+ds1-1")
# Used for library filenames (libcef.so.146.0.5) which reflect the actual CEF version.
# For tarball names (which include +ds), use DEB_VERSION_UPSTREAM directly.
CEF_VERSION := $(firstword $(subst +, ,$(DEB_VERSION_UPSTREAM)))
CEF_MAJOR := $(firstword $(subst ., ,$(CEF_VERSION)))

# Chromium version tracking (update when syncing with new Debian Chromium)
# To find current version: apt-cache show chromium | grep ^Version
CHROMIUM_VERSION := 147.0.7727.101

include /usr/share/dpkg/buildopts.mk
include /usr/share/dpkg/architecture.mk

# Architecture-specific variables for CEF build.
# Maps Debian arch names to CEF/LLVM/Node naming conventions.
ifeq ($(DEB_HOST_ARCH),amd64)
  CEF_ARCH_FLAG   := --x64-build
  CEF_DISTRIB_DIR := linux64
  GN_BUILDTOOLS   := linux64
  GN_CPU          := x64
  LLVM_TRIPLE     := x86_64-unknown-linux-gnu
  LLVM_ARCH       := x86_64
  NODE_ARCH       := x64
else ifeq ($(DEB_HOST_ARCH),arm64)
  CEF_ARCH_FLAG   := --arm64-build
  CEF_DISTRIB_DIR := linuxarm64
  GN_BUILDTOOLS   := linux-arm64
  GN_CPU          := arm64
  LLVM_TRIPLE     := aarch64-unknown-linux-gnu
  LLVM_ARCH       := aarch64
  NODE_ARCH       := arm64
else ifeq ($(DEB_HOST_ARCH),armhf)
  CEF_ARCH_FLAG   := --arm-build
  CEF_DISTRIB_DIR := linuxarm
  GN_BUILDTOOLS   := linux-arm
  GN_CPU          := arm
  LLVM_TRIPLE     := armv7-unknown-linux-gnueabihf
  LLVM_ARCH       := arm
  NODE_ARCH       := arm
else
  $(error Unsupported architecture: $(DEB_HOST_ARCH). CEF supports amd64, arm64, armhf.)
endif

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEBIAN_BUILD = 1

## ============================================================================
## RAM-BASED PARALLEL JOB LIMITING
## ============================================================================
## CEF/Chromium compilation requires ~3GB RAM per parallel job. Without limiting,
## ninja uses all CPU cores which can exhaust RAM and trigger OOM killer.
##
## This follows established Debian patterns:
## - llvm-toolchain-19: https://sources.debian.org/src/llvm-toolchain-19/1:19.1.4-1/debian/rules/#L92
## - polymake (4GB/job): https://sources.debian.org/src/polymake/4.12-3/debian/rules/?hl=15#L15
## - Pending debhelper MR: https://salsa.debian.org/debian/debhelper/-/merge_requests/128
##
## Behavior:
## - Respects DEB_BUILD_OPTIONS=parallel=N if set (never increases beyond it)
## - Calculates safe jobs based on available RAM (~3GB per job)
## - Uses the minimum of requested and RAM-safe values
## - Considers cgroup memory limits for containerized builds (buildds)
## ============================================================================

# RAM required per compilation job (in MB) - conservative estimate for Chromium
# Increased to 4GB to account for linking phases (libcef.so linking needs ~8GB alone)
# and to leave headroom for system processes to avoid OOM killer
CEF_RAM_PER_JOB_MB := 4096

# Get requested parallelism from DEB_BUILD_OPTIONS (via buildopts.mk) or nproc
ifdef DEB_BUILD_OPTION_PARALLEL
    REQUESTED_JOBS := $(DEB_BUILD_OPTION_PARALLEL)
else
    REQUESTED_JOBS := $(shell nproc 2>/dev/null || echo 1)
endif

# Calculate RAM-based limit, considering cgroup limits for containerized builds
# Check cgroup v2 first, then v1, then fall back to /proc/meminfo
MEM_LIMIT_BYTES := $(shell cat /sys/fs/cgroup/memory.max 2>/dev/null | grep -v max || \
                          cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null || \
                          echo 0)
MEM_TOTAL_KB := $(shell awk '/MemTotal/ {print $$2}' /proc/meminfo 2>/dev/null || echo 0)

# Reserved memory for system processes (kernel, desktop, Claude, etc.)
# This prevents OOM killer from terminating unrelated processes during build
CEF_SYSTEM_RESERVE_MB := 8192

# Use cgroup limit if set and smaller than total RAM, otherwise use total RAM
# Convert to MB for calculation, then subtract system reserve
RAM_AVAILABLE_MB := $(shell \
    cgroup_mb=$$(($(MEM_LIMIT_BYTES) / 1024 / 1024)); \
    total_mb=$$(($(MEM_TOTAL_KB) / 1024)); \
    reserve=$(CEF_SYSTEM_RESERVE_MB); \
    if [ "$$cgroup_mb" -gt 0 ] && [ "$$cgroup_mb" -lt "$$total_mb" ] 2>/dev/null; then \
        available=$$((cgroup_mb - reserve)); \
    else \
        available=$$((total_mb - reserve)); \
    fi; \
    [ "$$available" -lt 4096 ] && available=4096; \
    echo "$$available")

# Calculate safe number of jobs based on RAM
RAM_SAFE_JOBS := $(shell \
    jobs=$$(($(RAM_AVAILABLE_MB) / $(CEF_RAM_PER_JOB_MB))); \
    [ "$$jobs" -lt 1 ] && jobs=1; \
    echo "$$jobs")

# Use the lesser of requested and RAM-safe (never increase beyond requested)
NINJA_JOBS := $(shell \
    if [ "$(REQUESTED_JOBS)" -lt "$(RAM_SAFE_JOBS)" ] 2>/dev/null; then \
        echo "$(REQUESTED_JOBS)"; \
    else \
        echo "$(RAM_SAFE_JOBS)"; \
    fi)

# Calculate the offset needed for autoninja's NINJA_CORE_ADDITION
# autoninja.py calculates: j_value = num_cores + NINJA_CORE_ADDITION (default +2)
# We want: j_value = NINJA_JOBS (our RAM-safe value)
# So: NINJA_CORE_ADDITION = NINJA_JOBS - num_cores
# Note: nproc is from coreutils (Essential package, always available)
NUM_CORES := $(shell nproc 2>/dev/null || echo 1)
CORE_ADDITION := $(shell echo $$(($(NINJA_JOBS) - $(NUM_CORES))))
export NINJA_CORE_ADDITION := $(CORE_ADDITION)

# Debug output (visible in build logs)
$(info CEF Build: RAM=$(RAM_AVAILABLE_MB)MB, Requested=$(REQUESTED_JOBS) jobs, RAM-safe=$(RAM_SAFE_JOBS) jobs, Using=$(NINJA_JOBS) jobs, NINJA_CORE_ADDITION=$(CORE_ADDITION))

# Enable unstable Rust features with stable rustc (from Debian chromium line 67)
# Chromium uses -Z flags (nightly-only) but Debian only provides stable rustc
# RUSTC_BOOTSTRAP=1 tells rustc to allow nightly features on stable compiler
export RUSTC_BOOTSTRAP = 1

# Compiler toolchain (from Debian chromium lines 34-37)
# Align with Debian Chromium configuration (uses clang-19)
export AR = ar
export NM = nm
export CC = clang-19
export CXX = clang++-19

# Debian hardening flags (from Debian Chromium lines 39-42)
# Strip -g from both CFLAGS and CXXFLAGS to avoid debug info bloating libcef.so
export DEB_CFLAGS_MAINT_STRIP=-g
export DEB_CXXFLAGS_MAINT_STRIP=-g

# Standard build flags with system libc++ support
# These are read by CEF's unbundle toolchain (patch 0011) at GN parse time
# via getenv() to enable system libc++ (use_custom_libcxx=false)
export CXXFLAGS:=$(shell dpkg-buildflags --get CXXFLAGS) -stdlib=libc++
export LDFLAGS:=$(shell dpkg-buildflags --get LDFLAGS) -stdlib=libc++

# Rust toolchain configuration (from Debian chromium lines 66-74)
# Use system Rust instead of downloading from GCS
# Symlinks for clang-19 are set up at lines 380+
CLANG_MVERS := 19
rust_sysroot = /usr
export GN_DEFINES += rust_sysroot_absolute=\"$(rust_sysroot)\"
export GN_DEFINES += rust_bindgen_root=\"/usr\"
export GN_DEFINES += rustc_version=\"$(shell $(rust_sysroot)/bin/rustc --version 2>/dev/null | awk -v OFS='-' '{print $$1,$$2}')\"
export GN_DEFINES += clang_base_path=\"/usr/lib/llvm-$(CLANG_MVERS)\"
export GN_DEFINES += clang_version=\"$(CLANG_MVERS)\"


# CEF build configuration
export GN_DEFINES += target_cpu=\"$(GN_CPU)\"
export GN_DEFINES += enable_cef=true
export GN_DEFINES += cef_build_tests=false
export GN_DEFINES += is_debug=false
export GN_DEFINES += is_official_build=true
export GN_DEFINES += symbol_level=0

# Debian toolchain: system libc++, no sysroot, no bundled tools
export GN_DEFINES += use_custom_libcxx=false
export GN_DEFINES += use_sysroot=false
export GN_DEFINES += treat_warnings_as_errors=false
export GN_DEFINES += is_cfi=false
export GN_DEFINES += chrome_pgo_phase=0
export GN_DEFINES += use_thin_lto=false
export GN_DEFINES += custom_toolchain=\"//build/toolchain/linux/unbundle:default\"
export GN_DEFINES += host_toolchain=\"//build/toolchain/linux/unbundle:default\"

# System libraries
export GN_DEFINES += use_system_zlib=true
export GN_DEFINES += use_system_lcms2=true
export GN_DEFINES += use_system_libjpeg=true
export GN_DEFINES += use_system_libpng=true
export GN_DEFINES += use_system_freetype=true
export GN_DEFINES += use_system_harfbuzz=true
export GN_DEFINES += use_system_libopenjpeg2=true

# CEF required args (from gn_args.py GetRequiredArgs, enforced by assert in BUILD.gn)
export GN_DEFINES += enable_widevine=true
export GN_DEFINES += clang_use_chrome_plugins=false
export GN_DEFINES += enable_linux_installer=false

# CEF recommended defaults (from gn_args.py GetRecommendedDefaultArgs)
export GN_DEFINES += is_component_build=false
export GN_DEFINES += enable_background_mode=false
export GN_DEFINES += enable_resource_allowlist_generation=false
export GN_DEFINES += enable_downgrade_processing=false
export GN_DEFINES += blink_heap_inside_shared_library=true

# Disable unused features
export GN_DEFINES += enable_vr=false
export GN_DEFINES += enable_hangout_services_extension=false
export GN_DEFINES += build_dawn_tests=false
export GN_DEFINES += angle_build_tests=false
export GN_DEFINES += build_angle_perftests=false
export GN_DEFINES += enable_iterator_debugging=false
export GN_DEFINES += safe_browsing_use_unrar=false
export GN_DEFINES += optimize_webui=false
export GN_DEFINES += use_remoteexec=false
export GN_DEFINES += use_siso=false
export GN_DEFINES += supports_subzero=false

# LiteRT/TFLite: Disable WebNN TFLite backend (litert src stripped from Debian tarball)
export GN_DEFINES += webnn_use_tflite=false
export GN_DEFINES += build_tflite_with_xnnpack=false

# Official build extras (from CEF gn_args.py GetConfigArgs)
export GN_DEFINES += disable_fieldtrial_testing_config=true
export GN_DEFINES += use_partition_alloc_as_malloc=false
export GN_DEFINES += enable_backup_ref_ptr_support=false

## ============================================================================
## LIBC++ CONFIGURATION: System libc++ via Custom Unbundle Toolchain
## ============================================================================
## Uses SYSTEM libc++ (use_custom_libcxx=false) instead of bundled.
##
## How It Works:
## 1. debian/rules exports DEBIAN_BUILD=1 and CXXFLAGS/LDFLAGS with -stdlib=libc++
## 2. CEF patch 0005 adds GetDebianArgs() to cef/tools/gn_args.py
## 3. GetDebianArgs() detects DEBIAN_BUILD=1, injects custom_toolchain
## 4. GN selects //cef/toolchain/linux/debian:default
## 5. Toolchain reads CXXFLAGS/LDFLAGS via getenv() at GN parse time
## 6. Toolchain sets use_custom_libcxx=false in toolchain_args
## 7. Build uses system libc++-19 (/usr/lib/llvm-19/lib/libc++.so.1)
##
## Based on Debian Chromium's unbundle toolchain approach.
## ============================================================================

# CEF branch (derived from CHROMIUM_VERSION - 3rd component: 146.0.7680.153 -> 7680)
CEF_BRANCH := $(word 3,$(subst ., ,$(CHROMIUM_VERSION)))

%:
	dh $@

override_dh_auto_configure:
	# Configuration is handled in override_dh_auto_build (gn gen)
	@echo "CEF build will be configured by gn gen in build step"

override_dh_dwz:
	# Skip dwz - Chromium uses DWARF5 debug info with .debug_str_offsets
	# sections that dwz doesn't understand
	@echo "Skipping dwz (incompatible DWARF5 debug info)"

## ============================================================================
## BUILD PROCESS DOCUMENTATION
## ============================================================================
## This build has 3 main challenges requiring the complex steps below:
##
## 1. EXEC_SCRIPT RESTRICTION FIX
##    - Problem: CEF uses exec_script in BUILD.gn (security-restricted by GN)
##    - Solution: Step 7b patches .gn to add //cef/BUILD.gn to exec_script_allowlist
##
## 2. STUB BUILD.GN FILES (32 stubs in debian/stubs/)
##    - Problem: GN requires BUILD.gn files for all dependencies during configuration
##    - Challenge: Debian strips bundled third-party sources per policy
##    - Solution: Install stub BUILD.gn files with group() or source_set() targets
##
## 3. GIT REPOSITORY REQUIREMENTS
##    - Problem: patcher.py and make_distrib.py expect git repositories
##    - Challenge: Debian source packages are not git repositories
##    - Solution: Initialize temporary git repos in Steps 3.5 and 6
## ============================================================================

override_dh_auto_build:
	## Step 1: Copy CEF source to build directory
	## NOTE: With MUT + quilt format, dpkg-source -x already applies CEF patches
	## The cef/ directory has patches already applied when we copy it
	mkdir -p $(CURDIR)/chromium_src
	cp -a $(CURDIR)/cef $(CURDIR)/chromium_src/

	# Step 2: Remove quilt .pc directory from copied source (cleanup only)
	rm -rf $(CURDIR)/chromium_src/cef/.pc

	# Step 3.5: Initialize CEF directory as git repository (required by patcher.py)
	@echo "==> Initializing git repository in CEF source"
	cd $(CURDIR)/chromium_src/cef && \
		git init && \
		git add . && \
		(git commit --no-gpg-sign -m "CEF source with Debian patches applied" || true)
	@echo "==> CEF git repository initialized"

	# Step 4: Fix version mismatch (CEF source may target different Chromium version)
	# The CEF orig tarball may reference a different Chromium version (e.g., 144.0.7559.133)
	# than the Chromium tarball we actually ship (e.g., 146.0.7680.153).
	# Match any version pattern in the chromium_checkout line.
	sed -i "s|'refs/tags/[0-9]\+\.[0-9]\+\.[0-9]\+\.[0-9]\+'|'refs/tags/$(CHROMIUM_VERSION)'|" \
		$(CURDIR)/chromium_src/cef/CHROMIUM_BUILD_COMPATIBILITY.txt

	# Step 5: Move Chromium source from MUT-extracted directory
	# MUT (Multiple Upstream Tarball) extracts orig-chromium.tar.xz to chromium/
	# The tarball has source at root level (base/, build/, chrome/, etc.)
	# CEF expects: chromium_src/chromium/src/
	# Use mv (not cp -a) to avoid reading/writing 5.6GB which fills page cache
	# Pre-MUT used tar -xf + mv approach; this matches that behavior
	@echo "==> Moving Chromium source from MUT-extracted directory"
	mkdir -p $(CURDIR)/chromium_src/chromium
	mv $(CURDIR)/chromium $(CURDIR)/chromium_src/chromium/src
	@echo "==> Chromium moved successfully"

	# Step 5.1: Apply CEF patches to vanilla Chromium (BEFORE Debian patches)
	# CEF's patcher.py applies ~111 patches designed for vanilla Chromium.
	# These MUST run before Debian Chromium patches (Step 5.3) to avoid conflicts.
	# patcher.py uses git apply, so we need a temporary git repo.
	@echo "==> Applying CEF patches to vanilla Chromium source"
	cd $(CURDIR)/chromium_src/chromium/src && \
		git init && \
		git config user.name "Debian Builder" && \
		git config user.email "builder@debian.org" && \
		git commit --no-gpg-sign --allow-empty -m "Vanilla Chromium source"
	cp -a $(CURDIR)/chromium_src/cef $(CURDIR)/chromium_src/chromium/src/cef
	cd $(CURDIR)/chromium_src/chromium/src/cef && \
		DEBIAN_BUILD=0 python3 tools/patcher.py || \
		echo "==> Some CEF patches failed (expected: targets stripped files like Windows/bundled libs)"
	# Re-apply context menu patch with fuzz (Chromium 147.0.7727.101 shifted lines)
	# git apply (used by patcher.py) doesn't support fuzz; patch(1) does.
	cd $(CURDIR)/chromium_src/chromium/src && \
		patch -p0 --fuzz=3 --forward --no-backup-if-mismatch \
		< cef/patch/patches/chrome_browser_context_menus.patch || true
	# Keep cef/ in chromium/src/ -- needed for gn gen, ninja, and make_distrib.py
	@echo "==> CEF patches applied to vanilla Chromium"

	# Step 5.2: Setup system Node.js and rollup (following Debian Chromium approach)
	# Source: debian/rules lines 186-191 from Debian Chromium package
	# This ensures devtools-frontend can use system rollup instead of bundled version
	@echo "==> Setting up system Node.js and rollup"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-$(NODE_ARCH)/bin
	-ln -sf /usr/bin/node $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-$(NODE_ARCH)/bin/node 2>/dev/null || true
	# use system rollup
	cp -ra /usr/share/nodejs/rollup $(CURDIR)/chromium_src/chromium/src/third_party/node/node_modules/
	-test -L $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules/rollup3 || \
		ln -s /usr/share/nodejs/rollup $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules/rollup3
	@echo "==> Node.js and rollup3 symlink created"

	# Step 5.3: Apply Debian Chromium patches on top of CEF-patched source
	# The MUT chromium tarball is vanilla - we need to apply Debian patches here
	# The chromium-debian/ MUT component contains Debian Chromium packaging
	# (patches, build configuration) from the Debian chromium source package
	@echo "==> Applying Debian Chromium patches for system integration"
	# Apply patches from series file in order, skipping arch/release-specific directories
	# Skipped: ppc64le/ loongarch64/ i386/ bookworm/ trixie/ bullseye/ (not relevant for this sid build)
	@cd $(CURDIR)/chromium_src/chromium/src && \
		grep -v '^\#' $(CURDIR)/chromium-debian/patches/series | grep -v '^\s*$$' | \
		grep -v '^ppc64le/' | grep -v '^loongarch64/' | grep -v '^i386/' | \
		grep -v '^bookworm/' | grep -v '^trixie/' | grep -v '^bullseye/' | \
		while read patch; do \
			echo "Applying $$patch"; \
			patch -p1 < "$(CURDIR)/chromium-debian/patches/$$patch" || { \
				echo "WARNING: Patch $$patch failed, continuing..."; \
			}; \
		done
	@echo "==> Debian Chromium patches applied successfully"

	# Step 6: Initialize git repository in chromium (required by make_distrib.py)
	@echo "==> Initializing git repository in chromium source"
	@echo "==> Removing all .git directories from chromium tree"
	find $(CURDIR)/chromium_src/chromium/src -type d -name '.git' -exec rm -rf {} + 2>/dev/null || true
	@echo "==> Creating new git repository in chromium/src"
	cd $(CURDIR)/chromium_src/chromium/src && \
		git init && \
		git config user.name "Debian Builder" && \
		git config user.email "builder@debian.org" && \
		git commit --no-gpg-sign --allow-empty -m "Initial chromium source from Debian tarball"
	@echo "==> Git repository initialized"

	# Step 6.3: Copy locale stub source to Chromium source tree
	# GN action() will compile it after gn gen
	@echo "==> Copying locale stub source to chromium/src/debian/"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/debian
	cp $(CURDIR)/chromium_src/cef/tools/debian_stubs/cef_locale_stub.cpp $(CURDIR)/chromium_src/chromium/src/debian/
	@echo "==> Locale stub source copied"

	# Step 6.5: Patch Chromium DEPS to disable git submodule checking
	# gclient runhooks calls GetSubmoduleDiff() when git_dependencies != 'DEPS'
	# Setting git_dependencies = 'DEPS' disables submodule checks (not needed for Debian builds)
	# Note: DEPS file uses SINGLE quotes around 'SYNC', not double quotes
	@echo "==> Patching chromium/src/DEPS to disable git submodule checks"
	@if [ -f $(CURDIR)/chromium_src/chromium/src/DEPS ]; then \
		sed -i "s/git_dependencies = 'SYNC'/git_dependencies = 'DEPS'/" \
			$(CURDIR)/chromium_src/chromium/src/DEPS && \
		echo "==> DEPS patched: git_dependencies set to 'DEPS'"; \
	else \
		echo "WARNING: DEPS file not found, skipping patch"; \
	fi
	# Step 6.7: Apply Debian-specific Chromium patches
	# These patches modify Chromium sources (not CEF), so they're in debian/patches/chromium/
	# and use .chromium.patch suffix to distinguish them from CEF patches.
	# Patch order is defined in debian/patches/chromium/series.
	@echo "==> Applying Debian Chromium patches from debian/patches/chromium/series"
	@cd $(CURDIR) && \
		grep -v '^\#' debian/patches/chromium/series | grep -v '^\s*$$' | \
		while read patch; do \
			echo "Applying $$patch"; \
			patch -p1 -d $(CURDIR)/chromium_src/chromium/src < "debian/patches/chromium/$$patch" || { \
				echo "ERROR: Patch $$patch failed"; \
				exit 1; \
			}; \
		done
	@echo "==> Debian Chromium patches applied"

	# Step 6.8: Additional DEPS fix for generate_location_tags hook
	# CEF's tarball_deps.patch doesn't include this hook, so we add it with sed
	@echo "==> Fixing generate_location_tags condition in DEPS"
	sed -i "s/'condition': 'generate_location_tags',/'condition': 'generate_location_tags and not source_tarball',/" \
		$(CURDIR)/chromium_src/chromium/src/DEPS
	@echo "==> generate_location_tags condition fixed"

	# Step 7.5: Install stub files for Debian-stripped directories
	# Stub sources are in debian/stubs/ -- see individual files for documentation
	@echo "==> Installing stub BUILD.gn/gni files from debian/stubs/"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/debian_stubs
	cp debian/stubs/stub_main.cc $(CURDIR)/chromium_src/chromium/src/third_party/debian_stubs/stub_main.cc
	# System library stubs (link to Debian system libraries via libs/pkg_config)
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/opus
	cp debian/stubs/opus.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/opus/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo
	cp debian/stubs/libjpeg_turbo.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg_turbo/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/libpng
	cp debian/stubs/libpng.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/libpng/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/fontconfig
	cp debian/stubs/fontconfig.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/fontconfig/BUILD.gn
	cp debian/stubs/fontconfig.gni $(CURDIR)/chromium_src/chromium/src/third_party/fontconfig/fontconfig.gni
	# NOTE: Do NOT mkdir for zlib - directory already exists with header files
	cp debian/stubs/zlib.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/zlib/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/zstd
	cp debian/stubs/zstd.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/zstd/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/flac
	cp debian/stubs/flac.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/flac/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/dav1d
	cp debian/stubs/dav1d.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/dav1d/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/openh264
	cp debian/stubs/openh264.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/openh264/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/libxslt
	cp debian/stubs/libxslt.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/libxslt/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/libsecret
	cp debian/stubs/libsecret.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/libsecret/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/base/third_party/double_conversion
	cp debian/stubs/double_conversion.BUILD.gn $(CURDIR)/chromium_src/chromium/src/base/third_party/double_conversion/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/angle/src/third_party/libXNVCtrl
	cp debian/stubs/libXNVCtrl.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/angle/src/third_party/libXNVCtrl/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/harfbuzz-ng
	cp debian/stubs/harfbuzz.gni $(CURDIR)/chromium_src/chromium/src/third_party/harfbuzz-ng/harfbuzz.gni
	cp debian/stubs/libjpeg.gni $(CURDIR)/chromium_src/chromium/src/third_party/libjpeg.gni
	cp debian/stubs/freetype.gni $(CURDIR)/chromium_src/chromium/src/build/config/freetype/freetype.gni
	# Stripped directory stubs (test tools, catapult, enterprise, etc.)
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry
	cp debian/stubs/catapult-telemetry.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/catapult/telemetry/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult/third_party/typ
	cp debian/stubs/catapult-typ.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/catapult/third_party/typ/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult/tracing/tracing
	cp debian/stubs/catapult-tracing-tracing.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/catapult/tracing/tracing/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult/tracing
	cp debian/stubs/catapult-tracing.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/catapult/tracing/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult
	cp debian/stubs/catapult.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/catapult/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/catapult/third_party/gsutil
	cp debian/stubs/catapult-gsutil.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/catapult/third_party/gsutil/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/enterprise_companion
	cp debian/stubs/enterprise_companion.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/enterprise_companion/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/updater
	cp debian/stubs/updater.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/updater/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/components/test/data/update_client/puffin_patch_test
	cp debian/stubs/puffin_patch_test.BUILD.gn $(CURDIR)/chromium_src/chromium/src/components/test/data/update_client/puffin_patch_test/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/swiftshader/tests/SystemUnitTests
	cp debian/stubs/swiftshader-SystemUnitTests.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/swiftshader/tests/SystemUnitTests/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/swiftshader/tests/ReactorUnitTests
	cp debian/stubs/swiftshader-ReactorUnitTests.BUILD.gn $(CURDIR)/chromium_src/chromium/src/third_party/swiftshader/tests/ReactorUnitTests/BUILD.gn
	mkdir -p $(CURDIR)/chromium_src/chromium/src/chrome/android/modules
	cp debian/stubs/android-modules-buildflags.gni $(CURDIR)/chromium_src/chromium/src/chrome/android/modules/buildflags.gni
	mkdir -p $(CURDIR)/chromium_src/chromium/src/buildtools
	cp debian/stubs/deps_revisions.gni $(CURDIR)/chromium_src/chromium/src/buildtools/deps_revisions.gni
	# Chromium build system stubs (libxml uses upstream unbundle .gn file)
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/libxml
	cp $(CURDIR)/chromium_src/chromium/src/build/linux/unbundle/libxml.gn $(CURDIR)/chromium_src/chromium/src/third_party/libxml/BUILD.gn
	# System header symlinks (tarball strips headers but code expects them)
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/opus/src
	ln -sf /usr/include/opus $(CURDIR)/chromium_src/chromium/src/third_party/opus/src/include
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/dav1d/libdav1d/include
	ln -sf /usr/include/dav1d $(CURDIR)/chromium_src/chromium/src/third_party/dav1d/libdav1d/include/dav1d
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/flac/include
	ln -sf /usr/include/FLAC $(CURDIR)/chromium_src/chromium/src/third_party/flac/include/FLAC
	ln -sf /usr/include/zlib.h $(CURDIR)/chromium_src/chromium/src/third_party/zlib/zlib.h
	ln -sf /usr/include/zconf.h $(CURDIR)/chromium_src/chromium/src/third_party/zlib/zconf.h
	ln -sf /usr/include/double-conversion $(CURDIR)/chromium_src/chromium/src/base/third_party/double_conversion/double-conversion
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/zstd/src/lib
	ln -sf /usr/include/zstd.h $(CURDIR)/chromium_src/chromium/src/third_party/zstd/src/lib/zstd.h
	ln -sf /usr/include/zstd_errors.h $(CURDIR)/chromium_src/chromium/src/third_party/zstd/src/lib/zstd_errors.h
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/protobuf
	ln -sf /usr/include $(CURDIR)/chromium_src/chromium/src/third_party/protobuf/src
	ln -sf /usr/include/NVCtrl/NVCtrl.h $(CURDIR)/chromium_src/chromium/src/third_party/angle/src/third_party/libXNVCtrl/NVCtrl.h
	ln -sf /usr/include/NVCtrl/NVCtrlLib.h $(CURDIR)/chromium_src/chromium/src/third_party/angle/src/third_party/libXNVCtrl/NVCtrlLib.h
	# System toolchain stubs (rollup, esbuild, clang, rust)
	# Use system rollup instead of bundled @rollup/wasm-node (avoids WASM binary dependency)
	if [ ! -f /usr/share/nodejs/rollup/dist/bin/rollup ]; then \
		echo "ERROR: System rollup binary not found at /usr/share/nodejs/rollup/dist/bin/rollup"; \
		echo "Install: apt-get install rollup"; \
		exit 1; \
	fi
	cd $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src && \
	mkdir -p node_modules/@rollup/wasm-node/dist/bin && \
	ln -sf /usr/share/nodejs/rollup/dist/bin/rollup node_modules/@rollup/wasm-node/dist/bin/rollup
	cd $(CURDIR)/chromium_src/chromium/src/third_party/node && \
	mkdir -p node_modules/@rollup/wasm-node/dist/bin && \
	ln -sf /usr/share/nodejs/rollup/dist/bin/rollup node_modules/@rollup/wasm-node/dist/bin/rollup
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/third_party/esbuild
	ln -sf /usr/bin/esbuild $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/third_party/esbuild/esbuild
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules
	ln -sf /usr/lib/$(DEB_HOST_MULTIARCH)/nodejs/esbuild $(CURDIR)/chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules/esbuild
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts
	echo 'llvmorg-19-init-19711-g6cecc0c9-1' > $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/cr_build_revision
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/bin
	ln -sf /usr/bin/clang-19 $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/bin/clang++
	ln -sf /usr/bin/clang-19 $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/bin/clang
	ln -sf /usr/bin/llvm-ar-19 $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/bin/llvm-ar
	mkdir -p $(CURDIR)/chromium_src/chromium/src/tools/rust
	cp debian/stubs/update_rust.py $(CURDIR)/chromium_src/chromium/src/tools/rust/update_rust.py
	@echo "==> Stub files installed"

	## Step 7b: Pre-patch .gn if it exists from a previous build
	## Why: In incremental builds, .gn may already exist and need patching
	## Fix: Add //cef/BUILD.gn to exec_script_allowlist (not exec_script_whitelist)
	## This matches CEF's gn_config.patch
	@echo "==> Pre-patching .gn file if it exists"
	if [ -f $(CURDIR)/chromium_src/chromium/src/.gn ]; then \
		if ! grep -q '"//cef/BUILD.gn"' $(CURDIR)/chromium_src/chromium/src/.gn; then \
			sed -i '/"\/\/build_overrides\/build.gni",/a\      "//cef/BUILD.gn",' $(CURDIR)/chromium_src/chromium/src/.gn; \
		fi; \
	fi

	## Step 7c: Create symlinks from system clang-19 to bundled LLVM location
	## Why: Chromium expects compiler-rt libraries at third_party/llvm-build/Release+Asserts/
	## But Debian clang-19 provides them at /usr/lib/llvm-19/lib/clang/19/lib/linux/
	## Path mapping:
	##   Chromium expects: third_party/llvm-build/Release+Asserts/lib/clang/19/lib/$(LLVM_TRIPLE)/libclang_rt.builtins.a
	##   Debian provides: /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.builtins-$(LLVM_ARCH).a
	@echo "==> Creating symlinks from system clang-19 to bundled LLVM location"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/$(LLVM_TRIPLE)
	# Symlink compiler-rt builtins library (primary dependency for Rust builds)
	ln -sf /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.builtins-$(LLVM_ARCH).a \
		$(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/$(LLVM_TRIPLE)/libclang_rt.builtins.a
	# Symlink all other compiler-rt libraries (for completeness)
	for lib in /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.*-$(LLVM_ARCH).a; do \
		base=$$(basename $$lib); \
		target=$$(echo $$base | sed 's/-$(LLVM_ARCH)\.a$$/.a/'); \
		ln -sf $$lib $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/$(LLVM_TRIPLE)/$$target 2>/dev/null || true; \
	done
	# Symlink i386 libraries (in case needed for 32-bit targets on x86_64)
	for lib in /usr/lib/llvm-19/lib/clang/19/lib/linux/libclang_rt.*-i386.a; do \
		base=$$(basename $$lib); \
		target=$$(echo $$base | sed 's/-i386\.a$$/.a/'); \
		ln -sf $$lib $(CURDIR)/chromium_src/chromium/src/third_party/llvm-build/Release+Asserts/lib/clang/19/lib/$(LLVM_TRIPLE)/$$target 2>/dev/null || true; \
	done
	@echo "==> LLVM symlinks created successfully"
	# libclang discovery is handled by chromium-debian's fixes/bindgen-paths.patch
	# which uses clang_base_path GN variable to set _libclang_path in run_bindgen.py

	## Step 7d: Symlink system Node.js to expected location
	## Why: Chromium expects Node.js at third_party/node/linux/node-linux-x64/bin/node
	## (hardcoded in node.gni regardless of target arch)
	## But Debian uses system Node.js from nodejs package (/usr/bin/node)
	@echo "==> Symlinking system Node.js"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-x64/bin
	ln -sf /usr/bin/node $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-x64/bin/node
ifneq ($(NODE_ARCH),x64)
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-$(NODE_ARCH)/bin
	ln -sf /usr/bin/node $(CURDIR)/chromium_src/chromium/src/third_party/node/linux/node-linux-$(NODE_ARCH)/bin/node
endif
	@echo "==> Node.js symlink created successfully"

	## Step 7e: Copy Rust std library from system rust-src package
	## Why: Chromium requires Rust std library source for compilation
	## Debian rust-src (1.91.1+) now includes all required files:
	##   - sync/nonpoison/condvar.rs, rwlock.rs (added in 1.91.x)
	##   - cross-platform files (cygwin/net.rs, darwin/objc.rs - these we'll stub)
	## Solution: Use system rust-src from /usr/src/rustc-*/library/
	## Build-Depends: rust-src (ensures package is installed)
	@echo "==> Copying Rust std library from system rust-src package"
	@# Find system rust-src library directory dynamically
	@RUST_SRC_LIB=$$(ls -d /usr/src/rustc-*/library 2>/dev/null | tail -1); \
	if [ -z "$$RUST_SRC_LIB" ] || [ ! -d "$$RUST_SRC_LIB" ]; then \
		echo "ERROR: System rust-src not found"; \
		echo "Please install rust-src package: apt install rust-src"; \
		exit 1; \
	fi; \
	echo "Found system rust-src at: $$RUST_SRC_LIB"; \
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/; \
	cp -a "$$RUST_SRC_LIB" \
		$(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/; \
	echo "==> Rust std library copied from system rust-src"; \
	if [ -f $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/sync/nonpoison/condvar.rs ]; then \
		echo "OK: Verified: condvar.rs exists (requires rust-src >= 1.91.1)"; \
	else \
		echo "ERROR: condvar.rs missing - rust-src version too old"; \
		echo "Required: rust-src >= 1.91.1"; \
		exit 1; \
	fi
	@echo "==> Creating symlink to system rustc in third_party/rust-toolchain/bin/"
	mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin
	ln -sf /usr/bin/rustc $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/rustc
	# Node.js version check is disabled by patch 0007-skip-nodejs-version-check.chromium.patch
	# System node (v20.19.5) is used directly without symlink

	## Step 7f.1: Create stubs for missing platform-specific files
	## Why: Debian's rust-src only contains Linux sources, but Rust std lib references
	## cross-platform files (cygwin/net.rs, darwin/objc.rs, etc.) that don't exist in /usr/src/rustc-*/
	## Solution: Create minimal stub files that re-export Unix functionality
	## Note: These stubs are NEVER used (Debian only builds for Linux), but must exist
	## for Rust compiler's module resolution during std lib compilation
	@echo "==> Creating stubs for missing cross-platform os files (Windows, macOS, Cygwin)"
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/cygwin
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/darwin
	@printf '%s\n' \
		'//! Cygwin-specific networking functionality (stub for Debian builds).' \
		'//! Cygwin is a POSIX compatibility layer for Windows.' \
		'//! This file is NOT used in Debian builds (Linux-only), but must exist' \
		'//! for Rust compiler module resolution during std library compilation.' \
		'' \
		'// Re-export Unix networking (Cygwin is POSIX-compatible)' \
		'pub use crate::os::unix::net::*;' \
		> $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/cygwin/net.rs
	@printf '%s\n' \
		'//! macOS-specific Objective-C functionality (stub for Debian builds).' \
		'//! This file is NOT used in Debian builds (Linux-only), but must exist' \
		'//! for Rust compiler module resolution during std library compilation.' \
		'' \
		'// Empty module - no Objective-C on Linux' \
		> $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/lib/rustlib/src/rust/library/std/src/os/darwin/objc.rs
	@echo "==> Created stubs: cygwin/net.rs, darwin/objc.rs"

	## Step 7f: Verify Rust vendor crates from Chromium tarball exist
	## Why: Chromium tarball (extracted in Step 5) ALREADY contains all Rust dependencies:
	##   - 145 application crates at third_party/rust/
	##   - 153 vendor crates at third_party/rust/chromium_crates_io/vendor/
	## NO downloads needed - everything from orig.tar.xz (Debian Policy compliant)
	## See: CLAUDE.md Critical Lesson 9 for details
	@echo "============================================================"
	@echo "==> Verifying Rust crates from Chromium tarball"
	@echo "============================================================"
	@app_crates=$$(ls -1d $(CURDIR)/chromium_src/chromium/src/third_party/rust/*/ 2>/dev/null | wc -l); \
	vendor_crates=$$(ls -1 $(CURDIR)/chromium_src/chromium/src/third_party/rust/chromium_crates_io/vendor/ 2>/dev/null | wc -l); \
	echo "Application crates: $$app_crates (expected: 145)"; \
	echo "Vendor crates: $$vendor_crates (expected: 153)"; \
	echo ""; \
	if [ $$app_crates -ge 140 ] && [ $$vendor_crates -ge 150 ]; then \
		echo "OK: All Rust dependencies available from Chromium tarball"; \
		echo "OK: No downloads needed - Debian Policy compliant"; \
	else \
		echo "ERROR: Missing Rust crates from Chromium tarball!"; \
		echo "   App crates: $$app_crates (need 140+)"; \
		echo "   Vendor crates: $$vendor_crates (need 150+)"; \
		exit 1; \
	fi
	@echo "============================================================"

	## Step 8: Build CEF (direct gn/ninja)
	## Like Debian Chromium, we call system /usr/bin/gn and /usr/bin/ninja directly.

	# Step 8a: Create rust-toolchain VERSION stub and symlinks (was CEF patch 0010)
	@echo "==> Creating rust-toolchain stubs for system Rust"
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin
	@echo 'rustc 1.88.0 stub (15283f6fe95e5b604273d13a428bab5fc0788f5a-1-llvmorg-22-init-8940-g4d4cb757 chromium)' > $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/VERSION
	@ln -sf /usr/bin/rustc $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/rustc
	@ln -sf /usr/bin/bindgen $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/bindgen
	@ln -sf /usr/bin/rustfmt $(CURDIR)/chromium_src/chromium/src/third_party/rust-toolchain/bin/rustfmt

	# Step 8b: Run version_manager.py (generates CEF version/API headers)
	@echo "==> Running CEF version_manager.py"
	cd $(CURDIR)/chromium_src/chromium/src/cef && python3 tools/version_manager.py -u --fast-check

	# Step 8c: Write args.gn directly (GN_DEFINES defined at top of rules file)
	@echo "==> Writing out/Release_GN_$(GN_CPU)/args.gn"
	@mkdir -p $(CURDIR)/chromium_src/chromium/src/out/Release_GN_$(GN_CPU)
	@echo '$(GN_DEFINES)' | tr ' ' '\n' | sed 's/\\"/"/g' > $(CURDIR)/chromium_src/chromium/src/out/Release_GN_$(GN_CPU)/args.gn

	# Step 8d: Run gn gen (system /usr/bin/gn from generate-ninja package)
	@echo "==> Running gn gen out/Release_GN_$(GN_CPU)"
	cd $(CURDIR)/chromium_src/chromium/src && \
	PATH=/usr/lib/llvm-$(CLANG_MVERS)/bin:$$PATH \
	/usr/bin/gn gen out/Release_GN_$(GN_CPU)

	# Step 8e: Run ninja (system /usr/bin/ninja from ninja-build package)
	@echo "==> Building CEF with ninja -j$(NINJA_JOBS)"
	cd $(CURDIR)/chromium_src/chromium/src && \
	export CC=clang-$(CLANG_MVERS) && \
	export CXX=clang++-$(CLANG_MVERS) && \
	export AR=ar && export NM=nm && \
	export RUSTC_BOOTSTRAP=1 && \
	export PATH=/usr/lib/llvm-$(CLANG_MVERS)/bin:$$PATH && \
	export LIBCLANG_PATH=/usr/lib/llvm-$(CLANG_MVERS)/lib && \
	/usr/bin/ninja -j$(NINJA_JOBS) -C out/Release_GN_$(GN_CPU) libcef chrome_sandbox

	# Step 8f: Run make_distrib.py (creates binary_distrib/ for packaging)
	# Re-init git in cef/ -- make_distrib.py requires git.is_checkout().
	# The .git from Step 3.5 cp -a is absorbed by the parent chromium/src/.git.
	@cd $(CURDIR)/chromium_src/chromium/src/cef && \
		git init -q && git add -A && git commit --no-gpg-sign -q -m "CEF" 2>/dev/null || true
	@echo "==> Creating CEF distribution"
	cd $(CURDIR)/chromium_src/chromium/src/cef && \
	python3 tools/make_distrib.py \
		--output-dir=$(CURDIR)/chromium_src/chromium/src/cef/binary_distrib \
		--allow-partial --ninja-build --no-format \
		$(CEF_ARCH_FLAG) --minimal

override_dh_auto_install:
	# Create package directories first
	mkdir -p $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)
	mkdir -p $(CURDIR)/debian/libcef-dev/usr/include
	mkdir -p $(CURDIR)/debian/libcef-common/usr/share/cef

	# Install libcef.so (use _$(CEF_DISTRIB_DIR)_minimal pattern for minimal-only distribution)
	install -m644 chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/libcef.so \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_VERSION)

	# Add RPATH for CEF's private ANGLE libraries (libEGL.so, libGLESv2.so)
	# These are Google's ANGLE implementation (OpenGL ES on Vulkan), NOT Mesa.
	# Debian policy allows RPATH for private shared libraries in /usr/lib/<package>/
	# See: https://wiki.debian.org/RpathIssue
	# The ANGLE libraries must be in a separate directory to avoid conflicts with system Mesa.
	# libcef.so already has $ORIGIN RUNPATH from upstream, we append the CEF private lib dir.
	patchelf --set-rpath '$$ORIGIN:/usr/lib/$(DEB_HOST_MULTIARCH)/cef' \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_VERSION)

	# Fix SONAME for proper library versioning (upstream uses unversioned "libcef.so")
	# This ensures proper library dependency tracking and ldconfig symlink creation
	patchelf --set-soname libcef.so.$(CEF_MAJOR) \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_VERSION)

	# Create soname symlink
	ln -s libcef.so.$(CEF_VERSION) \
		$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/libcef.so.$(CEF_MAJOR)

	# Install headers (use _$(CEF_DISTRIB_DIR)_minimal pattern for minimal-only distribution)
	mkdir -p $(CURDIR)/debian/libcef-dev/usr/include/
	cp -r chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/include \
		$(CURDIR)/debian/libcef-dev/usr/include/cef

	# Install cmake config files if they exist (use _$(CEF_DISTRIB_DIR)_minimal pattern)
	if [ -d chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/cmake ]; then \
		mkdir -p $(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/cef/; \
		cp -r chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/cmake/* \
			$(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/cef/; \
	fi
	# Install Debian-specific CMake paths file so downstream packages know
	# where resources live without hardcoding /usr/share/cef.
	# Applications must pass these to CefSettings.resources_dir_path / locales_dir_path.
	printf '%s\n' \
		'# Debian CEF resource paths' \
		'set(CEF_RESOURCES_DIR "/usr/share/cef")' \
		'set(CEF_LOCALES_DIR   "/usr/share/cef/locales")' \
		> $(CURDIR)/debian/libcef-dev/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/cef/cef-debian-paths.cmake

	# Install resources (PAK files) - use _$(CEF_DISTRIB_DIR)_minimal pattern
	# PAK files are in Resources/ directory, NOT Release/
	mkdir -p $(CURDIR)/debian/libcef-common/usr/share/cef/
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/*.pak \
		$(CURDIR)/debian/libcef-common/usr/share/cef/

	# Install ICU data file (CRITICAL for internationalization) - use _$(CEF_DISTRIB_DIR)_minimal pattern
	# icudtl.dat is in Resources/ directory, NOT Release/
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/icudtl.dat \
		$(CURDIR)/debian/libcef-common/usr/share/cef/

	# Install V8 context snapshot (CRITICAL for JavaScript) - use _$(CEF_DISTRIB_DIR)_minimal pattern
	cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/v8_context_snapshot.bin \
		$(CURDIR)/debian/libcef-common/usr/share/cef/ || true

	# Install locales - use _$(CEF_DISTRIB_DIR)_minimal pattern
	# Locales are in Resources/ directory, NOT Release/
	if [ -d chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/locales ]; then \
		mkdir -p $(CURDIR)/debian/libcef-common/usr/share/cef/locales/; \
		cp chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Resources/locales/*.pak \
			$(CURDIR)/debian/libcef-common/usr/share/cef/locales/; \
	fi

	# Install other required libraries from Release directory
	# Skip libvulkan.so (conflicts with system libvulkan1 package)
	# Note: libEGL.so and libGLESv2.so are ANGLE libraries (NOT Mesa) - installed separately below
	for lib in chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/*.so*; do \
		libname="$$(basename $$lib)"; \
		if [ -f "$$lib" ] && [ "$$libname" != "libcef.so" ] && \
		   ! echo "$$libname" | grep -qE '^lib(EGL|GLESv2|vulkan)\.so'; then \
			install -D -m644 "$$lib" \
				"$(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/$$libname"; \
		fi \
	done

	# Install ANGLE libraries (libEGL.so, libGLESv2.so) to CEF-specific directory
	# These are Google's ANGLE implementation (OpenGL ES on Vulkan), NOT Mesa.
	# CEF's GPU process requires these specific ANGLE libraries for hardware acceleration.
	# Installing to /usr/lib/$(DEB_HOST_MULTIARCH)/cef/ avoids conflicts with system Mesa (libegl1, libgles2).
	# Applications using CEF should set LD_LIBRARY_PATH or use rpath to find these.
	mkdir -p $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/cef/
	for lib in chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/libEGL.so \
	           chromium_src/chromium/src/cef/binary_distrib/cef_binary_*_$(CEF_DISTRIB_DIR)_minimal/Release/libGLESv2.so; do \
		if [ -f "$$lib" ]; then \
			install -m644 "$$lib" $(CURDIR)/debian/libcef147/usr/lib/$(DEB_HOST_MULTIARCH)/cef/; \
		fi \
	done

	# Install SwiftShader Vulkan ICD config (for software rendering fallback)
	# Generate with absolute path instead of relative path (original has ./libvk_swiftshader.so)
	# This is needed for Vulkan loader to find the library from any working directory
	mkdir -p $(CURDIR)/debian/libcef147/usr/share/vulkan/icd.d/
	echo '{"file_format_version": "1.0.0", "ICD": {"library_path": "/usr/lib/$(DEB_HOST_MULTIARCH)/libvk_swiftshader.so", "api_version": "1.0.5"}}' \
		> $(CURDIR)/debian/libcef147/usr/share/vulkan/icd.d/vk_swiftshader_icd.json

	# chrome-sandbox: CEF looks for it next to libcef.so (via dladdr/DIR_ASSETS).
	# We depend on chromium-sandbox and symlink to it (see libcef147.links).

override_dh_auto_test:
	# Skip tests for now - CEF tests require X display
	@echo "Skipping CEF tests (require X display)"

override_dh_auto_clean:
	# Clean Node.js and rollup symlinks (following Debian Chromium approach)
	# These are inside chromium_src/ but we clean them explicitly for clarity
	rm -rf chromium_src/chromium/src/third_party/node/linux/node-linux-$(NODE_ARCH) 2>/dev/null || true
	rm -rf chromium_src/chromium/src/third_party/node/node_modules/rollup 2>/dev/null || true
	rm -f chromium_src/chromium/src/third_party/devtools-frontend/src/node_modules/rollup3 2>/dev/null || true
	# Clean entire build directory
	rm -rf chromium_src/ || find chromium_src -type f -delete && find chromium_src -type d -empty -delete 2>/dev/null; rm -rf chromium_src/ 2>/dev/null || true
	# Clean stale quilt state to prevent desync between .pc/ and source tree
	rm -rf .pc
	# Remove stale depot_tools/ (underscore) from manual clones
	rm -rf depot_tools/
	# Note: depot-tools/ (hyphen, MUT component) is no longer used for builds.
	# System /usr/bin/gn and /usr/bin/ninja are used directly instead.
	dh_auto_clean
