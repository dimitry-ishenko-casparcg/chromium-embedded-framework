# =============================================================================
# LINTIAN OVERRIDES FOR LIBCEF147
# =============================================================================
# CEF (Chromium Embedded Framework) is built from Chromium sources.
# These overrides align with Debian chromium's approach.
# Reference: /usr/share/lintian/overrides/chromium
# =============================================================================

# -----------------------------------------------------------------------------
# RPATH FOR PRIVATE ANGLE LIBRARIES
# -----------------------------------------------------------------------------
# CEF requires ANGLE libraries (libEGL.so, libGLESv2.so) - Google's OpenGL ES
# implementation. These conflict with system Mesa, so installed to private dir.
# Debian policy allows RPATH for private libraries in /usr/lib/<package>/
# See: https://wiki.debian.org/RpathIssue
libcef147: custom-library-search-path RUNPATH * [usr/lib/*/libcef.so.*]

# -----------------------------------------------------------------------------
# EMBEDDED LIBRARIES (same as Debian chromium)
# -----------------------------------------------------------------------------
# These libraries are embedded in Chromium/CEF and cannot be unbundled:
# - freetype: PDFium embeds patched version even with use_system_freetype=true
# - libjsoncpp: Chromium keeps bundled (API differences with system version)
# - srtp: WebRTC bundles modified libsrtp2
# - tiff: PDFium embeds with security hardening
# Debian chromium uses identical overrides (see /usr/share/lintian/overrides/chromium)
libcef147: embedded-library freetype [usr/lib/*/libcef.so.*]
libcef147: embedded-library libjsoncpp [usr/lib/*/libcef.so.*]
libcef147: embedded-library srtp [usr/lib/*/libcef.so.*]
libcef147: embedded-library tiff [usr/lib/*/libcef.so.*]

# -----------------------------------------------------------------------------
# SWIFTSHADER (PRIVATE VULKAN SOFTWARE RENDERER)
# -----------------------------------------------------------------------------
# SwiftShader is a private library for software Vulkan rendering.
# It's not a public API, so versioning/symlinks are not required.
libcef147: shared-library-lacks-version usr/lib/*/libvk_swiftshader.so libvk_swiftshader.so
libcef147: lacks-unversioned-link-to-shared-library example: usr/lib/*/libvk_swiftshader.so [usr/lib/*/libvk_swiftshader.so]

# -----------------------------------------------------------------------------
# SYMBOLS FILE
# -----------------------------------------------------------------------------
# CEF is a 260MB library with thousands of symbols that change between releases.
# Creating and maintaining a .symbols file is impractical. Dependency tracking
# uses shlibs instead, which is sufficient for a library with this versioning
# scheme (libcef147 -> libcef147 on API changes).
libcef147: no-symbols-control-file usr/lib/*/libcef.so.*
libcef147: no-symbols-control-file usr/lib/*/libvk_swiftshader.so
