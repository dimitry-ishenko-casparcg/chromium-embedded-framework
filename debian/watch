Version: 5
Untrackable: CEF has no git tags; version derived from internal VERSION file

# CEF upstream version tracking
#
# CEF's Bitbucket repository has no git tags. Releases are branches numbered
# by Chromium build number (e.g., branch 7559 for Chromium 144.x). The actual
# CEF version (e.g., 144.0.7) is derived from the VERSION file inside the
# source tree, which uscan cannot extract from git refs.
#
# The chromium component comes from Debian's chromium source package, and
# depot-tools is a rolling repository with no versioned releases.
#
# Use debian/scripts/get-orig-tarballs.sh to obtain MUT tarballs.
# See debian/README.source for full details.
#
# Manual tracking resources:
# - CEF branches: https://bitbucket.org/chromiumembedded/cef/branches/
# - CEF builds: https://cef-builds.spotifycdn.com/index.html
# - Chromium pool: https://deb.debian.org/debian/pool/main/c/chromium/

Source: https://bitbucket.org/chromiumembedded/cef.git
Matching-Pattern: .*@ANY_VERSION@@ARCHIVE_EXT@

# The following MUT components would be trackable individually but are
# disabled because Untrackable applies globally to the entire watch file.
#
# Component: chromium
# Source: https://deb.debian.org/debian/pool/main/c/chromium/
# Matching-Pattern: chromium_(@ANY_VERSION@)\.orig\.tar\.xz
# Pgp-Mode: none
# Compression: xz
# Dversion-Mangle: s/-\d+$//
# Version-Constraint: ignore
#
# Component: depot-tools
# Mode: git
# Git-Mode: shallow
# Source: https://chromium.googlesource.com/chromium/tools/depot_tools.git
# Matching-Pattern: HEAD
# Pgp-Mode: none
# Compression: xz
# Version-Constraint: ignore
