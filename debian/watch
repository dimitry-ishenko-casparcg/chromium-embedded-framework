Version: 5

# CEF releases from Bitbucket git repository
# CEF uses branch-based releases aligned with Chromium versions
# Branch naming: e.g., branch 7499 corresponds to Chromium 143.x
#
# CEF version format: MAJOR.MINOR.PATCH (e.g., 138.0.1)
# where MAJOR matches the Chromium milestone number
#
# Manual tracking resources:
# - Branches: https://bitbucket.org/chromiumembedded/cef/branches/
# - Downloads: https://bitbucket.org/chromiumembedded/cef/downloads/
# - Spotify builds: https://cef-builds.spotifycdn.com/index.html

Mode: git
Source: https://bitbucket.org/chromiumembedded/cef.git
Matching-Pattern: refs/tags/(\d+\.\d+\.\d+)
Pgp-Mode: none

# Component: chromium
# IMPORTANT: Chromium source comes from Debian's chromium package, NOT upstream Google.
# We depend on Debian's pre-patched chromium which has Files-Excluded applied
# and Debian-specific patches. This is different from upstream Google chromium.
#
# Tracking Debian's chromium package pool directly:

Component: chromium
Source: https://deb.debian.org/debian/pool/main/c/chromium/
Matching-Pattern: chromium_(@ANY_VERSION@)\.orig\.tar\.xz
Pgp-Mode: none
Compression: xz
Dversion-Mangle: s/-\d+$//
Version-Constraint: ignore

# Component: depot-tools (Google's build tools)
# This is a rolling repository with no versioned releases
# Using HEAD with ignore version constraint

Component: depot-tools
Mode: git
Git-Mode: shallow
Source: https://chromium.googlesource.com/chromium/tools/depot_tools.git
Matching-Pattern: HEAD
Pgp-Mode: none
Compression: xz
Version-Constraint: ignore

# Note: The rust component (orig-rust.tar.xz) is not tracked here.
# It is an interim bundled dependency that will be removed when Debian's
# rust-src package provides the required sync_nonpoison files.
# Use debian/scripts/get-orig-tarballs.sh for manual download if needed.
