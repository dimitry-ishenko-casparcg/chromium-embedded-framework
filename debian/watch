version=4

# CEF releases from Bitbucket git repository
# CEF uses branch-based releases aligned with Chromium versions
# Branch naming: e.g., branch 7499 corresponds to Chromium 143.x
#
# CEF version format: MAJOR.MINOR.PATCH (e.g., 138.0.1)
# where MAJOR matches the Chromium milestone number
#
# CEF binary naming convention:
# cef_binary_VERSION+gCOMMIT+chromium-CHROMIUM_VERSION_linux64.tar.bz2
# Example: cef_binary_138.0.4+gb2ac72b+chromium-143.0.7499.130_linux64.tar.bz2
#
# Manual tracking resources:
# - Branches: https://bitbucket.org/chromiumembedded/cef/branches/
# - Downloads: https://bitbucket.org/chromiumembedded/cef/downloads/
# - Spotify builds: https://cef-builds.spotifycdn.com/index.html

opts="mode=git,pgpmode=none" \
  https://bitbucket.org/chromiumembedded/cef.git \
  refs/tags/(\d+\.\d+\.\d+)

# MUT Component Tracking:
#
# orig-chromium.tar.xz:
#   Tracks Debian chromium package version
#   Source: apt source chromium (pre-patched with Debian patches)
#   Update when: Debian uploads new chromium version matching CEF branch
#
# orig-depot-tools.tar.xz:
#   Google's depot_tools build system
#   Source: https://chromium.googlesource.com/chromium/tools/depot_tools
#   Update when: CEF requires newer depot_tools features
#
# orig-rust.tar.xz:
#   Rust standard library source (interim bundled dependency)
#   Source: https://github.com/nickel-lang/nickel (Chromium's Rust deps)
#   Update when: Chromium updates its expected Rust version
#   Can be removed when: Debian rust-src provides required files
